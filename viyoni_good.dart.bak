    // Sat+Moon+Mars in 1,4,10 ΓåÆ well death
    if ((ch23SatH==1||ch23SatH==4||ch23SatH==10)&&(ch23MoonH==1||ch23MoonH==4||ch23MoonH==10)&&(ch23MarsH==1||ch23MarsH==4||ch23MarsH==10)&&ch23SatH!=ch23MoonH&&ch23MoonH!=ch23MarsH&&ch23SatH!=ch23MarsH) {
      yogas.add(Yoga(shloka: 'α▓òα│éα▓¬α│ç α▓«α▓éα▓ªα▓╢α▓╢α▓╛α▓éα▓ò... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│¿)', name: 'α▓òα│éα▓¬ α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│¿)', description: 'α▓╢α▓¿α▓┐+α▓Üα▓éα▓ªα│ìα▓░+α▓òα│üα▓£ 1/4/10', result: 'α▓¼α▓╛α▓╡α▓┐α▓ùα│å α▓¼α▓┐α▓ªα│ìα▓ªα│ü α▓«α▓░α▓ú', rashi: ch23H8, planets: ['α▓╢α▓¿α▓┐','α▓Üα▓éα▓ªα│ìα▓░','α▓òα│üα▓£']));
    }
    // Sun+Moon in 1&7 ΓåÆ drowning
    if ((ch23SunH==1&&ch23MoonH==7)||(ch23SunH==7&&ch23MoonH==1)) {
      yogas.add(Yoga(shloka: 'α▓ëα▓¡α▓»α│ïα▓ªα▓»α│çsα▓░α│ìα▓òα▓╢α▓╢α▓┐α▓¿α│î α▓ñα│ïα▓»α│ç... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│¿)', name: 'α▓£α▓▓α▓«α▓░α▓ú (α▓¿α│ê α│¿)', description: 'α▓╕α│éα▓░α│ìα▓»+α▓Üα▓éα▓ªα│ìα▓░ 1/7α▓░α▓▓α│ìα▓▓α▓┐', result: 'α▓¿α│Çα▓░α▓┐α▓¿α▓▓α│ìα▓▓α▓┐ α▓«α│üα▓│α│üα▓ùα▓┐ α▓«α▓░α▓ú', rashi: ch23H8, planets: ['α▓░α▓╡α▓┐','α▓Üα▓éα▓ªα│ìα▓░']));
    }

    // Shloka 3: Saturn in Karkata ΓåÆ jalodhara death
    if (ch23SatR==3) {
      yogas.add(Yoga(shloka: 'α▓«α▓éα▓ªα│ç α▓òα▓░α│ìα▓òα▓ƒα▓òα│ç α▓£α▓▓α│ïα▓ªα▓░... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│⌐)', name: 'α▓£α▓▓α│ïα▓ªα▓░ α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│⌐)', description: 'α▓╢α▓¿α▓┐ α▓òα▓░α│ìα▓òα▓ƒα▓ªα▓▓α│ìα▓▓α▓┐', result: 'α▓£α▓▓α│ïα▓ªα▓░ α▓░α│ïα▓ùα▓ªα▓┐α▓éα▓ª α▓«α▓░α▓ú', rashi: 3, planets: ['α▓╢α▓¿α▓┐']));
    }
    // Moon in Makara ΓåÆ shastra/agni death
    if (ch23MoonR==9) {
      yogas.add(Yoga(shloka: 'α▓«α│âα▓ùα▓╛α▓éα▓òα│ç α▓«α│âα▓ùα│ç... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│⌐)', name: 'α▓╢α▓╕α│ìα▓ñα│ìα▓░α▓╛α▓ùα│ìα▓¿α▓┐ α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│⌐)', description: 'α▓Üα▓éα▓ªα│ìα▓░ α▓«α▓òα▓░α▓ªα▓▓α│ìα▓▓α▓┐', result: 'α▓¼α│åα▓éα▓òα▓┐/α▓╢α▓╕α│ìα▓ñα│ìα▓░α▓ªα▓┐α▓éα▓ª α▓«α▓░α▓ú', rashi: 9, planets: ['α▓Üα▓éα▓ªα│ìα▓░']));
    }

    // Shloka 4: Papa in lagna+9th without shubha ΓåÆ bondage death
    final ch23H9 = (lagRashi+8)%12;
    final papLag = ch23SunR==lagRashi||ch23MarsR==lagRashi||ch23SatR==lagRashi;
    final papH9 = ch23SunR==ch23H9||ch23MarsR==ch23H9||ch23SatR==ch23H9;
    if (papLag && papH9) {
      final shubLag = _rashiOf(jup)==lagRashi||_rashiOf(ven)==lagRashi||_rashiOf(mer)==lagRashi;
      final shubH9 = _rashiOf(jup)==ch23H9||_rashiOf(ven)==ch23H9||_rashiOf(mer)==ch23H9;
      if (!shubLag && !shubH9) {
        yogas.add(Yoga(shloka: 'α▓▓α▓ùα│ìα▓¿α▓╛α▓ºα│Çα▓¿α▓╡α▓«α▓╕α│ìα▓Ñα▓»α│ïα▓â... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│¬)', name: 'α▓¼α▓éα▓ºα▓¿ α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│¬)', description: 'α▓¬α▓╛α▓¬ α▓▓α▓ùα│ìα▓¿+9, α▓╢α│üα▓¡ α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓çα▓▓α│ìα▓▓', result: 'α▓¼α▓éα▓ºα▓¿α▓ªα▓┐α▓éα▓ª α▓«α▓░α▓ú', rashi: lagRashi, planets: ['α▓¬α▓╛α▓¬']));
      }
    }

    // Shloka 5: Mars 4th+Sun 10th+Sat lagna ΓåÆ trishula death
    if (ch23MarsH==4 && ch23SunH==10 && ch23SatH==1) {
      yogas.add(Yoga(shloka: 'α▓╢α│éα▓▓α│ïα▓ªα│ìα▓ºα▓┐α▓¿α│ìα▓¿α▓ñα▓¿α│üα▓â... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│½)', name: 'α▓╢α│éα▓▓ α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│½)', description: 'α▓òα│üα▓£ 4+α▓╕α│éα▓░α│ìα▓» 10+α▓╢α▓¿α▓┐ α▓▓α▓ùα│ìα▓¿', result: 'α▓ñα│ìα▓░α▓┐α▓╢α│éα▓▓α▓ªα▓┐α▓éα▓ª α▓«α▓░α▓ú', rashi: ch23H8, planets: ['α▓òα│üα▓£','α▓░α▓╡α▓┐','α▓╢α▓¿α▓┐']));
    }
    // Sun 4th+Mars 10th+waning Moon+Sat aspect ΓåÆ wood beating death
    if (ch23SunH==4 && ch23MarsH==10) {
      final ch23MoonWane = moonLon > sun ? (moonLon-sun) : (360+moonLon-sun);
      if (ch23MoonWane > 180) {
        yogas.add(Yoga(shloka: 'α▓òα▓╛α▓╖α│ìα▓ƒα│çα▓¿α▓╛α▓¡α▓┐α▓╣α▓ñα▓â... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│½)', name: 'α▓òα▓╛α▓╖α│ìα▓á α▓¬α│ìα▓░α▓╣α▓╛α▓░ α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│½)', description: 'α▓╕α│éα▓░α│ìα▓» 4+α▓òα│üα▓£ 10+α▓òα│ìα▓╖α│Çα▓ú α▓Üα▓éα▓ªα│ìα▓░', result: 'α▓òα▓ƒα│ìα▓ƒα▓┐α▓ùα│åα▓»α▓┐α▓éα▓ª α▓«α▓░α▓ú', rashi: ch23H8, planets: ['α▓░α▓╡α▓┐','α▓òα│üα▓£']));
      }
    }

    // Shloka 7: Mars+Sun+Sat in 4,7,10 ΓåÆ weapon/fire/king death
    if ((ch23MarsH==4||ch23MarsH==7||ch23MarsH==10)&&(ch23SunH==4||ch23SunH==7||ch23SunH==10)&&(ch23SatH==4||ch23SatH==7||ch23SatH==10)) {
      if (ch23MarsH!=ch23SunH&&ch23SunH!=ch23SatH&&ch23MarsH!=ch23SatH) {
        yogas.add(Yoga(shloka: 'α▓¼α▓éα▓ºα▓╕α│ìα▓ñα▓òα▓░α│ìα▓«α▓╕α▓╣α▓┐α▓ñα│ê... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│¡)', name: 'α▓åα▓»α│üα▓º/α▓àα▓ùα│ìα▓¿α▓┐ α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│¡)', description: 'α▓òα│üα▓£+α▓╕α│éα▓░α│ìα▓»+α▓╢α▓¿α▓┐ 4/7/10', result: 'α▓åα▓»α│üα▓º/α▓¼α│åα▓éα▓òα▓┐/α▓░α▓╛α▓£α▓òα│ïα▓¬', rashi: ch23H8, planets: ['α▓òα│üα▓£','α▓░α▓╡α▓┐','α▓╢α▓¿α▓┐']));
      }
    }

    // Shloka 8: Sun 10th+Mars 4th ΓåÆ vehicle death
    if (ch23SunH==10 && ch23MarsH==4) {
      yogas.add(Yoga(shloka: 'α▓ûα▓╕α│ìα▓ƒα│çsα▓░α│ìα▓òα│ç α▓»α▓╛α▓¿α▓¬α│ìα▓░α▓¬α▓╛α▓ñα▓╛α▓ñα│ì... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│«)', name: 'α▓╡α▓╛α▓╣α▓¿ α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│«)', description: 'α▓╕α│éα▓░α│ìα▓» 10+α▓òα│üα▓£ 4', result: 'α▓╡α▓╛α▓╣α▓¿α▓ªα▓┐α▓éα▓ª α▓¼α▓┐α▓ªα│ìα▓ªα│ü α▓«α▓░α▓ú', rashi: ch23H8, planets: ['α▓░α▓╡α▓┐','α▓òα│üα▓£']));
    }

    // Shloka 9: Sat in 8th aspected by strong Mars + waning Moon ΓåÆ guhya roga death
    if (ch23SatH==8 && ch23MarsR==ch23H8) {
      yogas.add(Yoga(shloka: 'α▓¿α▓┐α▓ºα▓¿α▓╕α│ìα▓Ñα▓┐α▓ñα│çsα▓░α│ìα▓òα▓£α│ç... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│»)', name: 'α▓ùα│üα▓╣α│ìα▓»α▓░α│ïα▓ù α▓«α│âα▓ñα│ìα▓»α│ü (α▓¿α│ê α│»)', description: 'α▓╢α▓¿α▓┐ 8+α▓òα│üα▓£ α▓ªα│âα▓╖α│ìα▓ƒα▓┐', result: 'α▓ùα│üα▓╣α│ìα▓» α▓░α│ïα▓ùα▓ªα▓┐α▓éα▓ª α▓«α▓░α▓ú', rashi: ch23H8, planets: ['α▓╢α▓¿α▓┐','α▓òα│üα▓£']));
    }

    // Shloka 10: 22nd drekkana lord ΓåÆ death nature
    final ch23Drek22R = ((lagRashi * 30 + 210 + (lag % 30)) % 360);
    final ch23Drek22Rashi = _rashiOf(ch23Drek22R);
    final ch23Drek22Lord = rashiLords[ch23Drek22Rashi];
    final ch23D22Cause = ch23DeathCause[ch23Drek22Lord] ?? 'α▓àα▓£α│ìα▓₧α▓╛α▓ñ α▓òα▓╛α▓░α▓ú';
    yogas.add(Yoga(shloka: 'α▓ªα│ìα▓╡α▓╛α▓╡α▓┐α▓éα▓╢α▓â α▓òα▓Ñα▓┐α▓ñα▓╕α│ìα▓ñα│ü... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│ºα│ª)', name: '22α▓¿α│ç α▓ªα│ìα▓░α│çα▓òα│ìα▓òα▓╛α▓ú (α▓¿α│ê α│ºα│ª)', description: '22α▓¿α│ç α▓ªα│ìα▓░α│çα▓òα│ìα▓òα▓╛α▓ú: ${_rashiNames[ch23Drek22Rashi]} ($ch23Drek22Lord)', result: ch23D22Cause, rashi: ch23Drek22Rashi, planets: [ch23Drek22Lord ?? '']));

    // Shloka 13: Afterlife destiny from planet strength
    final ch23JupStr = ch23JupH==1||ch23JupH==4||ch23JupH==7||ch23JupH==10;
    final ch23MoonStr = ch23MoonH==1||ch23MoonH==4||ch23MoonH==7||ch23MoonH==10;
    final ch23SatStr = ch23SatH==1||ch23SatH==4||ch23SatH==7||ch23SatH==10;
    if (ch23JupStr) {
      yogas.add(Yoga(shloka: 'α▓ùα│üα▓░α│üα▓░α│üα▓íα│üα▓¬α▓ñα▓┐α▓╢α│üα▓òα│ìα▓░α│î... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│ºα│⌐)', name: 'α▓╕α│ìα▓╡α▓░α│ìα▓ù α▓¬α│ìα▓░α▓╛α▓¬α│ìα▓ñα▓┐ (α▓¿α│ê α│ºα│⌐)', description: 'α▓ùα│üα▓░α│ü α▓òα│çα▓éα▓ªα│ìα▓░α▓ªα▓▓α│ìα▓▓α▓┐ α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐', result: 'α▓╕α│ìα▓╡α▓░α│ìα▓ù α▓¬α│ìα▓░α▓╛α▓¬α│ìα▓ñα▓┐', rashi: _rashiOf(jup), planets: ['α▓ùα│üα▓░α│ü']));
    } else if (ch23MoonStr) {
      yogas.add(Yoga(shloka: 'α▓ùα│üα▓░α│üα▓░α│üα▓íα│üα▓¬α▓ñα▓┐α▓╢α│üα▓òα│ìα▓░α│î... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│ºα│⌐)', name: 'α▓¬α▓┐α▓ñα│âα▓▓α│ïα▓ò (α▓¿α│ê α│ºα│⌐)', description: 'α▓Üα▓éα▓ªα│ìα▓░ α▓òα│çα▓éα▓ªα│ìα▓░α▓ªα▓▓α│ìα▓▓α▓┐', result: 'α▓¬α▓┐α▓ñα│âα▓▓α│ïα▓ò α▓¬α│ìα▓░α▓╛α▓¬α│ìα▓ñα▓┐', rashi: ch23MoonR, planets: ['α▓Üα▓éα▓ªα│ìα▓░']));
    } else if (ch23SatStr) {
      yogas.add(Yoga(shloka: 'α▓ùα│üα▓░α│üα▓░α│üα▓íα│üα▓¬α▓ñα▓┐α▓╢α│üα▓òα│ìα▓░α│î... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│ºα│⌐)', name: 'α▓¿α▓░α▓ò α▓╕α│éα▓Üα▓¿α│å (α▓¿α│ê α│ºα│⌐)', description: 'α▓╢α▓¿α▓┐ α▓òα│çα▓éα▓ªα│ìα▓░α▓ªα▓▓α│ìα▓▓α▓┐ α▓ùα│üα▓░α│ü α▓ªα│üα▓░α│ìα▓¼α▓▓', result: 'α▓¿α▓░α▓ò α▓¡α│Çα▓ñα▓┐', rashi: ch23SatR, planets: ['α▓╢α▓¿α▓┐']));
    }

    // Shloka 14: Jupiter in 6/kendra/8 exalted ΓåÆ moksha
    if ((ch23JupH==6||ch23JupH==1||ch23JupH==4||ch23JupH==7||ch23JupH==10||ch23JupH==8)&&_rashiOf(jup)==3) {
      yogas.add(Yoga(shloka: 'α▓ùα│üα▓░α│üα▓░α▓Ñ α▓░α▓┐α▓¬α│üα▓òα│çα▓éα▓ªα│ìα▓░... (α▓¿α│êα▓░α│ìα▓»α▓╛α▓úα▓┐α▓ò α│ºα│¬)', name: 'α▓«α│ïα▓òα│ìα▓╖ α▓»α│ïα▓ù (α▓¿α│ê α│ºα│¬)', description: 'α▓ùα│üα▓░α│ü α▓ëα▓Üα│ìα▓Ü + α▓òα│çα▓éα▓ªα│ìα▓░/6/8', result: 'α▓«α│ïα▓òα│ìα▓╖ α▓¬α│ìα▓░α▓╛α▓¬α│ìα▓ñα▓┐', rashi: _rashiOf(jup), planets: ['α▓ùα│üα▓░α│ü']));
    }

    return yogas;
  }
}

class Yoga {
  final String shloka;
  final String name;
  final String description;
  final String result;
  final int rashi; // 0-11 index of the rashi this yoga applies to
  final List<String> planets; // planet names involved
  final int refLagna; // 0-11: which reference lagna this yoga was detected from (-1 = actual lagna)
  const Yoga({required this.shloka, required this.name, required this.description, required this.result, this.rashi = -1, this.planets = const [], this.refLagna = -1});
}
