    // ΓòÉΓòÉΓòÉ JK Shloka 18: Lamp & door of delivery room ΓòÉΓòÉΓòÉ
    final jk18SunRType = (sunR == 0 || sunR == 3 || sunR == 6 || sunR == 9) ? 'α▓Üα▓░ (α▓Üα▓▓α▓┐α▓╕α│üα▓╡)' : (sunR == 1 || sunR == 4 || sunR == 7 || sunR == 10) ? 'α▓╕α│ìα▓Ñα▓┐α▓░' : 'α▓ªα│ìα▓╡α▓┐α▓╕α│ìα▓╡α▓¡α▓╛α▓╡';
    final jk18StrongInKendra = <String>[];
    for (final e in allPLons.entries) {
      final hFL = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
      if ((hFL == 1 || hFL == 4 || hFL == 7 || hFL == 10) && isStrong(e.key)) {
        jk18StrongInKendra.add(_knPlanets[e.key]!);
      }
    }
    yogas.add(Yoga(
      shloka: 'α▓╕α│ìα▓¿α│çα▓╣α▓â α▓╢α▓╢α▓╛α▓éα▓òα▓╛α▓ªα│üα▓ªα▓»α▓╛α▓Üα│ìα▓Ü α▓╡α▓░α│ìα▓ñα▓┐ α▓ªα│Çα▓¬α│ïsα▓░α│ìα▓òα▓»α│üα▓òα│ìα▓ñα▓░α│ìα▓òα│ìα▓╖α▓╡α▓╢α▓╛α▓Üα│ìα▓Üα▓░α▓╛α▓â',
