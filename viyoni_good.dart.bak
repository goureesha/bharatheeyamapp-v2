      description: 'α▓▓α▓ùα│ìα▓¿ α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[jk12Nav]} (${jk12Chara ? "α▓Üα▓░" : jk12Sthira ? "α▓╕α│ìα▓Ñα▓┐α▓░" : "α▓ªα│ìα▓╡α▓┐α▓╕α│ìα▓╡α▓¡α▓╛α▓╡"})',
      result: '${jk12Place}α▓»α▓▓α│ìα▓▓α▓┐ α▓£α▓¿α▓¿',
