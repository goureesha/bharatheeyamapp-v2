import 'calculator.dart';

class ViyoniJanma {
  static const _animalSigns = {0, 1, 3, 4, 7, 9, 11};
  static const _bodyParts = ['α▓ñα▓▓α│å','α▓«α│üα▓û/α▓òα│üα▓ñα│ìα▓ñα▓┐α▓ùα│å','α▓«α│üα▓éα▓ùα▓╛α▓▓α│ü/α▓¡α│üα▓£','α▓¼α│åα▓¿α│ìα▓¿α│ü','α▓Äα▓ªα│å','α▓¬α▓╛α▓░α│ìα▓╢α│ìα▓╡','α▓╣α│èα▓ƒα│ìα▓ƒα│å','α▓ùα│üα▓ª','α▓╣α▓┐α▓éα▓ùα▓╛α▓▓α│ü','α▓╢α▓┐α▓╢α│ìα▓¿/α▓╡α│âα▓╖α▓ú','α▓¬α│âα▓╖α│ìα▓á','α▓¼α▓╛α▓▓'];
  static const _rashiColors = ['α▓òα│åα▓éα▓¬α│ü','α▓¼α▓┐α▓│α▓┐','α▓╣α▓╕α▓┐α▓░α│ü','α▓ùα│üα▓▓α▓╛α▓¼α▓┐','α▓╣α▓│α▓ªα▓┐','α▓¼α▓╣α│üα▓╡α▓░α│ìα▓ú','α▓òα▓¬α│ìα▓¬α│ü','α▓òα│åα▓éα▓¬α│ü-α▓òα▓éα▓ªα│ü','α▓╣α▓│α▓ªα▓┐','α▓¼α▓╣α│üα▓╡α▓░α│ìα▓ú','α▓òα▓éα▓ªα│ü','α▓¼α│åα▓│α│ìα▓│α▓┐'];
  static const _rashiNames = ['α▓«α│çα▓╖','α▓╡α│âα▓╖α▓¡','α▓«α▓┐α▓Ñα│üα▓¿','α▓òα▓░α│ìα▓ò','α▓╕α▓┐α▓éα▓╣','α▓òα▓¿α│ìα▓»α▓╛','α▓ñα│üα▓▓α▓╛','α▓╡α│âα▓╢α│ìα▓Üα▓┐α▓ò','α▓ºα▓¿α│ü','α▓«α▓òα▓░','α▓òα│üα▓éα▓¡','α▓«α│Çα▓¿'];
  static const _birdDrekkanas = {(2,1),(4,2),(5,1),(6,2),(10,3),(8,1)};
  static const _charaRashis = {0, 3, 6, 9};

  static int _rashiOf(double lon) => ((lon ~/ 30) % 12).toInt();

  static int _d12Rashi(double lon) {
    final inSign = lon % 30;
    return ((inSign / 2.5).floor() + _rashiOf(lon)) % 12;
  }

  static int _d9Rashi(double lon) {
    final inSign = lon % 30;
    final navPada = (inSign / (30.0 / 9.0)).floor();
    final rashi = _rashiOf(lon);
    final startRashi = (rashi % 4) == 0 ? 0 : (rashi % 4) == 1 ? 9 : (rashi % 4) == 2 ? 6 : 3;
    return (startRashi + navPada) % 12;
  }

  static int _drekkanaNum(double lon) {
    final inSign = lon % 30;
    if (inSign < 10) return 1;
    if (inSign < 20) return 2;
    return 3;
  }

  static bool _isOwnNavamsha(String planet, int d9) {
    const own = {'Sun':[4],'Mars':[0,7],'Saturn':[9,10],'Rahu':[10],'Ketu':[7]};
    const exalt = {'Sun':0,'Mars':9,'Saturn':6,'Rahu':1,'Ketu':7};
    if (own[planet]?.contains(d9) ?? false) return true;
    return exalt[planet] == d9;
  }

  static bool _isEnemyNavamsha(String planet, int d9) {
    const enemies = {'Jupiter':[1,6,9,10],'Venus':[0,3,4,7],'Mercury':[3,7],'Moon':[7,9,10]};
    return enemies[planet]?.contains(d9) ?? false;
  }

  static const _rashiNamesShort = ['α▓«α│çα▓╖','α▓╡α│âα▓╖α▓¡','α▓«α▓┐α▓Ñα│üα▓¿','α▓òα▓░α│ìα▓ò','α▓╕α▓┐α▓éα▓╣','α▓òα▓¿α│ìα▓»α▓╛','α▓ñα│üα▓▓α▓╛','α▓╡α│âα▓╢α│ìα▓Üα▓┐α▓ò','α▓ºα▓¿α│ü','α▓«α▓òα▓░','α▓òα│üα▓éα▓¡','α▓«α│Çα▓¿'];

  /// Detect yogas from ALL 12 rashis as virtual lagna.
  /// Each yoga is tagged with [refLagna] indicating which rashi was used as reference.
  static List<Yoga> detectAll(KundaliResult chart) {
    final allYogas = <Yoga>[];
    final seen = <String>{};

    for (int ref = 0; ref < 12; ref++) {
      final yogas = detect(chart, lagnaRashi: ref);
      for (final y in yogas) {
        // Cross-lagna dedup: same name+result+rashi = duplicate
        final key = '${y.name}|${y.result}|${y.rashi}';
        if (!seen.contains(key)) {
          seen.add(key);
          allYogas.add(Yoga(
            shloka: y.shloka,
            name: y.name,
            description: 'Γƒ¬${_rashiNamesShort[ref]} α▓▓α▓ùα│ìα▓¿Γƒ½\n${y.description}',
            result: y.result,
            rashi: y.rashi,
            planets: y.planets,
            refLagna: ref,
          ));
        }
      }
    }
    return allYogas;
  }

  /// Detect all active yogas for the given chart.
  /// If [lagnaRashi] is provided, use it as virtual lagna (0-11).
  static List<Yoga> detect(KundaliResult chart, {int? lagnaRashi}) {
    final p = chart.planets;
    final bhavas = chart.bhavas;
    final shadbala = chart.shadbala;
    final lag = bhavas.isNotEmpty ? bhavas[0] : 0.0;
    final lagRashi = lagnaRashi ?? _rashiOf(lag);
    final moonLon = p['α▓Üα▓éα▓ªα│ìα▓░']?.longitude ?? 0.0;

    final sun = p['α▓░α▓╡α▓┐']?.longitude ?? 0.0;
    final moon = moonLon;
    final mars = p['α▓òα│üα▓£']?.longitude ?? 0.0;
    final mer = p['α▓¼α│üα▓º']?.longitude ?? 0.0;
    final jup = p['α▓ùα│üα▓░α│ü']?.longitude ?? 0.0;
    final ven = p['α▓╢α│üα▓òα│ìα▓░']?.longitude ?? 0.0;
    final sat = p['α▓╢α▓¿α▓┐']?.longitude ?? 0.0;
    final rahu = p['α▓░α▓╛α▓╣α│ü']?.longitude ?? 0.0;
    final ketu = p['α▓òα│çα▓ñα│ü']?.longitude ?? 0.0;

    bool isStrong(String eng) => shadbala[eng]?['IsStrong'] == true;
    bool isWeak(String eng) => shadbala[eng]?['IsStrong'] != true;

    final malStrong = isStrong('Sun') && isStrong('Mars') && isStrong('Saturn');
    final benWeak = isWeak('Jupiter') && isWeak('Venus') && isWeak('Mercury') && isWeak('Moon');

    final kendras = [lagRashi, (lagRashi+3)%12, (lagRashi+6)%12, (lagRashi+9)%12];
    final malLons = {'Sun':sun,'Mars':mars,'Saturn':sat,'Rahu':rahu,'Ketu':ketu};
    bool malInKendra = false, malAspKendra = false;
    for (final e in malLons.entries) {
      final r = _rashiOf(e.value);
      if (kendras.contains(r)) malInKendra = true;
      if (kendras.contains((r+6)%12)) malAspKendra = true;
      if (e.key == 'Mars' && (kendras.contains((r+3)%12) || kendras.contains((r+7)%12))) malAspKendra = true;
      if (e.key == 'Saturn' && (kendras.contains((r+2)%12) || kendras.contains((r+9)%12))) malAspKendra = true;
    }

    final yogas = <Yoga>[];

    // Helper: Kannada planet names
    const _knPlanets = {'Sun':'α▓░α▓╡α▓┐','Mars':'α▓òα│üα▓£','Saturn':'α▓╢α▓¿α▓┐','Rahu':'α▓░α▓╛α▓╣α│ü','Ketu':'α▓òα│çα▓ñα│ü',
                        'Jupiter':'α▓ùα│üα▓░α│ü','Venus':'α▓╢α│üα▓òα│ìα▓░','Mercury':'α▓¼α│üα▓º','Moon':'α▓Üα▓éα▓ªα│ìα▓░'};

    // ΓòÉΓòÉΓòÉ Shloka 1: Basic Viyoni ΓòÉΓòÉΓòÉ
    if (malStrong && benWeak && (malInKendra || malAspKendra)) {
      final d12 = _d12Rashi(moonLon);
      // Which malefics are in which kendras
      final malKendraDetail = <String>[];
      for (final e in malLons.entries) {
        final r = _rashiOf(e.value);
        if (kendras.contains(r)) malKendraDetail.add('${_knPlanets[e.key]} ΓåÆ ${_rashiNames[r]} (α▓òα│çα▓éα▓ªα│ìα▓░)');
      }
      yogas.add(Yoga(
        shloka: 'α▓òα│ìα▓░α│éα▓░α▓ùα│ìα▓░α▓╣α│êα▓â α▓╕α│üα▓¼α▓▓α▓┐α▓¡α▓┐α▓░α│ìα▓╡α▓┐α▓¼α▓▓α│êα▓╢α│ìα▓Ü α▓╕α│îα▓«α│ìα▓»α▓â α▓òα│ìα▓▓α│Çα▓ªα│ç α▓Üα▓ñα│üα▓╖α│ìα▓ƒα▓»α▓ùα▓ñα│ç α▓ñα▓ªα▓╡α│çα▓òα│ìα▓╖α▓úα▓╛α▓ªα│ìα▓╡α▓╛ αÑñ\nα▓Üα▓éα▓ªα│ìα▓░α│ïα▓¬α▓ùα▓ªα│ìα▓╡α▓┐α▓░α▓╕α▓¡α▓╛α▓ùα▓╕α▓«α▓╛α▓¿α▓░α│éα▓¬α▓é α▓╕α▓é α▓╡α▓ªα│çα▓ªα│ìα▓»α▓ªα▓┐ α▓¡α▓╡α│çα▓ñα│ìα▓╕ α▓╡α▓┐α▓»α│ïα▓¿α▓┐α▓╕α▓éα▓£α│ìα▓₧ αÑÑ',
        name: 'α▓╡α▓┐α▓»α│ïα▓¿α▓┐ α▓£α▓¿α│ìα▓« α▓»α│ïα▓ù',
        description: 'α▓▓α▓ùα│ìα▓¿: ${_rashiNames[lagRashi]} | α▓¬α▓╛α▓¬α▓░α│ü α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐ (α▓░α▓╡α▓┐,α▓òα│üα▓£,α▓╢α▓¿α▓┐) | α▓╢α│üα▓¡α▓░α│ü α▓¼α▓▓α▓╣α│Çα▓¿ (α▓ùα│üα▓░α│ü,α▓╢α│üα▓òα│ìα▓░,α▓¼α│üα▓º,α▓Üα▓éα▓ªα│ìα▓░)\n${malKendraDetail.join('\n')}',
        result: 'α▓Üα▓éα▓ªα│ìα▓░ α▓ªα│ìα▓╡α▓╛α▓ªα▓╢α▓╛α▓éα▓╢: ${_rashiNames[d12]} ΓåÆ α▓¬α│ìα▓░α▓╛α▓úα▓┐ α▓░α│éα▓¬: ${_bodyParts[d12]}',
        rashi: lagRashi,
        planets: ['α▓░α▓╡α▓┐','α▓òα│üα▓£','α▓╢α▓¿α▓┐','α▓░α▓╛α▓╣α│ü','α▓òα│çα▓ñα│ü'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Shloka 2: Navamsha-based Viyoni ΓòÉΓòÉΓòÉ
    bool malOwnNav = true;
    final malNavDetail = <String>[];
    for (final e in malLons.entries) {
      if (e.key == 'Rahu' || e.key == 'Ketu') continue;
      final d9 = _d9Rashi(e.value);
      final own = _isOwnNavamsha(e.key, d9);
      if (!own) malOwnNav = false;
      malNavDetail.add('${_knPlanets[e.key]} α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[d9]} ${own ? "Γ£ô α▓╕α│ìα▓╡" : "Γ£ù"}');
    }
    final benLons = {'Jupiter':jup,'Venus':ven,'Mercury':mer,'Moon':moon};
    bool benEnemyNav = true;
    final benNavDetail = <String>[];
    for (final e in benLons.entries) {
      final d9 = _d9Rashi(e.value);
      final enemy = _isEnemyNavamsha(e.key, d9);
      if (!enemy) benEnemyNav = false;
      benNavDetail.add('${_knPlanets[e.key]} α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[d9]} ${enemy ? "Γ£ô α▓╢α▓ñα│ìα▓░α│ü" : "Γ£ù"}');
    }
    if (malStrong && malOwnNav && benWeak && benEnemyNav && _animalSigns.contains(lagRashi)) {
      yogas.add(Yoga(
        shloka: 'α▓¬α▓╛α▓¬α▓╛ α▓¼α▓▓α▓┐α▓¿α▓â α▓╕α│ìα▓╡α▓¡α▓╛α▓ùα▓ùα▓╛α▓â α▓¬α▓╛α▓░α▓òα│ìα▓òα│ç α▓╡α▓┐α▓¼α▓▓α▓╛α▓╢α│ìα▓Ü α▓╢α│ïα▓¡α▓¿α▓╛α▓â αÑñ\nα▓▓α▓ùα│ìα▓¿α▓é α▓Ü α▓╡α▓┐α▓»α│ïα▓¿α▓┐α▓╕α▓éα▓¡α▓╡α▓é α▓ªα│âα▓╖α│ìα▓ƒα▓╛α▓ñα▓╛α▓¬α▓┐ α▓╡α▓┐α▓»α│ïα▓¿α▓┐α▓«α▓╛α▓ªα▓┐α▓╢α│çα▓ñα│ì αÑÑ',
        name: 'α▓¿α▓╡α▓╛α▓éα▓╢ α▓╡α▓┐α▓»α│ïα▓¿α▓┐ α▓»α│ïα▓ù',
        description: 'α▓▓α▓ùα│ìα▓¿: ${_rashiNames[lagRashi]} (α▓╡α▓┐α▓»α│ïα▓¿α▓┐ α▓░α▓╛α▓╢α▓┐)\n${malNavDetail.join(' | ')}\n${benNavDetail.join(' | ')}',
        result: 'α▓▓α▓ùα│ìα▓¿ α▓╡α▓┐α▓»α│ïα▓¿α▓┐ α▓░α▓╛α▓╢α▓┐: ${_rashiNames[lagRashi]}',
        rashi: lagRashi,
        planets: ['α▓░α▓╡α▓┐','α▓òα│üα▓£','α▓╢α▓¿α▓┐','α▓ùα│üα▓░α│ü','α▓╢α│üα▓òα│ìα▓░','α▓¼α│üα▓º','α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Shloka 3: Body part (always shown if shloka 1 or 2 active) ΓòÉΓòÉΓòÉ
    if (yogas.isNotEmpty) {
      final moonRashi = _rashiOf(moonLon);
      yogas.add(Yoga(
        shloka: 'α▓òα│ìα▓░α▓┐α▓»α▓â α▓╢α▓┐α▓░α│ï α▓╡α▓òα│ìα▓ñα▓ùα▓▓α│ç α▓ªα│ìα▓╡α▓┐α▓ñα│Çα▓»α▓â...',
        name: 'α▓Üα▓ñα│üα▓╖α│ìα▓¬α▓╛α▓ª α▓àα▓éα▓ù α▓¿α▓┐α▓░α│ìα▓úα▓»',
        description: 'α▓Üα▓éα▓ªα│ìα▓░ α▓░α▓╛α▓╢α▓┐: ${_rashiNames[moonRashi]}',
        result: 'α▓ªα│çα▓╣ α▓¡α▓╛α▓ù: ${_bodyParts[moonRashi]}',
        rashi: moonRashi,
        planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Shloka 4: Color & markings (if viyoni active) ΓòÉΓòÉΓòÉ
    if (yogas.isNotEmpty) {
      final lagNav = _d9Rashi(lag);
      final color = _rashiColors[lagNav];
      final allLons = [sun,moon,mars,mer,jup,ven,sat,rahu,ketu];
      final names = ['α▓░α▓╡α▓┐','α▓Üα▓éα▓ªα│ìα▓░','α▓òα│üα▓£','α▓¼α│üα▓º','α▓ùα│üα▓░α│ü','α▓╢α│üα▓òα│ìα▓░','α▓╢α▓¿α▓┐','α▓░α▓╛α▓╣α│ü','α▓òα│çα▓ñα│ü'];
      final aspecting = <String>[];
      for (int i = 0; i < allLons.length; i++) {
        if ((_rashiOf(allLons[i])+6)%12 == lagRashi) aspecting.add(names[i]);
      }
      final h7 = (lagRashi+6)%12;
      final in7 = <String>[];
      for (int i = 0; i < allLons.length; i++) {
        if (_rashiOf(allLons[i]) == h7) in7.add(names[i]);
      }
      yogas.add(Yoga(
        shloka: 'α▓▓α▓ùα│ìα▓¿α▓╛α▓éα▓╢α▓òα▓╛α▓ªα│ì α▓ùα│ìα▓░α▓╣α▓»α│ïα▓ùα│çα▓òα│ìα▓╖α▓úα▓╛α▓ªα│ìα▓╡α▓╛...',
        name: 'α▓╡α▓░α│ìα▓ú-α▓╕α▓éα▓ûα│ìα▓»α▓╛-α▓Üα▓┐α▓╣α│ìα▓¿α│å α▓»α│ïα▓ù',
        description: 'α▓▓α▓ùα│ìα▓¿ α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[lagNav]} | α▓▓α▓ùα│ìα▓¿ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${aspecting.isEmpty ? "α▓çα▓▓α│ìα▓▓" : aspecting.join(",")}\n7α▓¿α│ç α▓¡α▓╛α▓╡ (${_rashiNames[h7]}): ${in7.isEmpty ? "α▓ûα▓╛α▓▓α▓┐" : in7.join(",")}',
        result: 'α▓¼α▓úα│ìα▓ú: $color | α▓╕α▓éα▓ûα│ìα▓»α│å: ${aspecting.length} | α▓¼α│åα▓¿α│ìα▓¿ α▓ùα│üα▓░α│üα▓ñα│ü: ${in7.isEmpty ? "α▓çα▓▓α│ìα▓▓" : in7.join(",")}',
        rashi: lagRashi,
        planets: [...aspecting, ...in7],
      ));
    }

    // ΓòÉΓòÉΓòÉ Shloka 5: Bird birth ΓòÉΓòÉΓòÉ
    final lagDrek = _drekkanaNum(lag);
    final isBirdDrek = _birdDrekkanas.contains((lagRashi, lagDrek));
    final strongInLagList = <String>[];
    for (final e in malLons.entries) {
      if (_rashiOf(e.value) == lagRashi && isStrong(e.key)) strongInLagList.add(_knPlanets[e.key]!);
    }
    for (final e in benLons.entries) {
      if (_rashiOf(e.value) == lagRashi && isStrong(e.key)) strongInLagList.add(_knPlanets[e.key]!);
    }
    final lagNav = _d9Rashi(lag);
    final isChara = _charaRashis.contains(lagNav);
    final isMerNav = lagNav == 2 || lagNav == 5;

    if ((isBirdDrek && strongInLagList.isNotEmpty) || isChara || isMerNav) {
      final satR = _rashiOf(sat); final moonR = _rashiOf(moon);
      final satMoon = (satR-moonR).abs()%12 == 0 || (satR+6)%12 == moonR;
      String bType = 'α▓╕α▓╛α▓«α▓╛α▓¿α│ìα▓» α▓¬α▓òα│ìα▓╖α▓┐';
      if (satMoon) {
        final water = {3,7,11};
        bType = (water.contains(moonR) || water.contains(satR)) ? 'α▓£α▓▓α▓¬α▓òα│ìα▓╖α▓┐' : 'α▓¡α│éα▓Üα▓░ α▓¬α▓òα│ìα▓╖α▓┐';
      }
      // Build trigger reason
      final triggers = <String>[];
      if (isBirdDrek && strongInLagList.isNotEmpty) triggers.add('α▓¬α▓òα│ìα▓╖α▓┐ α▓ªα│ìα▓░α│çα▓òα│ìα▓òα▓╛α▓ú (${_rashiNames[lagRashi]}-$lagDrek) + α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐: ${strongInLagList.join(",")}');
      if (isChara) triggers.add('α▓Üα▓░ α▓¿α▓╡α▓╛α▓éα▓╢ α▓▓α▓ùα│ìα▓¿: ${_rashiNames[lagNav]}');
      if (isMerNav) triggers.add('α▓¼α│üα▓º α▓¿α▓╡α▓╛α▓éα▓╢ α▓▓α▓ùα│ìα▓¿: ${_rashiNames[lagNav]}');

      yogas.add(Yoga(
        shloka: 'α▓ûα▓ùα│ç α▓ªα│âα▓ùα▓╛α▓úα│ç α▓¼α▓▓α▓╕α▓éα▓»α│üα▓ñα│çα▓¿ α▓╡α▓╛...',
        name: 'α▓¬α▓òα│ìα▓╖α▓┐ α▓£α▓¿α│ìα▓« α▓»α│ïα▓ù',
        description: 'α▓▓α▓ùα│ìα▓¿: ${_rashiNames[lagRashi]} | α▓╢α▓¿α▓┐: ${_rashiNames[satR]} | α▓Üα▓éα▓ªα│ìα▓░: ${_rashiNames[moonR]}\n${triggers.join('\n')}',
        result: 'α▓¬α▓òα│ìα▓╖α▓┐ α▓¬α│ìα▓░α▓òα▓╛α▓░: $bType',
        rashi: lagRashi,
        planets: ['α▓╢α▓¿α▓┐','α▓Üα▓éα▓ªα│ìα▓░', ...strongInLagList],
      ));
    }
    // ΓòÉΓòÉΓòÉ Shloka 6: Tree birth (Vriksha Janma) ΓòÉΓòÉΓòÉ
    // Lagna lord, Moon, Jupiter, Sun all weak ΓåÆ tree birth
    const rashiLords = ['Mars','Venus','Mercury','Moon','Sun','Mercury','Venus','Mars','Jupiter','Saturn','Saturn','Jupiter'];
    final lagLord = rashiLords[lagRashi];
    final lagLordWeak = isWeak(lagLord);
    final moonWeak = isWeak('Moon');
    final jupWeak = isWeak('Jupiter');
    final sunWeak = isWeak('Sun');

    if (lagLordWeak && moonWeak && jupWeak && sunWeak) {
      // Water or land based on lagna navamsha
      final lagNavR = _d9Rashi(lag);
      const waterSigns = {3, 7, 11}; // Cancer, Scorpio, Pisces
      final treePlace = waterSigns.contains(lagNavR) ? 'α▓¿α│Çα▓░α▓┐α▓¿α▓▓α│ìα▓▓α▓┐ α▓¼α│åα▓│α│åα▓»α│üα▓╡ α▓«α▓░' : 'α▓¿α│åα▓▓α▓ªα▓▓α│ìα▓▓α▓┐ α▓¼α│åα▓│α│åα▓»α│üα▓╡ α▓«α▓░';

      // Count: house position of strongest planet from lagna
      final allPlanetLons = {'α▓░α▓╡α▓┐':sun,'α▓Üα▓éα▓ªα│ìα▓░':moon,'α▓òα│üα▓£':mars,'α▓¼α│üα▓º':mer,'α▓ùα│üα▓░α│ü':jup,'α▓╢α│üα▓òα│ìα▓░':ven,'α▓╢α▓¿α▓┐':sat};
      final treeCounts = <String>[];
      for (final e in allPlanetLons.entries) {
        final houseFrom = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
        treeCounts.add('${e.key}: ${houseFrom}α▓¿α│ç α▓«α▓¿α│å ΓåÆ $houseFrom α▓«α▓░');
      }

      yogas.add(Yoga(
        shloka: 'α▓╣α│ïα▓░α│çα▓éα▓ªα│üα▓╕α│éα▓░α▓┐α▓░α▓╡α▓┐α▓¡α▓┐α▓░α│ìα▓╡α▓┐α▓¼α▓▓α│êα▓╕α│ìα▓ñα▓░α│éα▓úα▓╛α▓é α▓ñα│ïα▓»α▓╕α│ìα▓Ñα▓▓α│ç α▓ñα▓░α│üα▓¡α▓╡α│ïsα▓éα▓╢α▓òα│âα▓ñα▓â α▓¬α│ìα▓░α▓¡α│çα▓ªα▓â αÑñ\nα▓▓α▓ùα│ìα▓¿α▓╛α▓ªα│ì α▓ùα│ìα▓░α▓╣α▓â α▓╕α│ìα▓Ñα▓▓α▓£α▓▓α▓░α│ìα▓òα│ìα▓╖α▓¬α▓ñα▓┐α▓╕α│ìα▓ñα│ü α▓»α▓╛α▓╡α▓╛α▓éα▓╕α│ìα▓ñα▓╛α▓╡α▓éα▓ñ α▓Åα▓╡ α▓ñα▓░α▓╡α▓â α▓╕α│ìα▓Ñα▓▓α▓ñα│ïα▓»α▓£α▓╛α▓ñα▓╛α▓â',
        name: 'α▓╡α│âα▓òα│ìα▓╖ α▓£α▓¿α│ìα▓« α▓»α│ïα▓ù',
        description: 'α▓▓α▓ùα│ìα▓¿: ${_rashiNames[lagRashi]} | α▓▓α▓ùα│ìα▓¿α│çα▓╢ (${_knPlanets[lagLord]}): α▓¼α▓▓α▓╣α│Çα▓¿ | α▓Üα▓éα▓ªα│ìα▓░: α▓¼α▓▓α▓╣α│Çα▓¿ | α▓ùα│üα▓░α│ü: α▓¼α▓▓α▓╣α│Çα▓¿ | α▓░α▓╡α▓┐: α▓¼α▓▓α▓╣α│Çα▓¿\nα▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[lagNavR]} ΓåÆ $treePlace\n${treeCounts.join('\n')}',
        result: '$treePlace',
        rashi: lagRashi,
        planets: [_knPlanets[lagLord]!, 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓ùα│üα▓░α│ü', 'α▓░α▓╡α▓┐'],
      ));

      // ΓòÉΓòÉΓòÉ Shloka 7: Tree type by planet ΓòÉΓòÉΓòÉ
      // SunΓåÆhardwood, SaturnΓåÆdry, MoonΓåÆmilky/sap, MarsΓåÆthorny, JupiterΓåÆsoft
      const treeTypes = {
        'Sun': 'α▓Æα▓│α▓ùα▓íα│å α▓ùα▓ƒα│ìα▓ƒα▓┐α▓»α▓╛α▓ª α▓«α▓░ (α▓àα▓éα▓ñα▓╕α│ìα▓╕α▓╛α▓░)',
        'Saturn': 'α▓Æα▓úα▓ùα▓┐α▓ª/α▓ªα│üα▓░α│ìα▓¡α▓╛α▓ùα│ìα▓» α▓«α▓░',
        'Moon': 'α▓╣α▓╛α▓▓α▓┐α▓¿α▓éα▓ñ α▓░α▓╕α▓╡α│üα▓│α│ìα▓│ α▓«α▓░ (α▓╕α│ìα▓¿α▓┐α▓ùα│ìα▓º)',
        'Mars': 'α▓«α│üα▓│α│ìα▓│α│üα▓│α│ìα▓│ α▓«α▓░ (α▓òα▓éα▓ƒα▓ò)',
        'Jupiter': 'α▓╣α▓úα│ìα▓úα│ü/α▓╣α│é α▓«α│âα▓ªα│ü α▓«α▓░',
      };
      const benefics = {'Jupiter','Venus','Mercury','Moon'};
      const malefics = {'Sun','Mars','Saturn','Rahu','Ketu'};
      // Odd signs = benefic rashis, even = malefic (simplified Vedic grouping)
      const shubhaRashis = {1, 2, 4, 5, 8, 11}; // Taurus, Gemini, Leo, Virgo, Sagittarius, Pisces

      final treeDetails = <String>[];
      final treePlanets = <String>[];
      for (final e in treeTypes.entries) {
        final pLon = allPlanetLons[_knPlanets[e.key]] ?? 0.0;
        final pRashi = _rashiOf(pLon);
        final isBeneficPlanet = benefics.contains(e.key);
        final inShubhaRashi = shubhaRashis.contains(pRashi);

        String quality = '';
        if (isBeneficPlanet && !inShubhaRashi) {
          quality = ' ΓåÆ α▓òα│åα▓ƒα│ìα▓ƒ α▓£α▓╛α▓ùα▓ªα▓▓α│ìα▓▓α▓┐ α▓Æα▓│α│ìα▓│α│åα▓» α▓«α▓░';
        } else if (!isBeneficPlanet && inShubhaRashi) {
          quality = ' ΓåÆ α▓Æα▓│α│ìα▓│α│åα▓» α▓£α▓╛α▓ùα▓ªα▓▓α│ìα▓▓α▓┐ α▓òα│åα▓ƒα│ìα▓ƒ α▓«α▓░';
        }

        treeDetails.add('${_knPlanets[e.key]} (${_rashiNames[pRashi]}): ${e.value}$quality');
        treePlanets.add(_knPlanets[e.key]!);
      }

      yogas.add(Yoga(
        shloka: 'α▓àα▓éα▓ñα▓╕α│ìα▓╕α▓╛α▓░α▓╛α▓¿α│ì α▓£α▓¿α▓»α▓ñα▓┐ α▓░α▓╡α▓┐α▓░α│ìα▓ªα│üα▓░α│ìα▓¡α▓ùα▓╛α▓¿α│ì α▓╕α│éα▓░α│ìα▓»α▓╕α│éα▓¿α│ü α▓òα│Çα▓░α│ïα▓¬α│çα▓ñα▓╛α▓éα▓╕α│üα▓╣α▓┐α▓¿α▓òα▓┐α▓░α▓ú α▓òα▓éα▓ƒα▓òα▓╛α▓░α▓╛α▓éα▓╢ α▓¡α│îα▓«: αÑñ\nα▓╕α│ìα▓¿α▓┐α▓ùα│ìα▓ªα▓╛α▓¿α▓┐α▓éα▓ªα│üα▓â α▓òα▓ƒα│üα▓òα▓╡α▓┐α▓ƒα▓¬α▓╛α▓¿α│ì α▓¡α│éα▓«α▓┐α▓¬α│üα▓ñα│ìα▓░α▓╢α│ìα▓Ü α▓¡α│éα▓»α▓â α▓╢α│üα▓¡α│ïα▓╜α▓╢α│üα▓¡α▓░α│ìα▓òα│ìα▓╖α│å α▓░α│üα▓Üα▓┐α▓░α▓é α▓òα│üα▓¡α│éα▓ñα▓▓α│ç α▓òα▓░α│ïα▓ñα▓┐ α▓╡α│âα▓òα│ìα▓╖α▓é α▓╡α▓┐α▓¬α▓░α│Çα▓ñα▓«α▓¿α│ìα▓»α▓Ñα▓╛ αÑñ',
        name: 'α▓╡α│âα▓òα│ìα▓╖ α▓¬α│ìα▓░α▓òα▓╛α▓░ α▓»α│ïα▓ù',
        description: '${treeDetails.join('\n')}',
        result: 'α▓ùα│ìα▓░α▓╣-α▓«α▓░ α▓╕α▓éα▓¼α▓éα▓º α▓¿α▓┐α▓░α│ìα▓úα▓»',
        rashi: lagRashi,
        planets: treePlanets,
      ));

      // ΓòÉΓòÉΓòÉ Shloka 8: Tree count by navamsha distance ΓòÉΓòÉΓòÉ
      final navDistDetails = <String>[];
      final navDistPlanets = <String>[];
      for (final e in allPlanetLons.entries) {
        final engName = _knPlanets.entries.where((kv) => kv.value == e.key).firstOrNull?.key;
        if (engName == null) continue;
        final currentNav = _d9Rashi(e.value);
        // Own navamsha = rashi lord's sign
        final ownNavList = <int>[];
        for (int i = 0; i < 12; i++) {
          if (rashiLords[i] == engName) ownNavList.add(i);
        }
        if (ownNavList.isEmpty) continue;
        final ownNav = ownNavList.first;
        final dist = ((currentNav - ownNav) % 12).abs();
        navDistDetails.add('${e.key}: α▓¿α▓╡α▓╛α▓éα▓╢ ${_rashiNames[currentNav]}, α▓╕α│ìα▓╡α▓¿α▓╡α▓╛α▓éα▓╢ ${_rashiNames[ownNav]} ΓåÆ $dist α▓«α▓░');
        navDistPlanets.add(e.key);
      }

      yogas.add(Yoga(
        shloka: 'α▓¬α▓░α▓╛α▓éα▓╢α▓òα│ç α▓»α▓╛α▓╡α▓ñα▓┐ α▓╡α▓┐α▓Üα│ìα▓»α│üα▓ñα▓â α▓╕α│ìα▓╡α▓òα▓╛α▓ªα│ìα▓¡α▓╡α▓éα▓ñα▓┐ α▓ñα│üα▓▓α│ìα▓»α▓╛α▓╕α│ìα▓ñα▓░α▓╡α▓╕α│ìα▓ñα▓Ñα▓╛α▓╡α▓┐α▓ºα▓╛α▓â',
        name: 'α▓¿α▓╡α▓╛α▓éα▓╢ α▓╡α│âα▓òα│ìα▓╖ α▓╕α▓éα▓ûα│ìα▓»α│å',
        description: '${navDistDetails.join('\n')}',
        result: 'α▓¿α▓╡α▓╛α▓éα▓╢ α▓ªα│éα▓░α▓ªα▓┐α▓éα▓ª α▓«α▓░α▓ùα▓│ α▓╕α▓éα▓ûα│ìα▓»α│å α▓¿α▓┐α▓░α│ìα▓úα▓»',
        rashi: lagRashi,
        planets: navDistPlanets,
      ));
    }
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // α▓¿α▓┐α▓╖α│çα▓òα▓╛α▓ºα│ìα▓»α▓╛α▓» (Chapter 4) ΓÇö Conception rules
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 1: Menstruation & Union timing ΓòÉΓòÉΓòÉ
    // Moon in anupachaya (1,2,4,5,7,8) ΓåÆ menstruation
    // Moon in upachaya (3,6,10,11) + benefic/male aspect ΓåÆ union
    final moonHouse = ((_rashiOf(moonLon) - lagRashi) % 12) + 1;
    const upachaya = {3, 6, 10, 11};
    const anupachaya = {1, 2, 4, 5, 7, 8};
    final moonInUpachaya = upachaya.contains(moonHouse);
    final moonInAnupachaya = anupachaya.contains(moonHouse);

    // Check benefic/male planet aspects on Moon
    final moonR = _rashiOf(moonLon);
    final beneficAspMoon = <String>[];
    final malePlanets = {'Sun', 'Mars', 'Jupiter'}; // Male grahas
    for (final e in {'Jupiter':jup,'Venus':ven,'Mercury':mer}.entries) {
      if ((_rashiOf(e.value) + 6) % 12 == moonR) beneficAspMoon.add(_knPlanets[e.key]!);
    }
    final maleAspMoon = <String>[];
    for (final e in {'Sun':sun,'Mars':mars,'Jupiter':jup}.entries) {
      if ((_rashiOf(e.value) + 6) % 12 == moonR) maleAspMoon.add(_knPlanets[e.key]!);
    }

    if (moonInAnupachaya) {
      yogas.add(Yoga(
        shloka: 'α▓òα│üα▓£α│çα▓éα▓ªα│üα▓╣α│çα▓ñα│ü α▓¬α│ìα▓░α▓ñα▓┐α▓«α▓╛α▓╕α▓«α▓╛α▓░α│ìα▓ñα▓╡α▓é α▓ùα▓ñα│ç α▓ñα│ü α▓¬α│Çα▓íα▓░α│ìα▓òα│ìα▓╖α▓«α▓¿α│üα▓╖α│ìα▓úα▓ªα│Çα▓ºα▓┐α▓ñα│î αÑñ\nα▓àα▓ñα│ïsα▓¿α│ìα▓»α▓Ñα▓╛α▓╕α│ìα▓Ñ α▓╢α│üα▓¡α▓¬α│üα▓éα▓ùα│ìα▓░α▓╣α│çα▓òα│ìα▓╖α▓┐α▓ñα│ç α▓¿α▓░α│çα▓ú α▓╕α▓éα▓»α│ïα▓ùα▓«α│üα▓¬α│êα▓ñα▓┐ α▓òα▓╛α▓«α▓┐α▓¿α│Ç',
        name: 'α▓ïα▓ñα│üα▓ªα▓░α│ìα▓╢α▓¿ α▓»α│ïα▓ù',
        description: 'α▓Üα▓éα▓ªα│ìα▓░ ${moonHouse}α▓¿α│ç α▓«α▓¿α│å (α▓àα▓¿α│üα▓¬α▓Üα▓») ΓåÆ α▓ïα▓ñα│üα▓ªα▓░α│ìα▓╢α▓¿ α▓╕α│éα▓Üα▓¿α│å',
        result: 'α▓Üα▓éα▓ªα│ìα▓░ α▓àα▓¿α│üα▓¬α▓Üα▓» α▓╕α│ìα▓Ñα▓╛α▓¿: α▓ïα▓ñα│üα▓«α▓ñα▓┐ α▓╕α▓éα▓¡α▓╡',
        rashi: moonR,
        planets: ['α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£'],
      ));
    }
    if (moonInUpachaya && (beneficAspMoon.isNotEmpty || maleAspMoon.isNotEmpty)) {
      yogas.add(Yoga(
        shloka: 'α▓òα│üα▓£α│çα▓éα▓ªα│üα▓╣α│çα▓ñα│ü α▓¬α│ìα▓░α▓ñα▓┐α▓«α▓╛α▓╕α▓«α▓╛α▓░α│ìα▓ñα▓╡α▓é α▓ùα▓ñα│ç α▓ñα│ü α▓¬α│Çα▓íα▓░α│ìα▓òα│ìα▓╖α▓«α▓¿α│üα▓╖α│ìα▓úα▓ªα│Çα▓ºα▓┐α▓ñα│î αÑñ\nα▓àα▓ñα│ïsα▓¿α│ìα▓»α▓Ñα▓╛α▓╕α│ìα▓Ñ α▓╢α│üα▓¡α▓¬α│üα▓éα▓ùα│ìα▓░α▓╣α│çα▓òα│ìα▓╖α▓┐α▓ñα│ç α▓¿α▓░α│çα▓ú α▓╕α▓éα▓»α│ïα▓ùα▓«α│üα▓¬α│êα▓ñα▓┐ α▓òα▓╛α▓«α▓┐α▓¿α│Ç',
        name: 'α▓«α▓┐α▓▓α▓¿ α▓»α│ïα▓ù',
        description: 'α▓Üα▓éα▓ªα│ìα▓░ ${moonHouse}α▓¿α│ç α▓«α▓¿α│å (α▓ëα▓¬α▓Üα▓»)\nα▓╢α│üα▓¡ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${beneficAspMoon.isEmpty ? "α▓çα▓▓α│ìα▓▓" : beneficAspMoon.join(",")}\nα▓¬α│üα▓░α│üα▓╖ α▓ùα│ìα▓░α▓╣ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${maleAspMoon.isEmpty ? "α▓çα▓▓α│ìα▓▓" : maleAspMoon.join(",")}',
        result: 'α▓¬α│üα▓░α│üα▓╖ α▓╕α▓éα▓»α│ïα▓ù α▓╕α▓éα▓¡α▓╡',
        rashi: moonR,
        planets: ['α▓Üα▓éα▓ªα│ìα▓░', ...beneficAspMoon, ...maleAspMoon],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 2: Nature of union from 7th house ΓòÉΓòÉΓòÉ
    final h7Rashi = (lagRashi + 6) % 12;
    final malAsp7 = <String>[];
    final benAsp7 = <String>[];
    final malIn7 = <String>[];
    final benIn7 = <String>[];
    final allPLons = {'Sun':sun,'Moon':moon,'Mars':mars,'Mercury':mer,'Jupiter':jup,'Venus':ven,'Saturn':sat,'Rahu':rahu,'Ketu':ketu};
    for (final e in allPLons.entries) {
      final pr = _rashiOf(e.value);
      final isBen = {'Jupiter','Venus','Mercury','Moon'}.contains(e.key);
      if (pr == h7Rashi) {
        (isBen ? benIn7 : malIn7).add(_knPlanets[e.key]!);
      }
      if ((pr + 6) % 12 == h7Rashi) {
        (isBen ? benAsp7 : malAsp7).add(_knPlanets[e.key]!);
      }
    }
    if (malIn7.isNotEmpty || malAsp7.isNotEmpty || benIn7.isNotEmpty || benAsp7.isNotEmpty) {
      String unionType = '';
      if (malIn7.isNotEmpty || malAsp7.isNotEmpty) unionType += 'α▓òα│ïα▓¬α▓ªα▓┐α▓éα▓ª α▓òα│éα▓íα▓┐α▓ª α▓«α▓┐α▓▓α▓¿';
      if (benIn7.isNotEmpty || benAsp7.isNotEmpty) {
        if (unionType.isNotEmpty) unionType += ' + ';
        unionType += 'α▓╡α▓┐α▓▓α▓╛α▓╕ α▓╣α▓╛α▓╕α│ìα▓»α▓ªα▓┐α▓éα▓ª α▓òα│éα▓íα▓┐α▓ª α▓«α▓┐α▓▓α▓¿';
      }
      yogas.add(Yoga(
        shloka: 'α▓»α▓Ñα▓╛α▓╕α│ìα▓ñα▓░α▓╛α▓╢α▓┐α▓░α│ìα▓«α▓┐α▓Ñα│üα▓¿α▓é α▓╕α▓«α│çα▓ñα▓┐ α▓ñα▓Ñα│êα▓╡ α▓╡α▓╛α▓Üα│ìα▓» α▓«α▓┐α▓Ñα│üα▓¿ α▓¬α│ìα▓░α▓»α│ïα▓ùα▓â αÑñ\nα▓àα▓╕α▓ªα│ìα▓ùα│ìα▓░α▓╣α▓╛α▓▓α│ïα▓òα▓┐α▓ñα▓╕α▓éα▓»α│üα▓ñα│çsα▓╕α│ìα▓ñα│ç α▓╕α▓░α│ïα▓╖ α▓çα▓╖α│ìα▓ƒα│å α▓╕α▓╡α▓┐α▓▓α▓╛α▓╕α▓╣α▓╛α▓╕α▓â',
        name: 'α▓«α▓┐α▓▓α▓¿ α▓╕α│ìα▓╡α▓░α│éα▓¬ α▓»α│ïα▓ù',
        description: '7α▓¿α│ç α▓«α▓¿α│å: ${_rashiNames[h7Rashi]}\nα▓¬α▓╛α▓¬ α▓»α│ïα▓ù/α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${[...malIn7,...malAsp7].isEmpty ? "α▓çα▓▓α│ìα▓▓" : [...malIn7,...malAsp7].join(",")}\nα▓╢α│üα▓¡ α▓»α│ïα▓ù/α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${[...benIn7,...benAsp7].isEmpty ? "α▓çα▓▓α│ìα▓▓" : [...benIn7,...benAsp7].join(",")}',
        result: unionType,
        rashi: h7Rashi,
        planets: [...malIn7, ...malAsp7, ...benIn7, ...benAsp7],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 3: Conception yoga ΓòÉΓòÉΓòÉ
    // Sun,Moon,Venus,Mars in own navamsha OR Jupiter in 1/5/9
    final sunOwnNav = _isOwnNavamsha('Sun', _d9Rashi(sun));
    final moonOwnNav = _isOwnNavamsha('Moon', _d9Rashi(moon));
    final venOwnNav = _isOwnNavamsha('Venus', _d9Rashi(ven));
    final marsOwnNav = _isOwnNavamsha('Mars', _d9Rashi(mars));
    final allOwnNav = sunOwnNav && moonOwnNav && venOwnNav && marsOwnNav;

    final jupHouse = ((_rashiOf(jup) - lagRashi) % 12) + 1;
    final jupInTrikona = jupHouse == 1 || jupHouse == 5 || jupHouse == 9;

    if (allOwnNav || jupInTrikona) {
      final details = <String>[];
      if (allOwnNav) {
        details.add('α▓░α▓╡α▓┐ α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[_d9Rashi(sun)]} ${sunOwnNav ? "Γ£ô α▓╕α│ìα▓╡" : "Γ£ù"}');
        details.add('α▓Üα▓éα▓ªα│ìα▓░ α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[_d9Rashi(moon)]} ${moonOwnNav ? "Γ£ô α▓╕α│ìα▓╡" : "Γ£ù"}');
        details.add('α▓╢α│üα▓òα│ìα▓░ α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[_d9Rashi(ven)]} ${venOwnNav ? "Γ£ô α▓╕α│ìα▓╡" : "Γ£ù"}');
        details.add('α▓òα│üα▓£ α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[_d9Rashi(mars)]} ${marsOwnNav ? "Γ£ô α▓╕α│ìα▓╡" : "Γ£ù"}');
      }
      if (jupInTrikona) details.add('α▓ùα│üα▓░α│ü ${jupHouse}α▓¿α│ç α▓«α▓¿α│å (α▓ñα│ìα▓░α▓┐α▓òα│ïα▓ú)');

      yogas.add(Yoga(
        shloka: 'α▓░α▓╡α│Çα▓éα▓ªα│üα▓╢α│üα▓òα│ìα▓░α▓╛α▓╡α▓¿α▓┐α▓£α│êα▓â α▓╕α│ìα▓╡α▓¡α▓╛α▓ùα▓ùα│êα▓░α│ìα▓ùα│üα▓░α│î α▓ñα│ìα▓░α▓┐α▓òα│ïα▓úα│ïα▓ªα▓»α▓ºα▓░α│ìα▓«α▓ùα│çsα▓¬α▓┐ α▓╡α▓╛ αÑñ\nα▓¡α▓╡α▓ñα│ìα▓»α▓¬α▓ñα│ìα▓»α▓é α▓╣α▓┐ α▓╡α▓┐α▓¼α│Çα▓£α▓┐α▓¿α▓╛α▓«α▓┐α▓«α│ç α▓òα▓░α▓╛ α▓╣α▓┐α▓«α▓╛α▓éα▓╢α│ïα▓░α│ìα▓╡α▓┐α▓ªα│âα▓╢α▓╛α▓«α▓┐α▓╡α▓╛α▓½α▓▓α▓╛α▓â',
        name: 'α▓ùα▓░α│ìα▓¡α▓ºα▓╛α▓░α▓úα│å α▓»α│ïα▓ù',
        description: '${details.join('\n')}',
        result: 'α▓ùα▓░α│ìα▓¡α▓ºα▓╛α▓░α▓úα│å α▓╕α▓éα▓¡α▓╡',
        rashi: lagRashi,
        planets: ['α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α│üα▓òα│ìα▓░', 'α▓òα│üα▓£', 'α▓ùα│üα▓░α│ü'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 4: Disease & Death yoga ΓòÉΓòÉΓòÉ
    final sunHouse = ((_rashiOf(sun) - lagRashi) % 12) + 1;
    final moonHouseN = ((_rashiOf(moonLon) - lagRashi) % 12) + 1;
    final marsR = _rashiOf(mars);
    final satR2 = _rashiOf(sat);

    // Mars/Saturn aspect check on Sun & Moon
    final sunR = _rashiOf(sun);
    final moonR2 = _rashiOf(moonLon);
    bool marsAspSun = (marsR + 6) % 12 == sunR || (marsR + 3) % 12 == sunR || (marsR + 7) % 12 == sunR;
    bool satAspSun = (satR2 + 6) % 12 == sunR || (satR2 + 2) % 12 == sunR || (satR2 + 9) % 12 == sunR;
    bool marsAspMoon = (marsR + 6) % 12 == moonR2 || (marsR + 3) % 12 == moonR2 || (marsR + 7) % 12 == moonR2;
    bool satAspMoon = (satR2 + 6) % 12 == moonR2 || (satR2 + 2) % 12 == moonR2 || (satR2 + 9) % 12 == moonR2;
    final marsSatAsp = (marsAspSun || marsAspMoon) && (satAspSun || satAspMoon);

    // Sun & Moon in 7th ΓåÆ disease
    if (sunHouse == 7 && moonHouseN == 7 && marsSatAsp) {
      yogas.add(Yoga(
        shloka: 'α▓ªα▓┐α▓╡α▓╛α▓òα▓░α│çα▓éα▓ªα│ìα▓╡α▓â α▓╕α│ìα▓«α▓░α▓ùα│î α▓òα│üα▓£α▓╛α▓░α│ìα▓òα▓Üα│î α▓ùα▓ªα▓¬α│ìα▓░α▓ªα│î α▓¬α│üα▓éα▓ùα▓▓α▓»α│ïα▓╖α▓┐α▓ñα│ïα▓╕α│ìα▓ñα▓ªα▓╛ αÑñ\nα▓╡α│ìα▓»α▓»α▓╕α│ìα▓╡α▓ùα│î α▓«α│âα▓ñα│ìα▓»α│üα▓òα▓░α│î α▓ñα▓Ñα▓╛ α▓»α│üα▓ñα│î α▓ñα▓ªα│çα▓òα▓ªα│âα▓╖α│ìα▓ƒα▓╛ α▓«α▓░α▓úα▓╛α▓» α▓òα▓▓α│ìα▓¬α▓┐α▓ñα│î',
        name: 'α▓░α│ïα▓ù α▓»α│ïα▓ù (α▓¿α▓┐α▓╖α│çα▓ò)',
        description: 'α▓░α▓╡α▓┐+α▓Üα▓éα▓ªα│ìα▓░ 7α▓¿α│ç α▓«α▓¿α│å (${_rashiNames[h7Rashi]})\nα▓òα│üα▓£ (${_rashiNames[marsR]}) α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${marsAspSun || marsAspMoon ? "Γ£ô" : "Γ£ù"}\nα▓╢α▓¿α▓┐ (${_rashiNames[satR2]}) α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${satAspSun || satAspMoon ? "Γ£ô" : "Γ£ù"}',
        result: 'α▓¬α│üα▓░α│üα▓╖ α▓«α▓ñα│ìα▓ñα│ü α▓╕α│ìα▓ñα│ìα▓░α│Çα▓ùα│å α▓░α│ïα▓ù α▓╕α▓éα▓¡α▓╡',
        rashi: h7Rashi,
        planets: ['α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£', 'α▓╢α▓¿α▓┐'],
      ));
    }

    // Sun in 12th & Moon in 2nd (or vice versa) + Mars/Saturn aspect ΓåÆ death
    final sunIn12 = sunHouse == 12;
    final moonIn2 = moonHouseN == 2;
    final sunIn2 = sunHouse == 2;
    final moonIn12 = moonHouseN == 12;
    if (((sunIn12 && moonIn2) || (sunIn2 && moonIn12)) && marsSatAsp) {
      yogas.add(Yoga(
        shloka: 'α▓ªα▓┐α▓╡α▓╛α▓òα▓░α│çα▓éα▓ªα│ìα▓╡α▓â α▓╕α│ìα▓«α▓░α▓ùα│î α▓òα│üα▓£α▓╛α▓░α│ìα▓òα▓Üα│î α▓ùα▓ªα▓¬α│ìα▓░α▓ªα│î α▓¬α│üα▓éα▓ùα▓▓α▓»α│ïα▓╖α▓┐α▓ñα│ïα▓╕α│ìα▓ñα▓ªα▓╛ αÑñ\nα▓╡α│ìα▓»α▓»α▓╕α│ìα▓╡α▓ùα│î α▓«α│âα▓ñα│ìα▓»α│üα▓òα▓░α│î α▓ñα▓Ñα▓╛ α▓»α│üα▓ñα│î α▓ñα▓ªα│çα▓òα▓ªα│âα▓╖α│ìα▓ƒα▓╛ α▓«α▓░α▓úα▓╛α▓» α▓òα▓▓α│ìα▓¬α▓┐α▓ñα│î',
        name: 'α▓«α▓░α▓ú α▓»α│ïα▓ù (α▓¿α▓┐α▓╖α│çα▓ò)',
        description: 'α▓░α▓╡α▓┐ ${sunHouse}α▓¿α│ç α▓«α▓¿α│å | α▓Üα▓éα▓ªα│ìα▓░ ${moonHouseN}α▓¿α│ç α▓«α▓¿α│å (12+2 α▓╕α│ìα▓Ñα▓╛α▓¿)\nα▓òα│üα▓£ (${_rashiNames[marsR]}) α▓ªα│âα▓╖α│ìα▓ƒα▓┐: Γ£ô | α▓╢α▓¿α▓┐ (${_rashiNames[satR2]}) α▓ªα│âα▓╖α│ìα▓ƒα▓┐: Γ£ô',
        result: 'α▓çα▓¼α│ìα▓¼α▓░α▓┐α▓ùα│é α▓«α▓░α▓ú α▓╕α▓éα▓¡α▓╡',
        rashi: lagRashi,
        planets: ['α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£', 'α▓╢α▓¿α▓┐'],
      ));
    }
    // ΓòÉΓòÉΓòÉ Nisheka Shloka 5: Parent karakas (day/night) ΓòÉΓòÉΓòÉ
    // Determine if birth time is day or night using Sun position
    // Sun above horizon (houses 7-12 from lagna) = day, else night
    final isDay = sunHouse >= 7 && sunHouse <= 12;
    final fatherK = isDay ? 'α▓░α▓╡α▓┐' : 'α▓╢α▓¿α▓┐';
    final motherK = isDay ? 'α▓╢α│üα▓òα│ìα▓░' : 'α▓Üα▓éα▓ªα│ìα▓░';
    final uncleK = isDay ? 'α▓╢α▓¿α▓┐' : 'α▓░α▓╡α▓┐';
    final auntK = isDay ? 'α▓Üα▓éα▓ªα│ìα▓░' : 'α▓╢α│üα▓òα│ìα▓░';

    // Check odd/even rashi for shubha phala
    final fatherLon = isDay ? sun : sat;
    final motherLon = isDay ? ven : moon;
    final fR = _rashiOf(fatherLon);
    final mR = _rashiOf(motherLon);
    final fOdd = fR % 2 == 0; // 0-indexed: Aries=0(even idx=odd sign)
    final mEven = mR % 2 == 1; // odd idx = even sign
    final shubha = fOdd && mEven;

    yogas.add(Yoga(
      shloka: 'α▓ªα▓┐α▓╡α▓╛α▓░α│ìα▓òα▓╢α│üα▓òα│ìα▓░ α▓¬α▓┐α▓ñα│âα▓«α▓╛α▓ñα│âα▓╕α▓éα▓£α│ìα▓£α▓┐ α▓╢α▓¿α│êα▓╢α│ìα▓Üα▓░α│çα▓éα▓ªα│é α▓¿α▓┐α▓╢α▓┐ α▓ñα▓ªα│ìα▓╡α▓┐α▓¬α▓░α│ìα▓»α▓»α▓╛α▓ñα│ì αÑñ\nα▓¬α▓┐α▓ñα│âα▓╡α│ìα▓»α▓«α▓╛α▓ñα│âα▓╖α│ìα▓ƒα▓╕α│âα▓╕α▓éα▓£α│ìα▓£α▓┐α▓ñα│î α▓ñα│ü α▓ñα▓╛α▓╡α▓½α│îα▓£α▓»α│üα▓ùα│ìα▓ºα▓░α│ìα▓òα│ìα▓╖α▓ùα▓ñα│î α▓ñα▓»α│ïα▓â α▓╢α│üα▓¡α│î',
      name: 'α▓¬α▓┐α▓ñα│â-α▓«α▓╛α▓ñα│â α▓òα▓╛α▓░α▓ò α▓»α│ïα▓ù',
      description: '${isDay ? "α▓╣α▓ùα▓▓α│ü" : "α▓░α▓╛α▓ñα│ìα▓░α▓┐"} α▓£α▓¿α▓¿\nα▓ñα▓éα▓ªα│å α▓òα▓╛α▓░α▓ò: $fatherK (${_rashiNames[fR]}) | α▓ñα▓╛α▓»α▓┐ α▓òα▓╛α▓░α▓ò: $motherK (${_rashiNames[mR]})\nα▓Üα▓┐α▓òα│ìα▓òα▓¬α│ìα▓¬: $uncleK | α▓Üα▓┐α▓òα│ìα▓òα▓«α│ìα▓«: $auntK',
      result: shubha ? 'α▓╢α│üα▓¡ α▓½α▓▓ (α▓¼α│åα▓╕/α▓╕α▓« α▓░α▓╛α▓╢α▓┐ Γ£ô)' : 'α▓╢α│üα▓¡ α▓½α▓▓ α▓àα▓¿α▓┐α▓╢α│ìα▓Üα▓┐α▓ñ',
      rashi: lagRashi,
      planets: [fatherK, motherK, uncleK, auntK],
    ));

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 6: Pregnant woman death (malefics in lagna) ΓòÉΓòÉΓòÉ
    final malInLag = <String>[];
    final benAspLag = <String>[];
    for (final e in allPLons.entries) {
      final pr = _rashiOf(e.value);
      final isBen = {'Jupiter','Venus','Mercury','Moon'}.contains(e.key);
      if (pr == lagRashi && !isBen) malInLag.add(_knPlanets[e.key]!);
      if ((pr + 6) % 12 == lagRashi && isBen) benAspLag.add(_knPlanets[e.key]!);
    }
    if (malInLag.isNotEmpty && benAspLag.isEmpty) {
      yogas.add(Yoga(
        shloka: 'α▓àα▓¡α▓┐α▓▓α▓╖α▓ªα│ìα▓ºα▓┐α▓░α│üα▓ªα▓»α▓░α│ìα▓òα│ìα▓╖α▓«α▓╕α▓ªα│ìα▓ºα▓┐α▓░α│ìα▓«α▓░α▓úα▓«α│çα▓ñα▓┐ α▓╢α│üα▓¡α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓«α▓»α▓╛α▓ñα│ç',
        name: 'α▓ùα▓░α│ìα▓¡α▓┐α▓úα▓┐ α▓«α▓░α▓ú α▓»α│ïα▓ù (α│¼)',
        description: 'α▓▓α▓ùα│ìα▓¿ (${_rashiNames[lagRashi]}) α▓¬α▓╛α▓¬α▓░α│ü: ${malInLag.join(",")}\nα▓╢α│üα▓¡ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: α▓çα▓▓α│ìα▓▓',
        result: 'α▓ùα▓░α│ìα▓¡α▓┐α▓úα▓┐ α▓«α▓░α▓ú α▓╕α▓éα▓¡α▓╡',
        rashi: lagRashi,
        planets: malInLag,
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 7: Saturn in lagna + waning Moon & Mars aspect ΓòÉΓòÉΓòÉ
    final satInLag = _rashiOf(sat) == lagRashi;
    final moonWaneDiff = (moonLon - sun + 360) % 360;
    final moonWaning = moonWaneDiff > 180; // Krishna Paksha = waning
    final marsAspLag = (marsR + 6) % 12 == lagRashi || (marsR + 3) % 12 == lagRashi || (marsR + 7) % 12 == lagRashi;
    final moonAspLag = (moonR2 + 6) % 12 == lagRashi;
    if (satInLag && moonWaning && (marsAspLag || moonAspLag)) {
      yogas.add(Yoga(
        shloka: 'α▓ëα▓ªα▓»α▓░α▓╛α▓╢α▓┐α▓╕α▓╣α▓┐α▓ñα│ç α▓Ü α▓»α▓«α│ç α▓╕α│ìα▓ñα│ìα▓░α│Ç α▓Äα▓ùα▓▓α▓┐α▓ñα│ïα▓íα│üα▓¬α▓ñα▓┐α▓¡α│éα▓╕α│üα▓ñα▓ªα│âα▓╖α│ìα▓ƒα│ç',
        name: 'α▓ùα▓░α│ìα▓¡α▓┐α▓úα▓┐ α▓«α▓░α▓ú α▓»α│ïα▓ù (α│¡)',
        description: 'α▓╢α▓¿α▓┐ α▓▓α▓ùα│ìα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ (${_rashiNames[lagRashi]})\nα▓òα│ìα▓╖α│Çα▓ú α▓Üα▓éα▓ªα│ìα▓░: ${moonWaning ? "Γ£ô" : "Γ£ù"}\nα▓òα│üα▓£ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${marsAspLag ? "Γ£ô" : "Γ£ù"}',
        result: 'α▓ùα▓░α│ìα▓¡α▓┐α▓úα▓┐ α▓«α▓░α▓ú α▓╕α▓éα▓¡α▓╡',
        rashi: lagRashi,
        planets: ['α▓╢α▓¿α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 8: Papa Kartari on lagna & Moon ΓòÉΓòÉΓòÉ
    // Check if lagna/Moon hemmed between malefics without benefic aspect
    bool _isPapaKartari(int rashi) {
      final prev = (rashi - 1 + 12) % 12;
      final next = (rashi + 1) % 12;
      bool malPrev = false, malNext = false;
      for (final e in allPLons.entries) {
        if ({'Sun','Mars','Saturn','Rahu','Ketu'}.contains(e.key)) {
          if (_rashiOf(e.value) == prev) malPrev = true;
          if (_rashiOf(e.value) == next) malNext = true;
        }
      }
      return malPrev && malNext;
    }
    bool _hasBenAsp(int rashi) {
      for (final e in allPLons.entries) {
        if ({'Jupiter','Venus','Mercury','Moon'}.contains(e.key)) {
          if ((_rashiOf(e.value) + 6) % 12 == rashi) return true;
        }
      }
      return false;
    }
    final lagPK = _isPapaKartari(lagRashi);
    final moonPK = _isPapaKartari(moonR2);
    final lagNoBen = !_hasBenAsp(lagRashi);
    final moonNoBen = !_hasBenAsp(moonR2);
    if ((lagPK && lagNoBen) || (moonPK && moonNoBen)) {
      yogas.add(Yoga(
        shloka: 'α▓àα▓╢α│üα▓¡α▓ªα│ìα▓╡α▓»α▓«α▓ºα│ìα▓»α▓╕α▓éα▓╕α│ìα▓Ñα▓┐α▓ñα│î α▓▓α▓ùα│ìα▓¿α▓éα▓ªα│é α▓¿ α▓Ü α▓╕α│îα▓«α│ìα▓»α▓╡α│Çα▓òα│ìα▓╖α▓┐α▓ñα│ì αÑñ\nα▓»α│üα▓ùα▓¬α▓ñα│ì α▓¬α│âα▓Ñα▓ùα│çα▓╡ α▓╡α▓╛ α▓╡α▓ªα│çα▓¿α│ìα▓¿α▓╛α▓░α│Ç α▓ùα▓░α│ìα▓¡α▓»α│üα▓ñα▓╛ α▓╡α▓┐α▓¬α▓ªα│ìα▓»α▓ñα│ç',
        name: 'α▓¬α▓╛α▓¬α▓òα▓░α│ìα▓ñα▓░α▓┐ α▓«α▓░α▓ú α▓»α│ïα▓ù (α│«)',
        description: 'α▓▓α▓ùα│ìα▓¿ α▓¬α▓╛α▓¬α▓òα▓░α│ìα▓ñα▓░α▓┐: ${lagPK ? "Γ£ô" : "Γ£ù"} | α▓╢α│üα▓¡ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${lagNoBen ? "α▓çα▓▓α│ìα▓▓" : "α▓çα▓ªα│å"}\nα▓Üα▓éα▓ªα│ìα▓░ α▓¬α▓╛α▓¬α▓òα▓░α│ìα▓ñα▓░α▓┐: ${moonPK ? "Γ£ô" : "Γ£ù"} | α▓╢α│üα▓¡ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${moonNoBen ? "α▓çα▓▓α│ìα▓▓" : "α▓çα▓ªα│å"}',
        result: 'α▓ùα▓░α│ìα▓¡α▓┐α▓úα▓┐ α▓«α▓░α▓ú α▓╕α▓éα▓¡α▓╡ (α▓Æα▓ƒα│ìα▓ƒα▓┐α▓ùα│å/α▓¬α│ìα▓░α▓ñα│ìα▓»α│çα▓ò)',
        rashi: lagRashi,
        planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 9: Mars in 4/8 from lagna or Moon ΓòÉΓòÉΓòÉ
    final marsFromLag = ((marsR - lagRashi) % 12) + 1;
    final marsFromMoon = ((marsR - moonR2) % 12) + 1;
    final marsIn48 = marsFromLag == 4 || marsFromLag == 8 || marsFromMoon == 4 || marsFromMoon == 8;
    // Mars+Sun in 4th and 12th with waning Moon
    final sunFromLag = sunHouse;
    final marsIn4Sun12 = (marsFromLag == 4 && sunFromLag == 12) || (marsFromLag == 12 && sunFromLag == 4);
    if (marsIn48 || (marsIn4Sun12 && moonWaning)) {
      final detail = <String>[];
      if (marsFromLag == 4 || marsFromLag == 8) detail.add('α▓òα│üα▓£ α▓▓α▓ùα│ìα▓¿α▓ªα▓┐α▓éα▓ª ${marsFromLag}α▓¿α│ç α▓«α▓¿α│å');
      if (marsFromMoon == 4 || marsFromMoon == 8) detail.add('α▓òα│üα▓£ α▓Üα▓éα▓ªα│ìα▓░α▓¿α▓┐α▓éα▓ª ${marsFromMoon}α▓¿α│ç α▓«α▓¿α│å');
      if (marsIn4Sun12 && moonWaning) detail.add('α▓òα│üα▓£+α▓░α▓╡α▓┐ 4/12 α▓╕α│ìα▓Ñα▓╛α▓¿, α▓òα│ìα▓╖α│Çα▓ú α▓Üα▓éα▓ªα│ìα▓░');
      yogas.add(Yoga(
        shloka: 'α▓╢α▓╢α▓┐α▓¿α▓╢α│ìα▓Üα▓ñα│üα▓░α│ìα▓Ñα▓ùα│ç α▓▓α▓ùα│ìα▓¿α▓╛α▓ªα│ìα▓╡α▓╛ α▓¿α▓┐α▓ºα▓¿α▓╛α▓╢α│ìα▓░α▓┐α▓ñα│ç α▓òα│üα▓Üα│ç αÑñ\nα▓¼α▓éα▓ºα▓éα▓ñα│ìα▓»α▓ùα▓»α│ï α▓òα│üα▓£α▓╛α▓░α│ìα▓òα▓»α│ïα▓â α▓òα│ìα▓╖α│Çα▓úα│çα▓éα▓ªα│î α▓¿α▓┐α▓ºα▓¿α▓╛α▓» α▓¬α│éα▓░α│ìα▓╡α▓╡α▓ñα│ì',
        name: 'α▓òα│üα▓£ α▓╕α│ìα▓Ñα▓╛α▓¿ α▓«α▓░α▓ú α▓»α│ïα▓ù (α│»)',
        description: '${detail.join('\n')}',
        result: 'α▓ùα▓░α│ìα▓¡α▓┐α▓úα▓┐ α▓«α▓░α▓ú α▓╕α▓éα▓¡α▓╡',
        rashi: marsR,
        planets: ['α▓òα│üα▓£', 'α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 10: Mars+Sun in 1/7 ΓåÆ weapon death; month lord afflicted ΓåÆ miscarriage ΓòÉΓòÉΓòÉ
    final marsIn1 = marsFromLag == 1;
    final marsIn7 = marsFromLag == 7;
    final sunIn1 = sunHouse == 1;
    final sunIn7 = sunHouse == 7;
    if ((marsIn1 && sunIn7) || (marsIn7 && sunIn1)) {
      yogas.add(Yoga(
        shloka: 'α▓ëα▓ªα▓»α▓╛α▓╕α│ìα▓ñα▓ùα▓»α│ïα▓â α▓òα│üα▓Üα▓╛α▓░α│ìα▓òα▓»α│ïα▓░α│ìα▓¿α▓┐α▓ºα▓¿α▓é α▓╢α▓╕α│ìα▓ñα│ìα▓░α▓òα│âα▓ñα▓é α▓╡α▓ªα│çα▓ñα│ìα▓ñα▓ªα▓╛ αÑñ\nα▓«α▓╛α▓╕α▓╛α▓ºα▓┐α▓¬α▓ñα│î α▓¿α▓┐α▓¬α│Çα▓íα▓┐α▓ñα│ç α▓ñα▓ñα│ìα▓òα▓╛α▓▓α│ç α▓╕α│ìα▓░α▓╡α▓úα▓é α▓╕α▓«α▓╛α▓ªα▓┐α▓╢α│çα▓ñα│ì',
        name: 'α▓╢α▓╕α│ìα▓ñα│ìα▓░ α▓«α▓░α▓ú α▓»α│ïα▓ù (α│ºα│ª)',
        description: 'α▓òα│üα▓£ ${marsFromLag}α▓¿α│ç α▓«α▓¿α│å | α▓░α▓╡α▓┐ ${sunHouse}α▓¿α│ç α▓«α▓¿α│å\nα▓▓α▓ùα│ìα▓¿-7 α▓àα▓òα│ìα▓╖α▓ªα▓▓α│ìα▓▓α▓┐ α▓òα│üα▓£+α▓░α▓╡α▓┐',
        result: 'α▓╢α▓╕α│ìα▓ñα│ìα▓░α▓╛α▓╕α│ìα▓ñα│ìα▓░α▓ùα▓│α▓┐α▓éα▓ª α▓«α▓░α▓ú α▓╕α▓éα▓¡α▓╡',
        rashi: lagRashi,
        planets: ['α▓òα│üα▓£', 'α▓░α▓╡α▓┐'],
      ));
    }

    // Month lord affliction check (pregnancy months: 1-Sun,2-Moon,3-Mars,4-Mer,5-Jup,6-Ven,7-Sat)
    const monthLords = ['Sun','Moon','Mars','Mercury','Jupiter','Venus','Saturn'];
    const monthLordKn = ['α▓░α▓╡α▓┐','α▓Üα▓éα▓ªα│ìα▓░','α▓òα│üα▓£','α▓¼α│üα▓º','α▓ùα│üα▓░α│ü','α▓╢α│üα▓òα│ìα▓░','α▓╢α▓¿α▓┐'];
    final afflictedMonths = <String>[];
    for (int m = 0; m < 7; m++) {
      final mLord = monthLords[m];
      final mLon = allPLons[mLord] ?? 0.0;
      final mRashi = _rashiOf(mLon);
      bool afflicted = false;
      for (final mal in ['Sun','Mars','Saturn','Rahu','Ketu']) {
        if (mal == mLord) continue;
        final malR2 = _rashiOf(allPLons[mal] ?? 0.0);
        if (malR2 == mRashi) afflicted = true; // conjunction
        if ((malR2 + 6) % 12 == mRashi) afflicted = true; // 7th aspect
      }
      if (afflicted) afflictedMonths.add('${m+1}α▓¿α│ç α▓ñα▓┐α▓éα▓ùα▓│α│ü (${monthLordKn[m]})');
    }
    if (afflictedMonths.isNotEmpty) {
      yogas.add(Yoga(
        shloka: 'α▓«α▓╛α▓╕α▓╛α▓ºα▓┐α▓¬α▓ñα│î α▓¿α▓┐α▓¬α│Çα▓íα▓┐α▓ñα│ç α▓ñα▓ñα│ìα▓òα▓╛α▓▓α│ç α▓╕α│ìα▓░α▓╡α▓úα▓é α▓╕α▓«α▓╛α▓ªα▓┐α▓╢α│çα▓ñα│ì',
        name: 'α▓ùα▓░α│ìα▓¡α▓╕α│ìα▓░α▓╛α▓╡ α▓»α│ïα▓ù (α│ºα│ª)',
        description: 'α▓¬α│Çα▓íα▓┐α▓ñ α▓«α▓╛α▓╕α▓╛α▓ºα▓┐α▓¬α▓ñα▓┐:\n${afflictedMonths.join('\n')}',
        result: 'α▓ùα▓░α│ìα▓¡α▓╕α│ìα▓░α▓╛α▓╡ α▓╕α▓éα▓¡α▓╡',
        rashi: lagRashi,
        planets: afflictedMonths.map((s) => s.split('(').last.replaceAll(')', '')).toList(),
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 11: Comfortable pregnancy ΓòÉΓòÉΓòÉ
    // Benefics in lagna, Moon, 5,9,2,4,10 AND malefics in 3,11 AND Sun aspect
    const benHouses = {1, 2, 4, 5, 9, 10};
    const malHousesGood = {3, 11};
    final benInGood = <String>[];
    final malInGoodH = <String>[];
    for (final e in allPLons.entries) {
      final h = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
      final isBen = {'Jupiter','Venus','Mercury','Moon'}.contains(e.key);
      if (isBen && benHouses.contains(h)) benInGood.add('${_knPlanets[e.key]} ${h}α▓¿α│ç');
      if (!isBen && malHousesGood.contains(h)) malInGoodH.add('${_knPlanets[e.key]} ${h}α▓¿α│ç');
    }
    final sunAspLag = (sunR + 6) % 12 == lagRashi;
    if (benInGood.isNotEmpty && malInGoodH.isNotEmpty && sunAspLag) {
      yogas.add(Yoga(
        shloka: 'α▓╢α▓╢α▓╛α▓éα▓òα▓▓α▓ùα│ïα▓¬α▓ùα▓ñα│ê: α▓╢α│üα▓¡α▓ùα│ìα▓░α▓╣α│êα▓╕α│ìα▓ñα▓┐α▓òα│ïα▓úα▓Üα▓╛α▓»α▓╛α▓░α│ìα▓Ñα▓╕α│üα▓ûα▓╛α▓╕α│ìα▓¬α▓ªα▓╕α│ìα▓Ñα▓┐α▓ñα│êα▓â αÑñ\nα▓ñα│âα▓ñα│Çα▓»α▓▓α▓╛α▓¡α▓░α│ìα▓òα│ìα▓╖α▓ùα▓ñα│êα▓░α▓╢α│ïα▓¡α▓¿α│ê: α▓╕α│üα▓ûα│Ç α▓Ü α▓ùα▓░α│ìα▓¡α│ï α▓░α▓╡α▓┐α▓úα▓╛α▓¡α▓┐α▓╡α│Çα▓òα│ìα▓╖α▓┐α▓ñα▓â',
        name: 'α▓╕α│üα▓û α▓ùα▓░α│ìα▓¡ α▓»α│ïα▓ù (α│ºα│º)',
        description: 'α▓╢α│üα▓¡α▓░α│ü α▓╢α│üα▓¡ α▓╕α│ìα▓Ñα▓╛α▓¿: ${benInGood.join(", ")}\nα▓¬α▓╛α▓¬α▓░α│ü 3/11: ${malInGoodH.join(", ")}\nα▓░α▓╡α▓┐ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${sunAspLag ? "Γ£ô" : "Γ£ù"}',
        result: 'α▓ùα▓░α│ìα▓¡ α▓╕α│üα▓ûα▓òα▓░',
        rashi: lagRashi,
        planets: ['α▓░α▓╡α▓┐', ...benInGood.map((s) => s.split(' ').first), ...malInGoodH.map((s) => s.split(' ').first)],
      ));
    }
    // ΓòÉΓòÉΓòÉ Nisheka Shlokas 12 & 13: Gender of child ΓòÉΓòÉΓòÉ
    bool _isOddSign(int r) => r % 2 == 0; // Aries=0, Gemini=2, Leo=4...
    bool _isEvenSign(int r) => r % 2 == 1; // Taurus=1, Cancer=3...
    bool _isDualSign(int r) => r == 2 || r == 5 || r == 8 || r == 11;

    final sunOdd = _isOddSign(sunR);
    final jupOdd = _isOddSign(_rashiOf(jup));
    final jupR = _rashiOf(jup);
    final moonOdd = _isOddSign(moonR2);
    final lagOdd = _isOddSign(lagRashi);
    
    final sunEven = _isEvenSign(sunR);
    final jupEven = _isEvenSign(jupR);
    final moonEven = _isEvenSign(moonR2);
    final lagEven = _isEvenSign(lagRashi);
    
    final venR = _rashiOf(ven);
    final venEven = _isEvenSign(venR);
    final marsEven = _isEvenSign(marsR);

    final sunNavOdd = _isOddSign(_d9Rashi(sun));
    final jupNavOdd = _isOddSign(_d9Rashi(jup));
    final moonNavOdd = _isOddSign(_d9Rashi(moonLon));
    final lagNavOdd = _isOddSign(_d9Rashi(lag));
    
    final sunNavEven = _isEvenSign(_d9Rashi(sun));
    final jupNavEven = _isEvenSign(_d9Rashi(jup));
    final moonNavEven = _isEvenSign(_d9Rashi(moonLon));
    final lagNavEven = _isEvenSign(_d9Rashi(lag));

    final sunStr = isStrong('Sun');
    final jupStr = isStrong('Jupiter');
    final moonStr = isStrong('Moon');
    final lagLordStr = isStrong(rashiLords[lagRashi]);

    bool boyYoga1 = lagOdd && sunOdd && jupOdd && moonOdd && lagNavOdd && sunNavOdd && jupNavOdd && moonNavOdd && sunStr && jupStr && moonStr && lagLordStr;
    bool girlYoga1 = lagEven && sunEven && jupEven && moonEven && lagNavEven && sunNavEven && jupNavEven && moonNavEven && sunStr && jupStr && moonStr && lagLordStr;
    
    bool boyYoga2 = jupOdd && sunOdd;
    bool girlYoga2 = moonEven && venEven && marsEven;
    
    final merR = _rashiOf(mer);
    // Mercury aspect on Lagna/Moon in dual navamsha
    final lagNavR12 = _d9Rashi(lag);
    bool lagDual = _isDualSign(lagNavR12);
    bool merAspLag = (merR + 6) % 12 == lagRashi;
    bool twinsYoga1 = lagDual && merAspLag; 
    
    // Shloka 13: Saturn in odd sign (except Lagna)
    bool boyYoga3 = _isOddSign(satR2) && satR2 != lagRashi;

    if (boyYoga1 || boyYoga2 || boyYoga3) {
      final reasons = <String>[];
      if (boyYoga1) reasons.add('α▓▓α▓ùα│ìα▓¿, α▓░α▓╡α▓┐, α▓ùα│üα▓░α│ü, α▓Üα▓éα▓ªα│ìα▓░ α▓¼α│åα▓╕ α▓░α▓╛α▓╢α▓┐ & α▓¿α▓╡α▓╛α▓éα▓╢α▓ªα▓▓α│ìα▓▓α▓┐ α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐');
      if (boyYoga2) reasons.add('α▓ùα│üα▓░α│ü, α▓░α▓╡α▓┐ α▓¼α│åα▓╕ α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐');
      if (boyYoga3) reasons.add('α▓╢α▓¿α▓┐ α▓¼α│åα▓╕ α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐ (α▓▓α▓ùα│ìα▓¿ α▓╣α│èα▓░α▓ñα│üα▓¬α▓íα▓┐α▓╕α▓┐)');
      yogas.add(Yoga(
        shloka: 'α▓ôα▓£α▓░α│ìα▓òα│ìα▓╖α│ç α▓¬α│üα▓░α│üα▓╖α▓╛α▓éα▓╢α▓òα│çα▓╖α│ü α▓¼α▓▓α▓┐α▓¡α▓┐α▓░α│ìα▓▓α▓ùα│ìα▓¿α▓╛α▓░α│ìα▓òα▓ùα│üα▓░α│ìα▓╡α▓┐α▓éα▓ªα│üα▓¡α▓┐α▓â...\nα▓╡α▓┐α▓╣α▓╛α▓» α▓▓α▓ùα│ìα▓¿α▓é α▓╡α▓┐α▓╖α▓«α▓░α│ìα▓òα│ìα▓╖α▓╕α▓éα▓╕α│ìα▓Ñα▓â α▓╕α│îα▓░α│ïsα▓¬α▓┐ α▓¬α│üα▓éα▓£ α▓òα▓░α│ï α▓╡α▓┐α▓▓α▓ùα│ìα▓¿α▓╛α▓ñα│ì',
        name: 'α▓¬α│üα▓ñα│ìα▓░ α▓£α▓¿α▓¿ α▓»α│ïα▓ù (α│ºα│¿,α│ºα│⌐)',
        description: reasons.join('\n'),
        result: 'α▓ùα▓éα▓íα│ü α▓«α▓ùα│üα▓╡α▓┐α▓¿ α▓£α▓¿α▓¿',
        rashi: lagRashi,
        planets: ['α▓░α▓╡α▓┐', 'α▓ùα│üα▓░α│ü', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α▓¿α▓┐'],
      ));
    }
    
    if (girlYoga1 || girlYoga2) {
      final reasons = <String>[];
      if (girlYoga1) reasons.add('α▓▓α▓ùα│ìα▓¿, α▓░α▓╡α▓┐, α▓ùα│üα▓░α│ü, α▓Üα▓éα▓ªα│ìα▓░ α▓╕α▓« α▓░α▓╛α▓╢α▓┐ & α▓¿α▓╡α▓╛α▓éα▓╢α▓ªα▓▓α│ìα▓▓α▓┐ α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐');
      if (girlYoga2) reasons.add('α▓Üα▓éα▓ªα│ìα▓░, α▓╢α│üα▓òα│ìα▓░, α▓òα│üα▓£ α▓╕α▓« α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐');
      yogas.add(Yoga(
        shloka: 'α▓╕α▓«α▓╛α▓éα▓╢α▓╕α▓╣α▓┐α▓ñα│êα▓░α│ìα▓»α│üα▓òα│ìα▓òα│çα▓╖α│ü α▓ñα│êα▓░α│ìα▓»α│ïα▓╖α▓┐α▓ñα▓╛α▓«α│ì...',
        name: 'α▓¬α│üα▓ñα│ìα▓░α▓┐ α▓£α▓¿α▓¿ α▓»α│ïα▓ù (α│ºα│¿)',
        description: reasons.join('\n'),
        result: 'α▓╣α│åα▓úα│ìα▓úα│ü α▓«α▓ùα│üα▓╡α▓┐α▓¿ α▓£α▓¿α▓¿',
        rashi: lagRashi,
        planets: ['α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α│üα▓òα│ìα▓░', 'α▓òα│üα▓£'],
      ));
    }

    if (twinsYoga1) {
      yogas.add(Yoga(
        shloka: 'α▓ªα│ìα▓╡α▓éα▓╢α▓╕α│ìα▓Ñα▓╛ α▓¼α│üα▓ºα▓╡α│Çα▓òα│ìα▓╖α▓úα▓╛α▓Ü α▓»α▓«α▓▓α▓é α▓òα│üα▓░α│ìα▓╡α▓éα▓ñα▓┐ α▓¬α▓òα│ìα▓╖α│ç α▓╕α▓òα│ç',
        name: 'α▓àα▓╡α▓│α▓┐ α▓£α▓¿α▓¿ α▓»α│ïα▓ù (α│ºα│¿)',
        description: 'α▓▓α▓ùα│ìα▓¿ α▓¿α▓╡α▓╛α▓éα▓╢ α▓ªα│ìα▓╡α▓┐α▓╕α│ìα▓╡α▓¡α▓╛α▓╡ (${_rashiNames[lagNavR12]}) + α▓¼α│üα▓ºα▓¿ α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
        result: 'α▓àα▓╡α▓│α▓┐ α▓«α▓òα│ìα▓òα▓│ α▓£α▓¿α▓¿',
        rashi: lagRashi,
        planets: ['α▓¼α│üα▓º'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 14: Napumsaka (Eunuch) Yoga ΓòÉΓòÉΓòÉ
    bool napumsaka1 = (sunR + 6) % 12 == moonR2 || (moonR2 + 6) % 12 == sunR;
    bool napumsaka2 = (satR2 + 6) % 12 == merR || (merR + 6) % 12 == satR2;
    bool marsAspSun14 = (marsR + 6) % 12 == sunR || (marsR + 3) % 12 == sunR || (marsR + 7) % 12 == sunR;
    bool napumsaka3 = sunEven && marsAspSun14 && moonOdd && lagOdd;
    final venNavOdd = _isOddSign(_d9Rashi(ven));
    bool napumsaka4 = moonNavOdd && lagNavOdd && venNavOdd;
    
    if (napumsaka1 || napumsaka2 || napumsaka3 || napumsaka4) {
      final reasons = <String>[];
      if (napumsaka1) reasons.add('α▓░α▓╡α▓┐ α▓«α▓ñα│ìα▓ñα│ü α▓Üα▓éα▓ªα│ìα▓░α▓░ α▓¬α▓░α▓╕α│ìα▓¬α▓░ α▓ªα│âα▓╖α│ìα▓ƒα▓┐');
      if (napumsaka2) reasons.add('α▓╢α▓¿α▓┐ α▓«α▓ñα│ìα▓ñα│ü α▓¼α│üα▓ºα▓░ α▓¬α▓░α▓╕α│ìα▓¬α▓░ α▓ªα│âα▓╖α│ìα▓ƒα▓┐');
      if (napumsaka3) reasons.add('α▓╕α▓« α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐ α▓░α▓╡α▓┐ + α▓òα│üα▓£α▓¿ α▓ªα│âα▓╖α│ìα▓ƒα▓┐, α▓Üα▓éα▓ªα│ìα▓░ α▓«α▓ñα│ìα▓ñα│ü α▓▓α▓ùα│ìα▓¿ α▓¼α│åα▓╕ α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐');
      if (napumsaka4) reasons.add('α▓Üα▓éα▓ªα│ìα▓░, α▓▓α▓ùα│ìα▓¿, α▓╢α│üα▓òα│ìα▓░ α▓¬α│üα▓░α│üα▓╖ (α▓¼α│åα▓╕) α▓¿α▓╡α▓╛α▓éα▓╢α▓ªα▓▓α│ìα▓▓α▓┐');
      yogas.add(Yoga(
        shloka: 'α▓àα▓¿α│ìα▓¿α│ï α▓¿α│ìα▓»α▓é α▓»α▓ªα▓┐ α▓¬α▓╢α│ìα▓»α▓ñα▓â α▓╢α▓╢α▓┐α▓░α▓╡α│Ç α▓»α▓ªα│ìα▓╡α▓╛α▓░α│ìα▓òα▓┐α▓╕α│îα▓«α│ìα▓» α▓ñα▓Ñα▓╛...',
        name: 'α▓òα│ìα▓▓α│Çα▓¼ (α▓¿α▓¬α│üα▓éα▓╕α▓ò) α▓»α│ïα▓ù (α│ºα│¬)',
        description: reasons.join('\n'),
        result: 'α▓¿α▓¬α│üα▓éα▓╕α▓ò α▓£α▓¿α▓¿',
        rashi: lagRashi,
        planets: ['α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α▓¿α▓┐', 'α▓¼α│üα▓º', 'α▓òα│üα▓£', 'α▓╢α│üα▓òα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 15: Twins Yoga 2 ΓòÉΓòÉΓòÉ
    final merOdd = _isOddSign(merR);
    final marsOdd = _isOddSign(marsR);
    bool twins15a = moonEven && venEven && sunOdd && merOdd && marsOdd && jupOdd && lagOdd;
    
    bool maleAspLagMoon = false;
    for (int r in [lagRashi, moonR2]) {
      if ((sunR + 6) % 12 == r || 
          (marsR + 6) % 12 == r || (marsR + 3) % 12 == r || (marsR + 7) % 12 == r ||
          (jupR + 6) % 12 == r || (jupR + 4) % 12 == r || (jupR + 8) % 12 == r) {
        maleAspLagMoon = true;
      }
    }
    bool twins15b = lagEven && moonEven && maleAspLagMoon;
    
    if (twins15a || twins15b) {
      final reasons = <String>[];
      if (twins15a) reasons.add('α▓Üα▓éα▓ªα│ìα▓░, α▓╢α│üα▓òα│ìα▓░ α▓╕α▓« α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐; α▓░α▓╡α▓┐, α▓¼α│üα▓º, α▓òα│üα▓£, α▓ùα│üα▓░α│ü, α▓▓α▓ùα│ìα▓¿ α▓¼α│åα▓╕ α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐');
      if (twins15b) reasons.add('α▓▓α▓ùα│ìα▓¿ α▓«α▓ñα│ìα▓ñα│ü α▓Üα▓éα▓ªα│ìα▓░ α▓╕α▓« α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐ + α▓¬α│üα▓░α│üα▓╖ α▓ùα│ìα▓░α▓╣α▓░ α▓ªα│âα▓╖α│ìα▓ƒα▓┐');
      yogas.add(Yoga(
        shloka: 'α▓»α│üα▓ùα│ìα▓░α│ç α▓Üα▓éα▓ªα│ìα▓░α▓╕α▓┐α▓ñα▓╛α▓╡α▓½α│îα▓£α▓¡α▓╡α▓¿α│ç α▓╕α│üα▓░α│ìα▓£α│ìα▓₧α▓╛α▓░α▓£α│Çα▓╡α│ïα▓ªα▓»α▓╛...',
        name: 'α▓àα▓╡α▓│α▓┐ α▓£α▓¿α▓¿ α▓»α│ïα▓ù (α│ºα│½)',
        description: reasons.join('\n'),
        result: 'α▓àα▓╡α▓│α▓┐ α▓«α▓òα│ìα▓òα▓│ α▓£α▓¿α▓¿',
        rashi: lagRashi,
        planets: ['α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α│üα▓òα│ìα▓░', 'α▓░α▓╡α▓┐', 'α▓¼α│üα▓º', 'α▓òα│üα▓£', 'α▓ùα│üα▓░α│ü'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 16: Multiple births & Month Lords ΓòÉΓòÉΓòÉ
    final merAspLag16 = (merR + 6) % 12 == lagRashi;
    final satAspLag16 = (satR2 + 6) % 12 == lagRashi || (satR2 + 2) % 12 == lagRashi || (satR2 + 9) % 12 == lagRashi;
    if (lagRashi == 8 && merAspLag16 && satAspLag16) {
      yogas.add(Yoga(
        shloka: 'α▓ºα▓¿α│üα▓░α│ìα▓ºα▓░α▓╕α│ìα▓»α▓╛α▓éα▓ñα│ìα▓»α▓ùα▓ñα│ç α▓╡α▓┐α▓▓α▓¿α│ìα▓¿α│ç α▓ùα│ìα▓░α▓╣α│êα▓╕α│ìα▓ñα▓ªα▓éα▓╢α│ïα▓¬α▓ùα▓ñα│êα▓░α│ìα▓¼α▓▓α▓┐α▓â...',
        name: 'α▓¼α▓╣α│ü α▓╕α▓éα▓ñα▓╛α▓¿ α▓»α│ïα▓ù (α│ºα│¼)',
        description: 'α▓ºα▓¿α│üα▓╕α│ìα▓╕α│ü α▓▓α▓ùα│ìα▓¿ + α▓╢α▓¿α▓┐ α▓«α▓ñα│ìα▓ñα│ü α▓¼α│üα▓ºα▓░ α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
        result: 'α▓àα▓¿α│çα▓ò α▓«α▓òα│ìα▓òα▓│ α▓£α▓¿α▓¿',
        rashi: 8,
        planets: ['α▓╢α▓¿α▓┐', 'α▓¼α│üα▓º'],
      ));
    }

    // Month lords logic:
    // 1-Venus, 2-Mars, 3-Jupiter, 4-Sun, 5-Moon, 6-Saturn, 7-Mercury, 8-Lagna Lord, 9-Moon, 10-Sun
    final monthLords16 = [
      'Venus', 'Mars', 'Jupiter', 'Sun', 'Moon', 'Saturn', 'Mercury', rashiLords[lagRashi], 'Moon', 'Sun'
    ];
    final monthLordsKn16 = [
      'α▓╢α│üα▓òα│ìα▓░', 'α▓òα│üα▓£', 'α▓ùα│üα▓░α│ü', 'α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α▓¿α▓┐', 'α▓¼α│üα▓º', _knPlanets[rashiLords[lagRashi]]!, 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓░α▓╡α▓┐'
    ];
    
    final monthDetails = <String>[];
    for (int m = 0; m < 10; m++) {
      final mLord = monthLords16[m];
      final mLordNameKn = monthLordsKn16[m];
      final mLon = allPLons[mLord] ?? 0.0;
      final mR = _rashiOf(mLon);
      
      bool afflicted = false;
      for (final mal in ['Sun','Mars','Saturn','Rahu','Ketu']) {
        if (mal == mLord) continue;
        final malR2 = _rashiOf(allPLons[mal] ?? 0.0);
        if (malR2 == mR) afflicted = true; // conjunction
        if ((malR2 + 6) % 12 == mR) afflicted = true; // 7th aspect
        if (mal == 'Mars' && ((malR2 + 3) % 12 == mR || (malR2 + 7) % 12 == mR)) afflicted = true;
        if (mal == 'Saturn' && ((malR2 + 2) % 12 == mR || (malR2 + 9) % 12 == mR)) afflicted = true;
      }
      
      bool isGood = !afflicted && isStrong(mLord);
      monthDetails.add('${m+1}α▓¿α│ç α▓ñα▓┐α▓éα▓ùα▓│α│ü ($mLordNameKn): ${afflicted ? "α▓àα▓╢α│üα▓¡ (α▓¬α│Çα▓íα▓┐α▓ñ)" : isGood ? "α▓╢α│üα▓¡ (α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐)" : "α▓╕α▓╛α▓«α▓╛α▓¿α│ìα▓»"}');
    }
    
    yogas.add(Yoga(
      shloka: 'α▓òα▓▓α▓▓α▓ÿα▓¿α▓╛α▓éα▓òα│üα▓░α▓╛α▓╕α│ìα▓Ñα▓┐α▓Üα▓░α│ìα▓«α▓╛α▓éα▓ùα▓£α▓Üα│çα▓ñα▓¿α▓ªα▓╛α▓â α▓╕α▓┐α▓ñα▓òα│üα▓£α▓£α│Çα▓╡α▓╕α│éα▓░α│ìα▓»α▓Üα▓éα▓ªα│ìα▓░α▓╛α▓░α│ìα▓òα▓┐α▓¼α│üα▓ºα▓╛α▓â...',
      name: 'α▓ùα▓░α│ìα▓¡ α▓«α▓╛α▓╕α▓╛α▓ºα▓┐α▓¬α▓ñα▓┐ α▓½α▓▓ (α│ºα│¼)',
      description: monthDetails.join('\n'),
      result: 'α▓«α▓╛α▓╕α▓╛α▓ºα▓┐α▓¬α▓ñα▓┐α▓ùα▓│ α▓¼α▓▓α▓╛α▓¼α▓▓α▓ªα▓éα▓ñα│å α▓ùα▓░α│ìα▓¡α▓╕α│ìα▓Ñα▓┐α▓ñα▓┐',
      rashi: lagRashi,
      planets: monthLordsKn16.toSet().toList(),
    ));

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 17: Double limbs & Mute child ΓòÉΓòÉΓòÉ
    final trik1 = (lagRashi + 4) % 12;
    final trik2 = (lagRashi + 8) % 12;
    final weakMalInTrikona = <String>[];
    for (final e in malLons.entries) {
      final r = _rashiOf(e.value);
      if ((r == lagRashi || r == trik1 || r == trik2) && isWeak(e.key)) {
        weakMalInTrikona.add(_knPlanets[e.key]!);
      }
    }
    if (weakMalInTrikona.isNotEmpty) {
      yogas.add(Yoga(
        shloka: 'α▓ñα│ìα▓░α▓┐α▓òα│ïα▓úα▓ùα│ç α▓╡α▓┐α▓¼α▓▓α│êα▓╕α│ìα▓ñα▓ñα│ïsα▓¬α▓░α│êα▓░α│ìα▓«α│üα▓ûα▓╛α▓éα▓½α│ìα▓░α▓┐α▓╣α▓╕α│èα▓░α│ìα▓ªα│ìα▓╡α▓┐α▓ùα│üα▓úα▓╕α│ìα▓ñα▓ªα▓╛ α▓¡α▓╡α│çα▓ñα│ì',
        name: 'α▓ªα│ìα▓╡α▓┐α▓ùα│üα▓ú α▓àα▓éα▓ù α▓»α│ïα▓ù (α│ºα│¡)',
        description: 'α▓ªα│üα▓░α│ìα▓¼α▓▓ α▓¬α▓╛α▓¬α▓░α│ü α▓ñα│ìα▓░α▓┐α▓òα│ïα▓úα▓ªα▓▓α│ìα▓▓α▓┐: ${weakMalInTrikona.join(", ")}',
        result: 'α▓╢α▓┐α▓╢α│üα▓╡α▓┐α▓ùα│å α▓Äα▓░α▓íα│ü α▓«α│üα▓û/α▓òα│ê/α▓òα▓╛α▓▓α│ü',
        rashi: lagRashi,
        planets: weakMalInTrikona,
      ));
    }
    if (moonR2 == 1) {
      bool malAspM17 = false;
      for (final e in malLons.entries) {
        if ((_rashiOf(e.value) + 6) % 12 == 1) malAspM17 = true;
      }
      bool benAspM17 = false;
      for (final e in allPLons.entries) {
        if ({'Jupiter','Venus','Mercury'}.contains(e.key) && (_rashiOf(e.value) + 6) % 12 == 1) benAspM17 = true;
      }
      if (malAspM17) {
        yogas.add(Yoga(
          shloka: 'α▓àα▓╡α▓╛α▓ùα│ìα▓ùα▓╡α│Çα▓éα▓ªα▓╛α▓╡α▓╢α│üα▓¡α│êα▓░α│ìα▓¡α▓╕α▓éα▓ºα▓┐α▓ùα│ê: α▓╢α│üα▓¡α│çα▓òα│ìα▓╖α▓┐α▓ñα│ç α▓Üα│çα▓ñα│ìα▓òα│üα▓░α│üα▓ñα│ç α▓ùα▓┐α▓░α▓é α▓Üα▓┐α▓░α▓╛α▓ñα│ì',
          name: 'α▓«α│éα▓ò/α▓╡α▓┐α▓│α▓éα▓¼ α▓╡α▓╛α▓òα│ì α▓»α│ïα▓ù (α│ºα│¡)',
          description: 'α▓Üα▓éα▓ªα│ìα▓░ α▓╡α│âα▓╖α▓¡α▓ªα▓▓α│ìα▓▓α▓┐ + α▓¬α▓╛α▓¬ α▓ªα│âα▓╖α│ìα▓ƒα▓┐\nα▓╢α│üα▓¡ α▓ªα│âα▓╖α│ìα▓ƒα▓┐: ${benAspM17 ? "α▓çα▓ªα│å ΓåÆ α▓ñα▓íα▓╡α▓╛α▓ùα▓┐ α▓«α▓╛α▓ñα│ü" : "α▓çα▓▓α│ìα▓▓ ΓåÆ α▓«α│éα▓ù"}',
          result: benAspM17 ? 'α▓ñα▓íα▓╡α▓╛α▓ùα▓┐ α▓«α▓╛α▓ñα▓¿α▓╛α▓íα│üα▓ñα│ìα▓ñα▓╛α▓¿α│å' : 'α▓«α│éα▓òα▓ñα│ìα▓╡',
          rashi: 1,
          planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
        ));
      }
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 18: Teeth/Hunchback/Lame/Dull ΓòÉΓòÉΓòÉ
    final satNavR18 = _d9Rashi(sat);
    final marsNavR18 = _d9Rashi(mars);
    final merNavR18 = _d9Rashi(mer);
    final mercurySigns18 = {2, 5}; // Gemini, Virgo = Mercury-ruled signs
    if (mercurySigns18.contains(satNavR18) && mercurySigns18.contains(marsNavR18)) {
      yogas.add(Yoga(
        shloka: 'α▓╕α│îα▓«α│ìα▓»α▓░α│ìα▓òα│ìα▓╖α▓╛α▓éα▓╢α│ç α▓░α▓╡α▓┐α▓£α▓░α│üα▓ºα▓┐α▓░α│î α▓Üα│çα▓ñα│ìα▓╕α▓ªα▓éα▓ñα│ïsα▓ñα│ìα▓░ α▓£α▓╛α▓ñα▓â',
        name: 'α▓╕α▓ªα▓éα▓ñ α▓£α▓¿α▓¿ α▓»α│ïα▓ù (α│ºα│«)',
        description: 'α▓╢α▓¿α▓┐ α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[satNavR18]} α▓«α▓ñα│ìα▓ñα│ü α▓òα│üα▓£ α▓¿α▓╡α▓╛α▓éα▓╢: ${_rashiNames[marsNavR18]} (α▓¼α│üα▓º α▓òα│ìα▓╖α│çα▓ñα│ìα▓░)',
        result: 'α▓╣α▓▓α│ìα▓▓α│üα▓ùα▓│α│èα▓éα▓ªα▓┐α▓ùα│å α▓£α▓¿α▓¿',
        rashi: lagRashi,
        planets: ['α▓╢α▓¿α▓┐', 'α▓òα│üα▓£', 'α▓¼α│üα▓º'],
      ));
    }
    if (lagRashi == 3 && moonR2 == 3) {
      final sAC = (satR2 + 6) % 12 == 3 || (satR2 + 2) % 12 == 3 || (satR2 + 9) % 12 == 3;
      final mAC = (marsR + 6) % 12 == 3 || (marsR + 3) % 12 == 3 || (marsR + 7) % 12 == 3;
      if (sAC && mAC) {
        yogas.add(Yoga(
          shloka: 'α▓òα│üα▓¼α│ìα▓¼α▓â α▓╕α│ìα▓╡α▓░α│ìα▓òα│ìα▓╖α│å α▓╢α▓╢α▓┐α▓¿α▓┐ α▓ñα▓¿α│üα▓ùα│ç α▓«α▓éα▓ªα▓«α▓╛α▓╣α│çα▓»α▓ªα│âα▓╖α│ìα▓ƒα│ç',
          name: 'α▓òα│üα▓¼α│ìα▓£ α▓»α│ïα▓ù (α│ºα│«)',
          description: 'α▓òα▓ƒα▓ò α▓▓α▓ùα│ìα▓¿ + α▓Üα▓éα▓ªα│ìα▓░ α▓▓α▓ùα│ìα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ + α▓╢α▓¿α▓┐ α▓òα│üα▓£ α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
          result: 'α▓¼α│åα▓¿α│ìα▓¿α│ü α▓¼α▓ùα│ìα▓ùα▓┐α▓░α│üα▓╡ α▓╢α▓┐α▓╢α│ü',
          rashi: 3, planets: ['α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α▓¿α▓┐', 'α▓òα│üα▓£'],
        ));
      }
    }
    if (lagRashi == 11) {
      final sAP = (satR2 + 6) % 12 == 11 || (satR2 + 2) % 12 == 11 || (satR2 + 9) % 12 == 11;
      final mAP = (marsR + 6) % 12 == 11 || (marsR + 3) % 12 == 11 || (marsR + 7) % 12 == 11;
      final moAP = (moonR2 + 6) % 12 == 11;
      if (sAP && mAP && moAP) {
        yogas.add(Yoga(
          shloka: 'α▓¬α▓éα▓ùα│üα▓░α│ìα▓«α│Çα▓¿α│ç α▓»α▓«α▓╢α▓╢α▓┐α▓òα│üα▓£α│êα▓░α│ìα▓╡α│Çα▓òα│ìα▓╖α▓┐α▓ñα│ç α▓▓α▓ùα│ìα▓¿α▓╕α▓éα▓╕α│ìα▓Ñα│å',
          name: 'α▓¬α▓éα▓ùα│ü α▓»α│ïα▓ù (α│ºα│«)',
          description: 'α▓«α│Çα▓¿ α▓▓α▓ùα│ìα▓¿ + α▓╢α▓¿α▓┐, α▓Üα▓éα▓ªα│ìα▓░, α▓òα│üα▓£ α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
          result: 'α▓òα│üα▓éα▓ƒ α▓╢α▓┐α▓╢α│ü',
          rashi: 11, planets: ['α▓╢α▓¿α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£'],
        ));
      }
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 19: Dwarf & Missing limbs ΓòÉΓòÉΓòÉ
    if (lagRashi == 9 || lagRashi == 10) { // Makara (Capricorn) or Kumbha (Aquarius)
      final sACap = satR2 == 9 || (satR2 + 6) % 12 == 9 || (satR2 + 2) % 12 == 9 || (satR2 + 9) % 12 == 9;
      final moACap = moonR2 == 9 || (moonR2 + 6) % 12 == 9;
      final suACap = sunR == 9 || (sunR + 6) % 12 == 9;
      if (sACap && moACap && suACap) {
        yogas.add(Yoga(
          shloka: 'α▓╕α│îα▓░α▓╢α▓╢α▓╛α▓éα▓òα▓ªα▓┐α▓╡α▓╛α▓òα▓░α▓ªα│âα▓╖α│ìα▓ƒα│ç α▓╡α▓╛α▓«α▓¿α▓òα│ï α▓«α▓òα▓░α▓╛α▓éα▓ñα│ìα▓»α▓╡α▓┐α▓▓α▓ùα│ìα▓¿',
          name: 'α▓╡α▓╛α▓«α▓¿ α▓»α│ïα▓ù (α│ºα│»)',
          description: 'α▓«α▓òα▓░ α▓▓α▓ùα│ìα▓¿ + α▓╢α▓¿α▓┐, α▓Üα▓éα▓ªα│ìα▓░, α▓░α▓╡α▓┐ α▓ªα│âα▓╖α│ìα▓ƒα▓┐/α▓╕α│ìα▓Ñα▓┐α▓ñα▓┐',
          result: 'α▓òα│üα▓│α│ìα▓│ α▓╢α▓┐α▓╢α│ü',
          rashi: 9, planets: ['α▓╢α▓¿α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓░α▓╡α▓┐'],
        ));
      }
    }
    final malIn159 = <String>[];
    for (final e in malLons.entries) {
      final hFL = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
      if (hFL == 1) malIn159.add('${_knPlanets[e.key]} 1α▓¿α│ç (α▓ñα▓▓α│å)');
      if (hFL == 5) malIn159.add('${_knPlanets[e.key]} 5α▓¿α│ç (α▓òα│êα▓ùα▓│α│ü)');
      if (hFL == 9) malIn159.add('${_knPlanets[e.key]} 9α▓¿α│ç (α▓òα▓╛α▓▓α│üα▓ùα▓│α│ü)');
    }
    if (malIn159.length >= 2) {
      yogas.add(Yoga(
        shloka: 'α▓ºα│Çα▓¿α▓╡α▓«α│ïα▓ªα▓»α▓ùα│êα▓╢α│ìα▓Ü α▓ªα│âα▓ùα▓╛α▓úα│ê: α▓¬α▓╛α▓¬α▓»α│üα▓ñα│êα▓░α▓¡α│üα▓£α▓╛α▓éα▓ÿα▓┐α▓╢α▓┐α▓░α▓╛α▓â α▓╕α│ìα▓»α▓╛α▓ñα│ì',
        name: 'α▓àα▓éα▓ùα▓╣α│Çα▓¿ α▓»α│ïα▓ù (α│ºα│»)',
        description: 'α▓¬α▓╛α▓¬α▓░α│ü 1/5/9:\n${malIn159.join("\n")}',
        result: 'α▓àα▓éα▓ùα▓╣α│Çα▓¿ α▓╢α▓┐α▓╢α│ü',
        rashi: lagRashi,
        planets: malIn159.map((s) => s.split(' ').first).toList(),
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 20: Blindness & Eye defects ΓòÉΓòÉΓòÉ
    if (lagRashi == 4 && sunR == 4 && moonR2 == 4) {
      final mAL = (marsR + 6) % 12 == 4 || (marsR + 3) % 12 == 4 || (marsR + 7) % 12 == 4;
      final sAL = (satR2 + 6) % 12 == 4 || (satR2 + 2) % 12 == 4 || (satR2 + 9) % 12 == 4;
      if (mAL && sAL) {
        yogas.add(Yoga(
          shloka: 'α▓░α▓╡α▓┐α▓╢α▓╢α▓┐α▓»α│üα▓ñα│ç α▓╕α▓┐α▓éα▓╣α│ç α▓▓α▓ùα│ìα▓¿ α▓òα│üα▓£α▓╛α▓░α│ìα▓òα▓┐α▓¿α▓┐α▓░α│Çα▓òα│ìα▓╖α▓┐α▓ñα│ç α▓¿α▓»α▓¿α▓░α▓╣α▓┐α▓ñα▓â',
          name: 'α▓àα▓éα▓ºα▓ñα│ìα▓╡ α▓»α│ïα▓ù (α│¿α│ª)',
          description: 'α▓╕α▓┐α▓éα▓╣ α▓▓α▓ùα│ìα▓¿ + α▓░α▓╡α▓┐,α▓Üα▓éα▓ªα│ìα▓░ α▓▓α▓ùα│ìα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ + α▓òα│üα▓£,α▓╢α▓¿α▓┐ α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
          result: 'α▓╢α▓┐α▓╢α│ü α▓òα│üα▓░α│üα▓í',
          rashi: 4, planets: ['α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£', 'α▓╢α▓¿α▓┐'],
        ));
      }
    }
    final moIn12 = ((moonR2 - lagRashi) % 12) + 1 == 12;
    final suIn12 = ((sunR - lagRashi) % 12) + 1 == 12;
    if (moIn12 || suIn12) {
      yogas.add(Yoga(
        shloka: 'α▓╡α│ìα▓»α▓»α▓ùα│âα▓╣α▓ùα▓ñα▓╢α│ìα▓Üα▓éα▓ªα│ìα▓░α│ï α▓╡α▓╛α▓«α▓é α▓Æα▓¿α▓╕α│ìα▓ñα│ìα▓░α▓¬α▓░α▓é α▓░α▓╡α▓┐',
        name: 'α▓¿α│çα▓ñα│ìα▓░ α▓ªα│ïα▓╖ α▓»α│ïα▓ù (α│¿α│ª)',
        description: '${moIn12 ? "α▓Üα▓éα▓ªα│ìα▓░ 12α▓¿α│ç ΓåÆ α▓Äα▓íα▓ùα▓úα│ìα▓úα│ü" : ""}${(moIn12 && suIn12) ? "\n" : ""}${suIn12 ? "α▓░α▓╡α▓┐ 12α▓¿α│ç ΓåÆ α▓¼α▓▓α▓ùα▓úα│ìα▓úα│ü" : ""}',
        result: '${moIn12 ? "α▓Äα▓í" : ""}${(moIn12 && suIn12) ? "/" : ""}${suIn12 ? "α▓¼α▓▓" : ""}α▓ùα▓úα│ìα▓úα│ü α▓ªα│ïα▓╖',
        rashi: lagRashi,
        planets: [if (moIn12) 'α▓Üα▓éα▓ªα│ìα▓░', if (suIn12) 'α▓░α▓╡α▓┐'],
      ));
    }

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 21: Birth timing from Dwadashamsha ΓòÉΓòÉΓòÉ
    final moonD12 = ((moonLon % 30) / 2.5).floor();
    final d12Rashi = (moonR2 + moonD12) % 12;
    yogas.add(Yoga(
      shloka: 'α▓ñα▓ñα│ìα▓òα▓╛α▓▓ α▓çα▓éα▓ªα│üα▓╕α▓╣α▓┐α▓ñα│ï α▓ªα│ìα▓╡α▓┐α▓░α▓╕α▓╛α▓éα▓╢α▓òα│ï α▓»α▓╕α│ìα▓ñα▓ñα│ìα▓ñα│üα▓▓α│ìα▓»α▓░α▓╛α▓╢α▓┐α▓╕α▓╣α▓┐α▓ñα│ç α▓¬α│üα▓░α▓ñα▓â α▓╢α▓╢α▓╛α▓éα▓òα│ç',
      name: 'α▓£α▓¿α▓¿ α▓òα▓╛α▓▓ α▓¿α▓┐α▓░α│ìα▓úα▓» (α│¿α│º)',
      description: 'α▓ùα▓░α│ìα▓¡α▓ºα▓╛α▓░α▓úα│å α▓Üα▓éα▓ªα│ìα▓░ α▓ªα│ìα▓╡α▓╛α▓ªα▓╢α▓╛α▓éα▓╢: ${_rashiNames[d12Rashi]}\nα▓Üα▓éα▓ªα│ìα▓░ α▓ê α▓░α▓╛α▓╢α▓┐α▓ùα│å α▓¼α▓éα▓ªα▓╛α▓ù α▓£α▓¿α▓¿',
      result: 'α▓£α▓¿α▓¿: α▓Üα▓éα▓ªα│ìα▓░ ${_rashiNames[d12Rashi]} α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐α▓░α│üα▓╡α▓╛α▓ù',
      rashi: d12Rashi, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
    ));

    // ΓòÉΓòÉΓòÉ Nisheka Shloka 22: Delayed birth ΓòÉΓòÉΓòÉ
    final satNav22 = _d9Rashi(sat);
    final satIn7th = ((satR2 - lagRashi) % 12) + 1 == 7;
    if (satNav22 == lagRashi && satIn7th) {
      yogas.add(Yoga(
        shloka: 'α▓ëα▓ªα▓»α▓ñα▓┐ α▓«α│âα▓ªα│üα▓¡α▓╛α▓éα▓╢α│ç α▓╕α▓¬α│ìα▓ñα▓«α▓╕α│ç α▓Ü α▓«α▓éα▓ªα│ç α▓»α▓ªα▓┐ α▓¡α▓╡α▓ñα▓┐ α▓¿α▓┐α▓╖α│çα▓òα▓â α▓╕α│éα▓ñα▓┐α▓░α▓¼α▓ñα│ìα▓░α▓»α│çα▓ú',
        name: 'α▓╡α▓┐α▓│α▓éα▓¼ α▓£α▓¿α▓¿ α▓»α│ïα▓ù - α▓╢α▓¿α▓┐ (α│¿α│¿)',
        description: 'α▓╢α▓¿α▓┐ α▓¿α▓╡α▓╛α▓éα▓╢ α▓▓α▓ùα│ìα▓¿α▓╡α▓╛α▓ùα▓┐α▓ªα│ìα▓ªα│ü α▓╢α▓¿α▓┐ 7α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐',
        result: 'α▓«α│éα▓░α│ü α▓╡α▓░α│ìα▓╖α▓ùα▓│ α▓¿α▓éα▓ñα▓░ α▓£α▓¿α▓¿',
        rashi: lagRashi, planets: ['α▓╢α▓¿α▓┐'],
      ));
    }
    final moonNav22 = _d9Rashi(moonLon);
    final moonIn7th = ((moonR2 - lagRashi) % 12) + 1 == 7;
    if (moonNav22 == lagRashi && moonIn7th) {
      yogas.add(Yoga(
        shloka: 'α▓╢α▓╢α▓┐α▓¿α▓┐ α▓ñα│ü α▓╡α▓┐α▓ºα▓┐α▓░α│çα▓╡α▓é α▓ªα│ìα▓╡α▓╛α▓ªα▓╢α▓╛α▓ªα│ìα▓ªα│ç α▓¬α│ìα▓░α▓òα│üα▓░α│ìα▓»α▓╛α▓ñα│ì',
        name: 'α▓╡α▓┐α▓│α▓éα▓¼ α▓£α▓¿α▓¿ α▓»α│ïα▓ù - α▓Üα▓éα▓ªα│ìα▓░ (α│¿α│¿)',
        description: 'α▓Üα▓éα▓ªα│ìα▓░ α▓¿α▓╡α▓╛α▓éα▓╢ α▓▓α▓ùα│ìα▓¿α▓╡α▓╛α▓ùα▓┐α▓ªα│ìα▓ªα│ü α▓Üα▓éα▓ªα│ìα▓░ 7α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐',
        result: 'α▓╣α▓¿α│ìα▓¿α│åα▓░α▓íα│ü α▓╡α▓░α│ìα▓╖α▓ùα▓│ α▓¿α▓éα▓ñα▓░ α▓£α▓¿α▓¿',
        rashi: lagRashi, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // Chapter 5: α▓£α▓¿α│ìα▓«α▓òα▓╛α▓▓α▓▓α▓òα│ìα▓╖α▓úα▓╛α▓ºα│ìα▓»α▓╛α▓» (Birth-time indicators)
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

    // ΓòÉΓòÉΓòÉ JK Shloka 1: Father absent at birth ΓòÉΓòÉΓòÉ
    final jk1MoonAspLag = (moonR2 + 6) % 12 == lagRashi;
    final jk1IsChara = lagRashi == 0 || lagRashi == 3 || lagRashi == 6 || lagRashi == 9;
    final jk1SunH = ((sunR - lagRashi) % 12) + 1;
    final jk1SatInLag = satR2 == lagRashi;
    final jk1MarsIn7 = ((marsR - lagRashi) % 12) + 1 == 7;
    final jk1MerR = _rashiOf(mer);
    final jk1VenR = _rashiOf(ven);
    final jk1MoonBtw = (moonR2 > jk1MerR && moonR2 < jk1VenR) || (moonR2 > jk1VenR && moonR2 < jk1MerR);
    if (!jk1MoonAspLag || (jk1SatInLag && jk1MarsIn7) || jk1MoonBtw) {
      final reasons = <String>[];
      if (!jk1MoonAspLag) reasons.add('α▓Üα▓éα▓ªα│ìα▓░ α▓▓α▓ùα│ìα▓¿ α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓çα▓▓α│ìα▓▓');
      if (jk1IsChara) reasons.add('α▓Üα▓░ α▓▓α▓ùα│ìα▓¿ ΓåÆ α▓ñα▓éα▓ªα│å α▓╡α▓┐α▓ªα│çα▓╢');
      if (jk1SunH >= 8 && jk1SunH <= 12) reasons.add('α▓░α▓╡α▓┐ ${jk1SunH}α▓¿α│ç α▓«α▓¿α│å ΓåÆ α▓ñα▓éα▓ªα│å α▓èα▓░α▓┐α▓¿α▓▓α│ìα▓▓α▓┐ α▓¼α│çα▓░α│åα▓íα│å');
      if (jk1SatInLag && jk1MarsIn7) reasons.add('α▓╢α▓¿α▓┐ α▓▓α▓ùα│ìα▓¿ + α▓òα│üα▓£ 7α▓¿α│ç');
      if (jk1MoonBtw) reasons.add('α▓Üα▓éα▓ªα│ìα▓░ α▓¼α│üα▓º-α▓╢α│üα▓òα│ìα▓░α▓░ α▓«α▓ºα│ìα▓»α│å');
      yogas.add(Yoga(
        shloka: 'α▓¬α▓┐α▓ñα│üα▓░α│ìα▓£α▓╛α▓ñα▓â α▓¬α▓░α│ïα▓òα│ìα▓╖α▓╕α│ìα▓» α▓▓α▓ùα│ìα▓¿α▓«α▓┐α▓éα▓ªα▓╛α▓╡α▓¬α▓╢α│ìα▓»α▓ñα▓┐',
        name: 'α▓¬α▓┐α▓ñα│â α▓¬α▓░α│ïα▓òα│ìα▓╖ α▓»α│ïα▓ù (α▓£α▓ò α│º)',
        description: reasons.join('\n'),
        result: 'α▓ñα▓éα▓ªα│å α▓¬α▓░α│ïα▓òα│ìα▓╖α▓ªα▓▓α│ìα▓▓α▓┐α▓░α│üα▓╡α▓╛α▓ù α▓£α▓¿α▓¿',
        rashi: lagRashi, planets: ['α▓Üα▓éα▓ªα│ìα▓░', 'α▓░α▓╡α▓┐'],
      ));
    }

    // ΓòÉΓòÉΓòÉ JK Shloka 2: Born with snake ΓòÉΓòÉΓòÉ
    final jk2ScorpDrek = lagRashi == 7 || moonR2 == 7;
    final jk2BenIn2or11 = <String>[];
    for (final e in allPLons.entries) {
      if ({'Jupiter','Venus','Mercury','Moon'}.contains(e.key)) {
        final h = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
        if (h == 2 || h == 11) jk2BenIn2or11.add(_knPlanets[e.key]!);
      }
    }
    if (jk2ScorpDrek && jk2BenIn2or11.isNotEmpty) {
      yogas.add(Yoga(
