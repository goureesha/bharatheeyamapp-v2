      yogas.add(Yoga(shloka: 'α▓¿α│âα▓ùα│üα▓£α▓╢α▓╢α▓┐α▓¿α│ïα▓░α▓╕α│ìα▓ñα│ç... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│½)', name: shA?'α▓╡α▓┐α▓│α▓éα▓¼ α▓╡α▓┐α▓╡α▓╛α▓╣ (α▓à α│½)':'α▓àα▓¡α▓╛α▓░α│ìα▓» α▓»α│ïα▓ù (α▓à α│½)', description: 'α▓╢α│üα▓òα│ìα▓░+α▓Üα▓éα▓ªα│ìα▓░ 7α▓░α▓▓α│ìα▓▓α▓┐', result: shA?'α▓╡α│âα▓ªα│ìα▓ºα▓╛α▓¬α│ìα▓»α▓ªα▓▓α│ìα▓▓α▓┐ α▓╣α│åα▓éα▓íα▓ñα▓┐':'α▓╣α│åα▓éα▓íα▓ñα▓┐/α▓«α▓òα│ìα▓òα▓│α▓┐α▓▓α│ìα▓▓', rashi: ch21Ven, planets: ['α▓╢α│üα▓òα│ìα▓░','α▓Üα▓éα▓ªα│ìα▓░']));
