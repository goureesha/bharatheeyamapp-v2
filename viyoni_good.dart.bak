    ));

    // ΓòÉΓòÉΓòÉ JK Shloka 20: Direction of delivery room ΓòÉΓòÉΓòÉ
    final jk20DirMap = <int, String>{
      0: 'α▓¬α│éα▓░α│ìα▓╡', 3: 'α▓¬α│éα▓░α│ìα▓╡', 6: 'α▓¬α│éα▓░α│ìα▓╡', 7: 'α▓¬α│éα▓░α│ìα▓╡', 10: 'α▓¬α│éα▓░α│ìα▓╡',
      2: 'α▓ëα▓ñα│ìα▓ñα▓░', 5: 'α▓ëα▓ñα│ìα▓ñα▓░', 8: 'α▓ëα▓ñα│ìα▓ñα▓░', 11: 'α▓ëα▓ñα│ìα▓ñα▓░',
      1: 'α▓¬α▓╢α│ìα▓Üα▓┐α▓«',
      4: 'α▓ªα▓òα│ìα▓╖α▓┐α▓ú', 9: 'α▓ªα▓òα│ìα▓╖α▓┐α▓ú',
    };
    yogas.add(Yoga(
      shloka: 'α▓«α│çα▓╖α▓òα│üα▓▓α│Çα▓░α▓ñα│üα▓▓α▓╛α▓▓α▓┐α▓ÿα▓ƒα│ê: α▓¬α│ìα▓░α▓╛α▓ùα│üα▓ñα│ìα▓ñα▓░α▓ñα│ï α▓ùα│üα▓░α│üα▓╕α│îα▓«α│ìα▓»α▓ùα│âα▓╣α│êα▓╢α│ìα▓Ü',
      name: 'α▓╣α│åα▓░α▓┐α▓ùα│å α▓òα│ïα▓úα│å α▓ªα▓┐α▓òα│ìα▓òα│ü (α▓£α▓ò α│¿α│ª)',
      description: '${_rashiNames[lagRashi]} α▓▓α▓ùα│ìα▓¿ ΓåÆ ${jk20DirMap[lagRashi] ?? "α▓¬α│éα▓░α│ìα▓╡"} α▓ªα▓┐α▓òα│ìα▓òα│ü',
      result: '${jk20DirMap[lagRashi] ?? "α▓¬α│éα▓░α│ìα▓╡"} α▓ªα▓┐α▓òα│ìα▓òα▓┐α▓¿α▓▓α│ìα▓▓α▓┐',
