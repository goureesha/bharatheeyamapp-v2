      final trik9=ch21Sun==ch21H9||ch21Mars==ch21H9||ch21Sat==ch21H9;
      if (trik5||trik9) {
        yogas.add(Yoga(shloka: 'α▓ëα▓ªα▓»α▓ñα│ìα▓»α│üα▓íα│üα▓¬α│çsα▓╕α│üα▓░α▓╛α▓╕α│ìα▓»α▓ùα│ç... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│ºα│⌐)', name: 'α▓¬α▓┐α▓╢α▓╛α▓Ü α▓¼α▓╛α▓ºα│å α▓»α│ïα▓ù (α▓à α│ºα│⌐)', description: 'α▓Üα▓éα▓ªα│ìα▓░+α▓░α▓╛α▓╣α│ü α▓▓α▓ùα│ìα▓¿ + α▓¬α▓╛α▓¬ α▓ñα│ìα▓░α▓┐α▓òα│ïα▓ú', result: 'α▓¬α▓┐α▓╢α▓╛α▓Üα▓┐ α▓¼α▓╛α▓ºα│å', rashi: lagRashi, planets: ['α▓Üα▓éα▓ªα│ìα▓░','α▓░α▓╛α▓╣α│ü']));
      }
    }

    // --- Shloka 14: Saturn 7th+Jupiter lagna ΓåÆ unmada ---
    final ch21SatH = getBhava(ch21Sat, lagRashi);
    final ch21JupH = getBhava(ch21Jup, lagRashi);
    final ch21MarsH = getBhava(ch21Mars, lagRashi);
    if (ch21SatH==7 && ch21JupH==1) {
      yogas.add(Yoga(shloka: 'α▓╕α▓éα▓¡α│ìα▓░α▓╖α│ìα▓ƒ α▓¬α▓╡α▓¿α│çα▓¿... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│ºα│¬)', name: 'α▓ëα▓¿α│ìα▓«α▓╛α▓ª α▓»α│ïα▓ù (α▓à α│ºα│¬)', description: 'α▓╢α▓¿α▓┐ 7 + α▓ùα│üα▓░α│ü α▓▓α▓ùα│ìα▓¿', result: 'α▓╡α▓╛α▓ñα▓òα│ïα▓¬ α▓ëα▓¿α│ìα▓«α▓╛α▓ª', rashi: lagRashi, planets: ['α▓╢α▓¿α▓┐','α▓ùα│üα▓░α│ü']));
    }
    if (ch21MarsH==7 && ch21JupH==1) {
      yogas.add(Yoga(shloka: 'α▓╕α│ïα▓¿α│ìα▓«α▓╛α▓ªα│ïsα▓╡α▓¿α▓┐α▓╕α│éα▓¿α│üα▓¿α▓╛... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│ºα│¬)', name: 'α▓ëα▓¿α│ìα▓«α▓╛α▓ª α▓»α│ïα▓ù-α│¿ (α▓à α│ºα│¬)', description: 'α▓òα│üα▓£ 7 + α▓ùα│üα▓░α│ü α▓▓α▓ùα│ìα▓¿', result: 'α▓ëα▓¿α│ìα▓«α▓╛α▓ª', rashi: lagRashi, planets: ['α▓òα│üα▓£','α▓ùα│üα▓░α│ü']));
    }
    if (ch21SatH==1 && (ch21MarsH==9||ch21MarsH==5||ch21MarsH==7)) {
      yogas.add(Yoga(shloka: 'α▓ñα▓ªα│ìα▓╡α▓Üα│ìα▓Üα▓╛α▓╣ α▓»α▓«α│ïα▓ªα▓»α│ç... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│ºα│¬)', name: 'α▓ëα▓¿α│ìα▓«α▓╛α▓ª α▓»α│ïα▓ù-α│⌐ (α▓à α│ºα│¬)', description: 'α▓╢α▓¿α▓┐ α▓▓α▓ùα│ìα▓¿ + α▓òα│üα▓£ ${ch21MarsH}α▓¿α│ç α▓«α▓¿α│å', result: 'α▓ëα▓¿α│ìα▓«α▓╛α▓ª', rashi: lagRashi, planets: ['α▓╢α▓¿α▓┐','α▓òα│üα▓£']));
    }

    // --- Shloka 18: Sun/Sat/Mars in 10th without shubha drishti ΓåÆ parricide ---
    if (ch21SunH==10 || ch21SatH==10 || ch21MarsH==10) {
      final inH10 = <String>[];
      if (ch21SunH==10) inH10.add('α▓░α▓╡α▓┐');
      if (ch21SatH==10) inH10.add('α▓╢α▓¿α▓┐');
      if (ch21MarsH==10) inH10.add('α▓òα│üα▓£');
      final h10R=(lagRashi+9)%12;
      final shubH10=ch21Jup==h10R||ch21Mer==h10R||ch21Ven==h10R;
      if (!shubH10) {
        yogas.add(Yoga(shloka: 'α▓░α▓╡α▓┐α▓»α▓«α▓òα│üα▓£α│êα▓â... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│ºα│«)', name: 'α▓ºα│âα▓ñα▓ò α▓»α│ïα▓ù (α▓à α│ºα│«)', description: '${inH10.join("+")} 10α▓¿α│ç α▓«α▓¿α│å, α▓╢α│üα▓¡α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓çα▓▓α│ìα▓▓', result: 'α▓¬α▓┐α▓ñα│â/α▓«α▓╛α▓ñα│â α▓╣α▓╛α▓¿α▓┐α▓òα▓╛α▓░α▓ò', rashi: h10R, planets: inH10));
      }
    }

    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // Chapter 22: α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓òα▓╛α▓ºα│ìα▓»α▓╛α▓» (Streejaatakadhyaya)
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    final ch22LagNav = _d9Rashi(lag);
    final ch22MoonNav2 = _d9Rashi(moonLon);
    final ch22LagLord = rashiLords[lagRashi];
    final ch22H7 = (lagRashi+6)%12;
    final ch22H7Lord = rashiLords[ch22H7];
    final ch22H8 = (lagRashi+7)%12;
    final ch22H8Lord = rashiLords[ch22H8];
    final ch22VenNav = _d9Rashi(ven);
    final ch22SatNav = _d9Rashi(sat);
    final ch22MarsNav = _d9Rashi(mars);

    // Shloka 2: Lagna+Moon in even rashi ΓåÆ feminine; odd ΓåÆ masculine traits
    final ch22LagEven = _isEvenSign(lagRashi);
    final ch22MoonEven = _isEvenSign(ch21Moon);
    if (ch22LagEven && ch22MoonEven) {
      yogas.add(Yoga(shloka: 'α▓»α│üα▓òα│ìα▓òα│çα▓╖α│ü α▓▓α▓ùα│ìα▓¿α▓╢α▓╢α▓┐α▓¿α│ïα▓â... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│¿)', name: 'α▓╕α│ìα▓ñα│ìα▓░α│Ç α▓╕α▓╣α▓£ α▓ùα│üα▓ú (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│¿)', description: 'α▓▓α▓ùα│ìα▓¿+α▓Üα▓éα▓ªα│ìα▓░ α▓╕α▓« α▓░α▓╛α▓╢α▓┐', result: 'α▓╕α│ìα▓ñα│ìα▓░α│Çα▓╕α▓╣α▓£ α▓ùα│üα▓ú, α▓åα▓¡α▓░α▓úα▓¬α│ìα▓░α▓┐α▓»α▓│α│ü', rashi: lagRashi, planets: ['α▓▓α▓ùα│ìα▓¿','α▓Üα▓éα▓ªα│ìα▓░']));
    } else if (!ch22LagEven && !ch22MoonEven) {
      yogas.add(Yoga(shloka: 'α▓ôα▓£α▓╕α│ìα▓Ñα▓»α│ïα▓╕α│ìα▓ñα│ü α▓¬α│üα▓░α│üα▓╖α▓╛α▓òα│âα▓ñα▓┐... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│¿)', name: 'α▓¬α│üα▓░α│üα▓╖α▓╛α▓òα│âα▓ñα▓┐ α▓╕α│ìα▓ñα│ìα▓░α│Ç (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│¿)', description: 'α▓▓α▓ùα│ìα▓¿+α▓Üα▓éα▓ªα│ìα▓░ α▓¼α│åα▓╕ α▓░α▓╛α▓╢α▓┐', result: 'α▓¬α│üα▓░α│üα▓╖α▓¿α▓éα▓ñα▓╣ α▓åα▓òα▓╛α▓░/α▓ùα│üα▓ú', rashi: lagRashi, planets: ['α▓▓α▓ùα│ìα▓¿','α▓Üα▓éα▓ªα│ìα▓░']));
    }

    // Shloka 3: Mars rashi lagna/Moon + navamsha lord ΓåÆ character
    final ch22LagInMars = ch22LagLord == 'Mars';
    if (ch22LagInMars) {
      final navLord = rashiLords[ch22LagNav];
      if (navLord=='Mars') yogas.add(Yoga(shloka: 'α▓òα▓¿α│êα▓╡ α▓ªα│üα▓╖α│ìα▓ƒα▓╛... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│⌐)', name: 'α▓òα▓¿α│ìα▓»α▓╛ α▓ªα│üα▓╖α│ìα▓ƒ (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│⌐)', description: 'α▓òα│üα▓£ α▓░α▓╛α▓╢α▓┐+α▓òα│üα▓£ α▓¿α▓╡α▓╛α▓éα▓╢', result: 'α▓òα▓¿α│ìα▓»α│åα▓»α▓┐α▓░α│üα▓╡α▓╛α▓ùα▓▓α│ç α▓ªα│üα▓╖α│ìα▓ƒα▓│α│ü', rashi: lagRashi, planets: ['α▓▓α▓ùα│ìα▓¿']));
      if (navLord=='Saturn') yogas.add(Yoga(shloka: 'α▓╡α▓£α▓ñα│Çα▓╣ α▓ªα▓╛α▓╕α│ìα▓»α▓é... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│⌐)', name: 'α▓ªα▓╛α▓╕α▓┐ α▓»α│ïα▓ù (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│⌐)', description: 'α▓òα│üα▓£ α▓░α▓╛α▓╢α▓┐+α▓╢α▓¿α▓┐ α▓¿α▓╡α▓╛α▓éα▓╢', result: 'α▓ªα▓╛α▓╕α▓┐α▓»α▓╛α▓ùα│üα▓ñα│ìα▓ñα▓╛α▓│α│å', rashi: lagRashi, planets: ['α▓▓α▓ùα│ìα▓¿']));
      if (navLord=='Jupiter') yogas.add(Yoga(shloka: 'α▓╕α▓╛α▓ºα│Ç... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│⌐)', name: 'α▓╕α▓╛α▓ºα│ìα▓╡α▓┐ α▓»α│ïα▓ù (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│⌐)', description: 'α▓òα│üα▓£ α▓░α▓╛α▓╢α▓┐+α▓ùα│üα▓░α│ü α▓¿α▓╡α▓╛α▓éα▓╢', result: 'α▓╕α▓╛α▓ºα│ìα▓╡α▓┐α▓»α▓╛α▓ùα│üα▓ñα│ìα▓ñα▓╛α▓│α│å', rashi: lagRashi, planets: ['α▓▓α▓ùα│ìα▓¿']));
      if (navLord=='Mercury') yogas.add(Yoga(shloka: 'α▓╕α▓«α▓╛α▓»α▓╛... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│⌐)', name: 'α▓«α▓╛α▓»α▓╛α▓╡α▓┐ (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│⌐)', description: 'α▓òα│üα▓£ α▓░α▓╛α▓╢α▓┐+α▓¼α│üα▓º α▓¿α▓╡α▓╛α▓éα▓╢', result: 'α▓«α▓╛α▓»α▓╛α▓╡α▓┐α▓»α▓╛α▓ùα│üα▓ñα│ìα▓ñα▓╛α▓│α│å', rashi: lagRashi, planets: ['α▓▓α▓ùα│ìα▓¿']));
      if (navLord=='Venus') yogas.add(Yoga(shloka: 'α▓òα│üα▓Üα▓░α▓┐α▓ñα│ìα▓░α▓»α│üα▓òα│ìα▓ñα▓╛... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│⌐)', name: 'α▓òα│üα▓Üα▓░α▓┐α▓ñα│ìα▓░ (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│⌐)', description: 'α▓òα│üα▓£ α▓░α▓╛α▓╢α▓┐+α▓╢α│üα▓òα│ìα▓░ α▓¿α▓╡α▓╛α▓éα▓╢', result: 'α▓òα│åα▓ƒα│ìα▓ƒ α▓Üα▓╛α▓░α▓┐α▓ñα│ìα▓░α│ìα▓»', rashi: lagRashi, planets: ['α▓▓α▓ùα│ìα▓¿']));
    }

    // Shloka 7: Saturn+Venus mutual navamsha exchange
    final ch22SatNavLord = rashiLords[ch22SatNav];
    final ch22VenNavLord = rashiLords[ch22VenNav];
    if (ch22SatNavLord=='Venus' && ch22VenNavLord=='Saturn') {
      yogas.add(Yoga(shloka: 'α▓╡α│âα▓òα│ìα▓╖α▓éα▓╕α│ìα▓Ñα▓╛α▓╡α▓╕α▓┐α▓ñα▓╕α▓┐α▓ñα│î α▓¬α▓░α▓╕α│ìα▓¬α▓░α▓╛α▓éα▓╢α│ç... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│¡)', name: 'α▓╢α▓¿α▓┐-α▓╢α│üα▓òα│ìα▓░ α▓¬α▓░α▓┐α▓╡α▓░α│ìα▓ñα▓¿α│å (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│¡)', description: 'α▓╢α▓¿α▓┐ α▓╢α│üα▓òα│ìα▓░ α▓¿α▓╡α▓╛α▓éα▓╢ + α▓╢α│üα▓òα│ìα▓░ α▓╢α▓¿α▓┐ α▓¿α▓╡α▓╛α▓éα▓╢', result: 'α▓àα▓╕α▓╛α▓«α▓╛α▓¿α│ìα▓» α▓òα▓╛α▓«α▓╡α│âα▓ñα│ìα▓ñα▓┐', rashi: ch21Ven, planets: ['α▓╢α│üα▓òα│ìα▓░','α▓╢α▓¿α▓┐']));
    }

    // Shloka 8: 7th house analysis for husband
    final ch22H7Nav = _d9Rashi(lag + (ch22H7 * 30.0)); // approximate
    final ch22H7NavLord = rashiLords[ch22H7Nav];
    // Mercury+Saturn in 7th ΓåÆ impotent husband
    if (ch21Mer == ch22H7 && ch21Sat == ch22H7) {
      yogas.add(Yoga(shloka: 'α▓òα│ìα▓▓α│Çα▓¼α│ïsα▓╕α│ìα▓ñα│ç α▓¼α│üα▓ºα▓«α▓éα▓ªα▓»α│ïα▓â... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│«)', name: 'α▓¿α▓¬α│üα▓éα▓╕α▓ò α▓¬α▓ñα▓┐ (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│«)', description: 'α▓¼α│üα▓º+α▓╢α▓¿α▓┐ 7α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐', result: 'α▓¿α▓¬α│üα▓éα▓╕α▓ò α▓ùα▓éα▓í', rashi: ch22H7, planets: ['α▓¼α│üα▓º','α▓╢α▓¿α▓┐']));
    }
    // Sun in 7th ΓåÆ abandoned by husband
    if (ch21SunH == 7) {
      yogas.add(Yoga(shloka: 'α▓ëα▓ñα│ìα▓òα│âα▓╖α│ìα▓ƒα▓╛ α▓ñα▓░α▓úα│ç... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│«)', name: 'α▓¬α▓ñα▓┐ α▓ñα│ìα▓»α▓╛α▓ù (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│«)', description: 'α▓╕α│éα▓░α│ìα▓» 7α▓░α▓▓α│ìα▓▓α▓┐', result: 'α▓ùα▓éα▓íα▓¿α▓┐α▓éα▓ª α▓ñα│ìα▓»α▓£α▓┐α▓╕α▓▓α│ìα▓¬α▓íα│üα▓ñα│ìα▓ñα▓╛α▓│α│å', rashi: ch22H7, planets: ['α▓░α▓╡α▓┐']));
    }
    // Mars in 7th ΓåÆ early widowhood
    if (ch21MarsH == 7) {
      yogas.add(Yoga(shloka: 'α▓òα│üα▓£α│ç α▓ñα│ü α▓╡α▓┐α▓ºα▓╡α▓╛... (α▓╕α│ìα▓ñα│ìα▓░α│Çα▓£α▓╛α▓ñα▓ò α│«)', name: 'α▓¼α▓╛α▓▓ α▓╡α│êα▓ºα▓╡α│ìα▓» (α▓╕α│ìα▓ñα│ìα▓░α│Ç α│«)', description: 'α▓òα│üα▓£ 7α▓░α▓▓α│ìα▓▓α▓┐', result: 'α▓¼α▓╛α▓▓α│ìα▓»α▓ªα▓▓α│ìα▓▓α▓┐ α▓╡α▓┐α▓ºα▓╡α│å', rashi: ch22H7, planets: ['α▓òα│üα▓£']));
    }

    // Shloka 9: Papa in 7th ΓåÆ widowhood; mixed ΓåÆ remarriage
    final papaIn7th = ch21Sun==ch22H7||ch21Mars==ch22H7||ch21Sat==ch22H7||ch21Rahu==ch22H7;
    final shubIn7th = ch21Jup==ch22H7||ch21Ven==ch22H7||ch21Mer==ch22H7;
    if (papaIn7th && !shubIn7th) {
