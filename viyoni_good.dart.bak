    if (dyAreTogether('Mars', 'Saturn')) {
      yogas.add(Yoga(
        shloka: 'α▓ªα│üα▓âα▓ûα▓╛α▓░α│ìα▓ñα│ïsα▓╕α▓ñα│ìα▓»α▓╕α▓éα▓ºα▓â α▓╕α▓╕α▓╡α▓┐α▓ñα│âα▓ñα▓¿α▓»α│ç α▓¡α│éα▓«α▓┐α▓£α│ç α▓¿α▓┐α▓éα▓ªα▓┐α▓ñα▓╢α│ìα▓Ü',
        name: 'α▓òα│üα▓£-α▓╢α▓¿α▓┐ α▓»α│ïα▓ù (α▓ªα│ìα▓╡α▓┐ α│⌐)',
        description: 'α▓òα│üα▓£ α▓«α▓ñα│ìα▓ñα│ü α▓╢α▓¿α▓┐ α▓Æα▓ƒα│ìα▓ƒα▓┐α▓ùα│å',
        result: 'α▓ªα│üα▓âα▓ûα▓┐, α▓╕α│üα▓│α│ìα▓│α│üα▓ùα▓╛α▓░, α▓¿α▓┐α▓éα▓ªα│åα▓ùα│å α▓Æα▓│α▓ùα▓╛α▓ùα│üα▓╡α▓╡α▓¿α│ü',
        rashi: dyTogetherRashi('Mars', 'Saturn'), planets: ['α▓òα│üα▓£', 'α▓╢α▓¿α▓┐'],
      ));
    }

    // ΓòÉΓòÉΓòÉ DY Shloka 4: Mercury & Jupiter combinations ΓòÉΓòÉΓòÉ
    if (dyAreTogether('Mercury', 'Jupiter')) {
      yogas.add(Yoga(
        shloka: 'α▓╕α│îα▓«α│ìα▓» α▓░α▓éα▓ùα▓Üα▓░α│ï α▓¼α│âα▓╣α▓╕α│ìα▓¬α▓ñα▓┐α▓»α│üα▓ñα│ç α▓ùα│Çα▓ñα▓¬α│ìα▓░α▓┐α▓»α│ï α▓¿α│âα▓ñα│ìα▓»α▓╡α▓┐',
        name: 'α▓¼α│üα▓º-α▓ùα│üα▓░α│ü α▓»α│ïα▓ù (α▓ªα│ìα▓╡α▓┐ α│¬)',
        description: 'α▓¼α│üα▓º α▓«α▓ñα│ìα▓ñα│ü α▓ùα│üα▓░α│ü α▓Æα▓ƒα│ìα▓ƒα▓┐α▓ùα│å',
        result: 'α▓░α▓éα▓ùα▓¡α│éα▓«α▓┐α▓»α▓▓α│ìα▓▓α▓┐α▓░α│üα▓╡α▓╡α▓¿α│ü, α▓ùα│Çα▓ñα▓¬α│ìα▓░α▓┐α▓», α▓¿α│âα▓ñα│ìα▓» α▓¼α▓▓α│ìα▓▓α▓╡α▓¿α│ü',
        rashi: dyTogetherRashi('Mercury', 'Jupiter'), planets: ['α▓¼α│üα▓º', 'α▓ùα│üα▓░α│ü'],
      ));
    }
    if (dyAreTogether('Mercury', 'Venus')) {
      yogas.add(Yoga(
        shloka: 'α▓ªα│ìα▓╡α▓╛α▓▓α│ìα▓«α│Ç α▓¡α│éα▓ùα▓úα▓¬α▓â α▓╕α▓┐α▓ñα│çα▓¿ α▓«α│âα▓ªα│üα▓¿α▓╛',
        name: 'α▓¼α│üα▓º-α▓╢α│üα▓òα│ìα▓░ α▓»α│ïα▓ù (α▓ªα│ìα▓╡α▓┐ α│¬)',
        description: 'α▓¼α│üα▓º α▓«α▓ñα│ìα▓ñα│ü α▓╢α│üα▓òα│ìα▓░ α▓Æα▓ƒα│ìα▓ƒα▓┐α▓ùα│å',
        result: 'α▓╡α▓╛α▓òα│ìα▓Üα▓╛α▓ñα│üα▓░α│ìα▓»α▓╡α│üα▓│α│ìα▓│α▓╡α▓¿α│ü, α▓¡α│éα▓«α▓┐/α▓£α▓¿α▓░ α▓Æα▓íα│åα▓»',
        rashi: dyTogetherRashi('Mercury', 'Venus'), planets: ['α▓¼α│üα▓º', 'α▓╢α│üα▓òα│ìα▓░'],
      ));
    }
    if (dyAreTogether('Mercury', 'Saturn')) {
      yogas.add(Yoga(
        shloka: 'α▓«α▓╛α▓»α▓╛α▓¬α▓ƒα│üα▓░α│ìα▓▓α▓éα▓ÿα▓òα▓â',
        name: 'α▓¼α│üα▓º-α▓╢α▓¿α▓┐ α▓»α│ïα▓ù (α▓ªα│ìα▓╡α▓┐ α│¬)',
        description: 'α▓¼α│üα▓º α▓«α▓ñα│ìα▓ñα│ü α▓╢α▓¿α▓┐ α▓Æα▓ƒα│ìα▓ƒα▓┐α▓ùα│å',
        result: 'α▓«α▓╛α▓»α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓¿α▓┐α▓¬α│üα▓ú, α▓▓α▓éα▓ÿα▓ò',
        rashi: dyTogetherRashi('Mercury', 'Saturn'), planets: ['α▓¼α│üα▓º', 'α▓╢α▓¿α▓┐'],
      ));
    }
    if (dyAreTogether('Jupiter', 'Venus')) {
      yogas.add(Yoga(
        shloka: 'α▓╕α▓ªα│ìα▓╡α▓┐α▓ªα│ìα▓»α│ï α▓ºα▓¿α▓ªα▓╛α▓░α▓╡α▓╛α▓¿α│ì α▓¼α▓╣α│üα▓ùα│üα▓úα▓â α▓╢α│üα▓òα│ìα▓░α│çα▓ú α▓»α│üα▓òα│ìα▓ñ α▓ùα│üα▓░α│î',
        name: 'α▓ùα│üα▓░α│ü-α▓╢α│üα▓òα│ìα▓░ α▓»α│ïα▓ù (α▓ªα│ìα▓╡α▓┐ α│¬)',
        description: 'α▓ùα│üα▓░α│ü α▓«α▓ñα│ìα▓ñα│ü α▓╢α│üα▓òα│ìα▓░ α▓Æα▓ƒα│ìα▓ƒα▓┐α▓ùα│å',
        result: 'α▓Æα▓│α│ìα▓│α│åα▓» α▓╡α▓┐α▓ªα│ìα▓»α│å, α▓╣α▓ú, α▓╣α│åα▓éα▓íα▓ñα▓┐, α▓¼α▓╣α│ü α▓ùα│üα▓ú',
        rashi: dyTogetherRashi('Jupiter', 'Venus'), planets: ['α▓ùα│üα▓░α│ü', 'α▓╢α│üα▓òα│ìα▓░'],
      ));
    }
    if (dyAreTogether('Jupiter', 'Saturn')) {
      yogas.add(Yoga(
        shloka: 'α▓╕α│ìα▓«α▓╢α│üα▓òα▓░α│ïsα▓╕α▓┐α▓ñα│çα▓¿ α▓ÿα▓ƒα▓òα│âα▓ªα│ìα▓ªα▓╛ α▓ñα▓╛α▓¿α│ìα▓¿ α▓òα▓╛α▓░α│ïsα▓¬α▓┐ α▓╡α▓╛',
        name: 'α▓ùα│üα▓░α│ü-α▓╢α▓¿α▓┐ α▓»α│ïα▓ù (α▓ªα│ìα▓╡α▓┐ α│¬)',
        description: 'α▓ùα│üα▓░α│ü α▓«α▓ñα│ìα▓ñα│ü α▓╢α▓¿α▓┐ α▓Æα▓ƒα│ìα▓ƒα▓┐α▓ùα│å',
        result: 'α▓òα│ìα▓╖α│îα▓░α▓┐α▓ò, α▓«α▓íα▓┐α▓òα│å α▓«α▓╛α▓íα│üα▓╡α▓╡α▓¿α│ü / α▓àα▓íα│üα▓ùα│å α▓«α▓╛α▓íα│üα▓╡α▓╡α▓¿α│ü',
        rashi: dyTogetherRashi('Jupiter', 'Saturn'), planets: ['α▓ùα│üα▓░α│ü', 'α▓╢α▓¿α▓┐'],
      ));
    }

    // ΓòÉΓòÉΓòÉ DY Shloka 5: Saturn and Venus combination ΓòÉΓòÉΓòÉ
    if (dyAreTogether('Saturn', 'Venus')) {
      yogas.add(Yoga(
        shloka: 'α▓àα▓╕α▓┐α▓ñα▓╕α▓┐α▓ñα▓╕α▓«α▓╛α▓ùα▓«α│çα▓╜α▓▓α│ìα▓¬α▓Üα▓òα│ìα▓╖α│üα▓░α│ìα▓»α│üα▓╡α▓ñα▓┐α▓£α▓¿α▓╛α▓╢α│ìα▓░α▓»α▓╕α▓éα▓¬α│ìα▓░α▓╡α│âα▓ªα│ìα▓ºα▓╡α▓┐α▓ñα│ìα▓ñα▓â αÑñ α▓¡α▓╡α▓ñα▓┐ α▓Ü α▓▓α▓┐α▓¬α▓┐α▓¬α│üα▓╕α│ìα▓ñα▓Üα▓┐α▓ñα│ìα▓░α▓╡α│çα▓ñα│ìα▓ñα▓╛',
        name: 'α▓╢α▓¿α▓┐-α▓╢α│üα▓òα│ìα▓░ α▓»α│ïα▓ù (α▓ªα│ìα▓╡α▓┐ α│½)',
        description: 'α▓╢α▓¿α▓┐ α▓«α▓ñα│ìα▓ñα│ü α▓╢α│üα▓òα│ìα▓░ α▓Æα▓ƒα│ìα▓ƒα▓┐α▓ùα│å',
        result: 'α▓╕α▓úα│ìα▓ú α▓òα▓úα│ìα▓úα│ü, α▓╕α│ìα▓ñα│ìα▓░α│Çα▓»α▓░ α▓åα▓╢α│ìα▓░α▓»α▓ªα▓┐α▓éα▓ª α▓╣α▓ú, α▓¼α▓░α▓╡α▓úα▓┐α▓ùα│å/α▓¬α│üα▓╕α│ìα▓ñα▓ò/α▓Üα▓┐α▓ñα│ìα▓░α▓òα▓▓α│å α▓¼α▓▓α│ìα▓▓α▓╡α▓¿α│ü',
        rashi: dyTogetherRashi('Saturn', 'Venus'), planets: ['α▓╢α▓¿α▓┐', 'α▓╢α│üα▓òα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // Chapter 15: α▓¬α│ìα▓░α▓╡α│ìα▓░α▓£α│ìα▓»α▓╛α▓»α│ïα▓ùα▓╛α▓ºα│ìα▓»α▓╛α▓» (Pravrajya Yogadhyaya - Ascetic Yogas)
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

    // ΓòÉΓòÉΓòÉ PY Shloka 1 & 2: Four or more strong planets in one Rashi ΓòÉΓòÉΓòÉ
    final pyRashiCounts = <int, List<String>>{};
    for (final e in allPLons.entries) {
      if (e.key == 'Rahu' || e.key == 'Ketu') continue;
      final r = _rashiOf(e.value);
      pyRashiCounts.putIfAbsent(r, () => <String>[]).add(e.key);
    }
    
    for (final entry in pyRashiCounts.entries) {
      if (entry.value.length >= 4) {
        String? strongestPlanet;
        for (final p in entry.value) {
          if (isStrong(p)) {
            strongestPlanet = p;
            break;
          }
        }
        
        if (strongestPlanet != null) {
          final pyDikshaMap = <String, String>{
            'Mars': 'α▓╢α▓╛α▓òα│ìα▓»',
            'Mercury': 'α▓åα▓£α│Çα▓╡α▓ò',
            'Jupiter': 'α▓¡α▓┐α▓òα│ìα▓╖α│ü',
            'Moon': 'α▓╡α│âα▓ªα│ìα▓º α▓╢α│ìα▓░α▓╛α▓╡α▓ò',
            'Venus': 'α▓Üα▓░α▓ò',
            'Sun': 'α▓╡α▓¿α│ìα▓»α▓╛α▓╢α▓¿',
            'Saturn': 'α▓¿α▓┐α▓░α│ìα▓ùα│ìα▓░α▓éα▓Ñ'
          };
          
          final sanyasaType = pyDikshaMap[strongestPlanet] ?? 'α▓╕α▓¿α│ìα▓»α▓╛α▓╕';
          
          bool pyCombust = false;
          if (strongestPlanet != 'Sun') {
             final pDist = (allPLons[strongestPlanet]! - sun).abs() % 360;
             final shortestDist = pDist > 180 ? 360 - pDist : pDist;
             if (shortestDist < 10) pyCombust = true; 
          }
          
          bool pyDefeated = false;
          if (strongestPlanet != 'Sun' && strongestPlanet != 'Moon') {
            for (final p2 in entry.value) {
               if (p2 != strongestPlanet && p2 != 'Sun' && p2 != 'Moon' && isStrong(p2)) {
                 pyDefeated = true;
               }
            }
          }
          
          bool pyAspected = false;
          for (final pAspect in allPLons.entries) {
            if (!entry.value.contains(pAspect.key)) {
               if ((_rashiOf(pAspect.value) + 6) % 12 == entry.key) pyAspected = true;
            }
          }

          String pyResult = '$sanyasaType α▓ªα│Çα▓òα│ìα▓╖α│å';
          String pyDesc = '${entry.value.map((e) => _knPlanets[e]).join(', ')} α▓Æα▓éα▓ªα│ç α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐. α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐ ${_knPlanets[strongestPlanet]}α▓¿α▓┐α▓éα▓ª $sanyasaType α▓╕α▓¿α│ìα▓»α▓╛α▓╕.';
          
          if (pyCombust) {
            pyResult = 'α▓╕α▓¿α│ìα▓»α▓╛α▓╕α▓┐α▓ùα▓│ α▓«α│çα▓▓α│å α▓¡α▓òα│ìα▓ñα▓┐';
            pyDesc += '\nα▓ùα│ìα▓░α▓╣α▓╡α│ü α▓àα▓╕α│ìα▓ñα▓éα▓ùα▓ñα▓╡α▓╛α▓ùα▓┐α▓░α│üα▓╡α│üα▓ªα▓░α▓┐α▓éα▓ª, α▓ªα│Çα▓òα│ìα▓╖α│å α▓╕α▓┐α▓ùα│üα▓╡α│üα▓ªα▓┐α▓▓α│ìα▓▓, α▓¡α▓òα│ìα▓ñα▓┐ α▓«α▓╛α▓ñα│ìα▓░.';
          } else if (pyAspected) {
            pyResult = 'α▓ªα│Çα▓òα│ìα▓╖α│åα▓»α▓¿α│ìα▓¿α│ü α▓¼α│çα▓íα│üα▓╡α▓╡α▓¿α│ü';
            pyDesc += '\nα▓çα▓ñα▓░ α▓ùα│ìα▓░α▓╣α▓░ α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓»α▓┐α▓░α│üα▓╡α│üα▓ªα▓░α▓┐α▓éα▓ª α▓òα│çα▓╡α▓▓ α▓ªα│Çα▓òα│ìα▓╖α│åα▓»α▓¿α│ìα▓¿α│ü α▓¼α│çα▓íα│üα▓ñα│ìα▓ñα▓╛α▓¿α│å.';
          } else if (pyDefeated) {
            pyResult = 'α▓ªα│Çα▓òα│ìα▓╖α│å α▓¬α▓íα│åα▓ªα│ü α▓¼α▓┐α▓íα│üα▓╡α▓╡α▓¿α│ü';
            pyDesc += '\nα▓ùα│ìα▓░α▓╣α▓»α│üα▓ªα│ìα▓ºα▓ªα▓▓α│ìα▓▓α▓┐ α▓╕α│ïα▓ñα▓┐α▓░α│üα▓╡α│üα▓ªα▓░α▓┐α▓éα▓ª α▓ªα│Çα▓òα│ìα▓╖α│å α▓¬α▓íα│åα▓ª α▓¿α▓éα▓ñα▓░ α▓╕α▓¿α│ìα▓»α▓╛α▓╕ α▓¼α▓┐α▓íα│üα▓ñα│ìα▓ñα▓╛α▓¿α│å.';
          }

          yogas.add(Yoga(
            shloka: 'α▓Åα▓òα▓╕α│ìα▓Ñα│åα▓╢α│ìα▓Üα▓ñα│üα▓░α▓╛α▓ªα▓┐α▓¡α▓┐α▓░α│ìα▓¼α▓▓α▓»α│üα▓ñα│êα▓░α│ìα▓£α▓╛α▓ñα▓╛α▓â α▓¬α│âα▓Ñα▓░α│ìα▓»α▓ùα│ê... α▓░α▓╡α▓┐α▓▓α│üα▓¬α│ìα▓ñα▓òα▓░α▓ªα│Çα▓òα│ìα▓╖α▓┐α▓ñα▓╛ α▓¼α▓▓α▓┐α▓¡α▓┐α▓╕α│ìα▓ñα▓ñα▓¡α▓òα│ìα▓ñα▓»α│ï',
            name: 'α▓¬α│ìα▓░α▓╡α│ìα▓░α▓£α│ìα▓»α▓╛ α▓»α│ïα▓ù (α▓¬α│ìα▓░ α│º,α│¿)',
            description: pyDesc,
            result: pyResult,
            rashi: entry.key, planets: entry.value.map((e) => _knPlanets[e]!).toList(),
          ));
        }
      }
    }

    // ΓòÉΓòÉΓòÉ PY Shloka 3: Lagna lord aspects Saturn or Saturn aspects weak Lagna lord ΓòÉΓòÉΓòÉ
    final pyLagLord = rashiLords[lagRashi];
    final pyLagLordR = _rashiOf(allPLons[pyLagLord]!);
    final pySatR = _rashiOf(allPLons['Saturn']!);
    
    bool pyLagLordAspected = false;
    for (final e in allPLons.entries) {
      if (e.key != pyLagLord && e.key != 'Saturn' && (_rashiOf(e.value) + 6) % 12 == pyLagLordR) pyLagLordAspected = true;
    }
    
    bool pyLagLordAspectsSaturn = (pyLagLordR + 6) % 12 == pySatR;
    bool pySatAspectsLagLord = (pySatR + 6) % 12 == pyLagLordR;
    bool pyLagLordWeak = !isStrong(pyLagLord);
    
    if ((!pyLagLordAspected && pyLagLordAspectsSaturn) || (pySatAspectsLagLord && pyLagLordWeak)) {
       yogas.add(Yoga(
          shloka: 'α▓£α▓ùα│ìα▓ùα│çα▓╢α│ïsα▓¿α│êα▓░α│ìα▓»α▓ªα│âα▓╖α│ìα▓ƒα│ïα▓░α│ìα▓òα▓¬α│üα▓ñα│ìα▓░α▓é α▓¬α▓╢α│ìα▓»α▓ñα│ìα▓»α▓╛α▓░α│ìα▓òα▓┐α▓£α│ìα▓░α▓¿α│ìα▓«α▓¬α▓é α▓╡α▓╛ α▓¼α▓▓α│ïα▓¿α▓«α│ì',
          name: 'α▓╢α▓¿α▓┐ α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓╕α▓¿α│ìα▓»α▓╛α▓╕ (α▓¬α│ìα▓░ α│⌐)',
          description: (!pyLagLordAspected && pyLagLordAspectsSaturn) 
            ? 'α▓▓α▓ùα│ìα▓¿α▓╛α▓ºα▓┐α▓¬α▓ñα▓┐α▓»α│ü α▓╢α▓¿α▓┐α▓»α▓¿α│ìα▓¿α│ü α▓¿α│ïα▓íα│üα▓ñα│ìα▓ñα▓┐α▓ªα│ìα▓ªα▓╛α▓¿α│å (α▓çα▓ñα▓░ α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓çα▓▓α│ìα▓▓)' 
            : 'α▓╢α▓¿α▓┐α▓»α│ü α▓¼α▓▓α▓╣α│Çα▓¿ α▓▓α▓ùα│ìα▓¿α▓╛α▓ºα▓┐α▓¬α▓ñα▓┐α▓»α▓¿α│ìα▓¿α│ü α▓¿α│ïα▓íα│üα▓ñα│ìα▓ñα▓┐α▓ªα│ìα▓ªα▓╛α▓¿α│å',
          result: 'α▓╕α▓¿α│ìα▓»α▓╛α▓╕ α▓»α│ïα▓ù',
          rashi: lagRashi, planets: [_knPlanets[pyLagLord]!, 'α▓╢α▓¿α▓┐'],
        ));
    }
    
    // Moon in Saturn Drekkana, Mars/Saturn Navamsha, aspected by Saturn
    // Drekkana rashi: 1st drek = same sign, 2nd = +4, 3rd = +8
    final pyMoonDrekNum = _drekkanaNum(moonLon);
    final pyMoonDrek = (moonR2 + (pyMoonDrekNum - 1) * 4) % 12;
    final pyMoonNav = _d9Rashi(moonLon);
    final pySatR2 = _rashiOf(allPLons['Saturn']!);
    final pySatAspMoon = (pySatR2 + 6) % 12 == moonR2 || (pySatR2 + 2) % 12 == moonR2 || (pySatR2 + 9) % 12 == moonR2;
    
    if (rashiLords[pyMoonDrek] == 'Saturn' && (rashiLords[pyMoonNav] == 'Mars' || rashiLords[pyMoonNav] == 'Saturn') && pySatAspMoon) {
       yogas.add(Yoga(
          shloka: 'α▓ªα│Çα▓òα│ìα▓╖α▓╛α▓é α▓¬α│ìα▓░α▓╛α▓¬α│ìα▓¬α│ïα▓ñα│ìα▓»α▓╛α▓░α│ìα▓òα▓┐α▓ªα│âα▓òα│ìα▓òα▓╛α▓úα▓╕α▓éα▓╕α│ìα▓Ñα│å α▓¡α│îα▓«α▓╛α▓░α│ìα▓òα│ìα▓»α▓éα▓╢α│ç α▓╕α│îα▓░α▓ªα│âα▓╖α│ìα▓ƒα│ç α▓Ü α▓Üα▓éα▓ªα│ìα▓░α│ç',
          name: 'α▓Üα▓éα▓ªα│ìα▓░-α▓╢α▓¿α▓┐ α▓╕α▓¿α│ìα▓»α▓╛α▓╕ α▓»α│ïα▓ù (α▓¬α│ìα▓░ α│⌐)',
          description: 'α▓Üα▓éα▓ªα│ìα▓░α▓¿α│ü α▓╢α▓¿α▓┐α▓» α▓ªα│ìα▓░α│çα▓òα│ìα▓òα▓╛α▓úα▓ªα▓▓α│ìα▓▓α▓┐, α▓òα│üα▓£/α▓╢α▓¿α▓┐α▓» α▓¿α▓╡α▓╛α▓éα▓╢α▓ªα▓▓α│ìα▓▓α▓┐α▓ªα│ìα▓ªα│ü α▓╢α▓¿α▓┐ α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
          result: 'α▓╕α▓¿α│ìα▓»α▓╛α▓╕ α▓ªα│Çα▓òα│ìα▓╖α│å',
          rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α▓¿α▓┐'],
        ));
    }

    // ΓòÉΓòÉΓòÉ PY Shloka 4: Rajayoga combinations for Ascetics/Pilgrimage makers ΓòÉΓòÉΓòÉ
    bool pySatAspJup = (pySatR2 + 6) % 12 == _rashiOf(allPLons['Jupiter']!) || (pySatR2 + 2) % 12 == _rashiOf(allPLons['Jupiter']!) || (pySatR2 + 9) % 12 == _rashiOf(allPLons['Jupiter']!);
    bool pySatAspMoon2 = pySatAspMoon;
    bool pySatAspLag = (pySatR2 + 6) % 12 == lagRashi || (pySatR2 + 2) % 12 == lagRashi || (pySatR2 + 9) % 12 == lagRashi;
    bool pyJupIn9 = ((_rashiOf(allPLons['Jupiter']!) - lagRashi) % 12) + 1 == 9;
    
    if (pySatAspJup && pySatAspMoon2 && pySatAspLag && pyJupIn9) {
      yogas.add(Yoga(
          shloka: 'α▓╕α│üα▓░α▓ùα│üα▓░α│üα▓╢α▓╢α▓┐α▓╣α│ïα▓░α▓╛α▓╕α│ìα▓╡α▓╛α▓░α│ìα▓òα▓┐α▓ªα│âα▓╖α│ìα▓ƒα▓╛α▓╕α│ü α▓ºα▓░α│ìα▓«α│ç α▓ùα│üα▓░α│üα▓░α▓Ñ α▓¿α│âα▓¬α▓ñα│Çα▓¿α▓╛α▓é',
          name: 'α▓ñα│Çα▓░α│ìα▓Ñα▓òα│ìα▓╖α│çα▓ñα│ìα▓░ α▓¿α▓┐α▓░α│ìα▓«α▓╛α▓ú α▓»α│ïα▓ù (α▓¬α│ìα▓░ α│¬)',
          description: 'α▓ùα│üα▓░α│ü, α▓Üα▓éα▓ªα│ìα▓░, α▓▓α▓ùα│ìα▓¿α▓ª α▓«α│çα▓▓α│å α▓╢α▓¿α▓┐α▓» α▓ªα│âα▓╖α│ìα▓ƒα▓┐ + 9α▓░α▓▓α│ìα▓▓α▓┐ α▓ùα│üα▓░α│ü',
          result: 'α▓ñα│Çα▓░α│ìα▓Ñα▓òα│ìα▓╖α│çα▓ñα│ìα▓░α▓ùα▓│α▓¿α│ìα▓¿α│ü α▓¿α▓┐α▓░α│ìα▓«α▓┐α▓╕α│üα▓╡ α▓¬α│üα▓úα│ìα▓»α▓╛α▓ñα│ìα▓« (α▓░α▓╛α▓£α▓»α│ïα▓ùα▓╡α▓┐α▓ªα│ìα▓ªα▓░α│å)',
          rashi: lagRashi, planets: ['α▓ùα│üα▓░α│ü', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓╢α▓¿α▓┐'],
        ));
    }
    
    bool pySatIn9 = ((pySatR2 - lagRashi) % 12) + 1 == 9;
    bool pySatUnaspected = true;
    for (final e in allPLons.entries) {
      if (e.key != 'Saturn' && (_rashiOf(e.value) + 6) % 12 == pySatR2) pySatUnaspected = false;
    }
    
    if (pySatIn9 && pySatUnaspected) {
      yogas.add(Yoga(
          shloka: 'α▓¿α▓╡α▓«α▓¡α▓╡α▓¿α▓╕α▓éα▓╕α│ìα▓Ñα│å α▓«α▓éα▓ªα│çα▓ùα│çsα▓¿α│êα▓░α▓ªα│âα▓╖α│ìα▓ƒα│ç α▓¡α▓╡α▓ñα▓┐ α▓¿α▓░α▓¬α▓»α│ïα▓ùα│ç α▓ªα│Çα▓òα│ìα▓╖α▓┐α▓ñα▓â',
          name: 'α▓░α▓╛α▓£ α▓╕α▓¿α│ìα▓»α▓╛α▓╕ α▓»α│ïα▓ù (α▓¬α│ìα▓░ α│¬)',
          description: '9α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓╢α▓¿α▓┐ + α▓çα▓ñα▓░ α▓ùα│ìα▓░α▓╣α▓░ α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓»α▓┐α▓▓α│ìα▓▓',
          result: 'α▓«α▓╣α▓╛α▓░α▓╛α▓£α▓¿α│ü α▓╕α▓¿α│ìα▓»α▓╛α▓╕ α▓ªα│Çα▓òα│ìα▓╖α│åα▓»α▓¿α│ìα▓¿α│ü α▓¬α▓íα│åα▓»α│üα▓ñα│ìα▓ñα▓╛α▓¿α│å (α▓░α▓╛α▓£α▓»α│ïα▓ùα▓╡α▓┐α▓ªα│ìα▓ªα▓░α│å)',
          rashi: pySatR2, planets: ['α▓╢α▓¿α▓┐'],
        ));
    }


    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // Chapter 17: α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» (Drishtiphaladhyaya - Results of Aspects)
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

    // Helper: does planet aspect targetRashi? (includes special aspects)
    bool ch17Aspects(String aspectingPlanet, int targetRashi) {
      if (!allPLons.containsKey(aspectingPlanet)) return false;
      final aR = _rashiOf(allPLons[aspectingPlanet]!);
      final dist = ((targetRashi - aR) % 12) + 1;
      if (dist == 7) return true;
      if (aspectingPlanet == 'Mars' && (dist == 4 || dist == 8)) return true;
      if (aspectingPlanet == 'Jupiter' && (dist == 5 || dist == 9)) return true;
      if (aspectingPlanet == 'Saturn' && (dist == 3 || dist == 10)) return true;
      return false;
    }

    // Shloka 1-3: Moon in rashi aspected by planets ΓåÆ results
    // Order: Mars, Mercury, Jupiter, Venus, Saturn, Sun (per Niyama 1 "α▓òα│ìα▓░α▓«α▓╡α▓╛α▓ùα▓┐")
    final ch17RashiResults = <int, Map<String,String>>{
      0: {'Mars':'α▓░α▓╛α▓£','Mercury':'α▓¬α▓éα▓íα▓┐α▓ñ','Jupiter':'α▓░α▓╛α▓£α▓¿ α▓ùα│üα▓úα▓ùα▓│α│üα▓│α│ìα▓│α▓╡α▓¿α│ü','Venus':'α▓òα▓│α│ìα▓│','Saturn':'α▓ªα▓░α▓┐α▓ªα│ìα▓░','Sun':'α▓╕α│çα▓╡α▓ò'},
      1: {'Mars':'α▓ªα▓░α▓┐α▓ªα│ìα▓░','Mercury':'α▓òα▓│α│ìα▓│','Jupiter':'α▓░α▓╛α▓£α▓«α▓╛α▓¿α│ìα▓»','Venus':'α▓░α▓╛α▓£','Saturn':'α▓ºα▓¿α▓╡α▓éα▓ñ','Sun':'α▓╕α│çα▓╡α▓ò'},
      2: {'Mars':'α▓òα▓¼α│ìα▓¼α▓┐α▓úα▓ª α▓╡α│ìα▓»α▓╛α▓¬α▓╛α▓░α▓┐','Mercury':'α▓░α▓╛α▓£','Jupiter':'α▓¬α▓éα▓íα▓┐α▓ñ','Venus':'α▓¿α▓┐α▓░α│ìα▓¡α│Çα▓ñ','Saturn':'α▓¿α│çα▓òα▓╛α▓░','Sun':'α▓ªα▓░α▓┐α▓ªα│ìα▓░'},
      3: {'Mars':'α▓»α│ïα▓º','Mercury':'α▓£α│ìα▓₧α▓╛α▓¿α▓┐','Jupiter':'α▓░α▓╛α▓£','Venus':'α▓òα▓¼α│ìα▓¼α▓┐α▓úα▓ª α▓╡α│ìα▓»α▓╛α▓¬α▓╛α▓░α▓┐','Saturn':'α▓òα▓úα│ìα▓úα▓┐α▓¿ α▓░α│ïα▓ùα▓┐','Sun':'α▓ªα▓░α▓┐α▓ªα│ìα▓░'},
      4: {'Mars':'α▓£α│ìα▓»α│ïα▓ñα▓┐α▓╖α▓┐','Mercury':'α▓ºα▓¿α▓╡α▓éα▓ñ','Jupiter':'α▓░α▓╛α▓£','Venus':'α▓òα│ìα▓╖α│îα▓░α▓┐α▓ò','Saturn':'α▓░α▓╛α▓£','Sun':'α▓¡α│éα▓«α▓╛α▓▓α│Çα▓ò'},
      5: {'Mars':'α▓£α│ìα▓»α│ïα▓ñα▓┐α▓╖α▓┐','Mercury':'α▓ºα▓¿α▓╡α▓éα▓ñ','Jupiter':'α▓░α▓╛α▓£','Venus':'α▓òα│ìα▓╖α│îα▓░α▓┐α▓ò','Saturn':'α▓░α▓╛α▓£','Sun':'α▓¡α│éα▓«α▓╛α▓▓α│Çα▓ò'}, // same as Simha
      6: {'Mars':'α▓░α▓╛α▓£','Mercury':'α▓àα▓òα│ìα▓òα▓╕α▓╛α▓▓α▓┐α▓ù','Jupiter':'α▓╡α│ìα▓»α▓╛α▓¬α▓╛α▓░α▓┐','Venus':'α▓¿α│Çα▓Ü/α▓ªα│üα▓╖α│ìα▓ƒ','Saturn':'α▓¿α│Çα▓Ü/α▓ªα│üα▓╖α│ìα▓ƒ','Sun':'α▓¿α│Çα▓Ü/α▓ªα│üα▓╖α│ìα▓ƒ'},
      7: {'Mars':'α▓░α▓╛α▓£','Mercury':'α▓àα▓ùα▓╕','Jupiter':'α▓àα▓éα▓ùα▓╡α▓┐α▓òα▓▓','Venus':'α▓ªα▓░α▓┐α▓ªα│ìα▓░','Saturn':'α▓░α▓╛α▓£','Sun':'α▓░α▓╛α▓£'},
      8: {'Mars':'α▓ªα▓éα▓¡α▓┐ α▓«α▓ñα│ìα▓ñα│ü α▓╢α▓á','Mercury':'α▓åα▓╢α│ìα▓░α▓» α▓¬α▓íα│åα▓»α│üα▓╡α▓╡α▓¿α│ü','Jupiter':'α▓åα▓╢α│ìα▓░α▓» α▓¬α▓íα│åα▓»α│üα▓╡α▓╡α▓¿α│ü','Venus':'α▓åα▓╢α│ìα▓░α▓» α▓¬α▓íα│åα▓»α│üα▓╡α▓╡α▓¿α│ü','Saturn':'α▓ªα▓éα▓¡α▓┐ α▓«α▓ñα│ìα▓ñα│ü α▓╢α▓á','Sun':'α▓ªα▓éα▓¡α▓┐ α▓«α▓ñα│ìα▓ñα│ü α▓╢α▓á'},
      9: {'Mars':'α▓¼α▓╣α│üα▓ªα│èα▓íα│ìα▓í α▓░α▓╛α▓£','Mercury':'α▓░α▓╛α▓£','Jupiter':'α▓¬α▓éα▓íα▓┐α▓ñ','Venus':'α▓ºα▓¿α▓╡α▓éα▓ñ','Saturn':'α▓ªα▓░α▓┐α▓ªα│ìα▓░','Sun':'α▓░α▓╛α▓£'},
      10:{'Mars':'α▓░α▓╛α▓£','Mercury':'α▓░α▓╛α▓£α▓¿α▓┐α▓ùα│å α▓╕α▓«α▓╛α▓¿','Jupiter':'α▓¬α▓░α▓╕α│ìα▓ñα│ìα▓░α│Ç α▓¿α▓┐α▓░α▓ñ','Venus':'α▓¬α▓╛α▓¬α▓½α▓▓','Saturn':'α▓¬α▓╛α▓¬α▓½α▓▓','Sun':'α▓¬α▓╛α▓¬α▓½α▓▓'},
      11:{'Mars':'α▓¬α▓╛α▓¬α▓òα▓╛α▓░α│ìα▓»','Mercury':'α▓╣α▓╛α▓╕α│ìα▓»α▓ùα▓╛α▓░','Jupiter':'α▓░α▓╛α▓£','Venus':'α▓¬α▓éα▓íα▓┐α▓ñ','Saturn':'α▓¬α▓╛α▓¬α▓òα▓╛α▓░α│ìα▓»','Sun':'α▓¬α▓╛α▓¬α▓òα▓╛α▓░α│ìα▓»'},
    };

    // Check from Moon AND Lagna
    for (final refR in [moonR2, lagRashi]) {
      final refName = refR == moonR2 ? 'α▓Üα▓éα▓ªα│ìα▓░' : 'α▓▓α▓ùα│ìα▓¿';
      final rashiMap = ch17RashiResults[refR];
      if (rashiMap != null) {
        for (final aspector in ['Sun','Mars','Mercury','Jupiter','Venus','Saturn']) {
          if (aspector == 'Moon') continue;
          if (ch17Aspects(aspector, refR)) {
            final res = rashiMap[aspector];
            if (res != null) {
              yogas.add(Yoga(
                shloka: 'α▓Üα▓éα▓ªα│ìα▓░α│ç α▓¡α│éα▓¬α▓¼α│üα▓ºα│ç α▓¿α│âα▓¬α│ï... (α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» α│º-α│⌐)',
                name: '$refName α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓»α│ïα▓ù (α▓ªα│â α│º-α│⌐)',
                description: '${_rashiNames[refR]}α▓ªα▓▓α│ìα▓▓α▓┐α▓░α│üα▓╡ $refNameα▓¿α▓┐α▓ùα│å ${_knPlanets[aspector]} α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
                result: res,
                rashi: refR, planets: [refName, _knPlanets[aspector]!],
              ));
            }
          }
        }
      }
    }

    // Shloka 4-8: Navamsha-based aspect results
    // Planet order per navamsha lord: Mars, Mercury, Jupiter, Venus, Saturn, Sun ΓåÆ 6 results
    final ch17NavResults = <String, List<String>>{
      'Mars':    ['α▓░α▓òα│ìα▓╖α▓ò','α▓╣α▓┐α▓éα▓╕α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓åα▓╕α▓òα│ìα▓ñ','α▓»α│üα▓ªα│ìα▓ºα▓ªα▓▓α│ìα▓▓α▓┐ α▓òα│üα▓╢α▓▓','α▓░α▓╛α▓£','α▓ºα▓¿α▓╡α▓éα▓ñ','α▓£α▓ùα▓│α▓ùα▓éα▓ƒ'],
      'Venus':   ['α▓«α│éα▓░α│ìα▓û','α▓¬α▓░α▓╕α│ìα▓ñα│ìα▓░α│Çα▓░α▓ñ','α▓òα▓╛α▓╡α│ìα▓»α▓£α│ìα▓₧','α▓ëα▓ñα│ìα▓ñα▓« α▓òα▓╛α▓╡α│ìα▓» α▓░α▓Üα▓┐α▓╕α│üα▓╡α▓╡α▓¿α│ü','α▓╕α│üα▓ûα▓╛α▓¬α│çα▓òα│ìα▓╖α▓┐','α▓¬α▓░α▓░ α▓╣α│åα▓éα▓íα▓ñα▓┐α▓»α│èα▓éα▓ªα▓┐α▓ùα│å α▓╕α│çα▓░α│üα▓╡α▓╡α▓¿α│ü'],
      'Mercury': ['α▓░α▓éα▓ùα▓¡α│éα▓«α▓┐α▓» α▓òα▓▓α▓╛α▓╡α▓┐α▓ª','α▓òα▓│α│ìα▓│','α▓╢α│ìα▓░α│çα▓╖α│ìα▓á α▓òα▓╡α▓┐','α▓«α▓éα▓ñα│ìα▓░α▓┐','α▓╕α▓éα▓ùα│Çα▓ñα▓ùα▓╛α▓░','α▓╢α▓┐α▓▓α│ìα▓¬α▓òα▓▓α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓¿α▓┐α▓¬α│üα▓ú'],
      'Moon':    ['α▓╕α▓úα│ìα▓ú α▓╢α▓░α│Çα▓░α▓ªα▓╡α▓¿α│ü','α▓╣α▓úα▓ª α▓åα▓╕α│å α▓ëα▓│α│ìα▓│α▓╡α▓¿α│ü','α▓ñα▓¬α▓╕α│ìα▓╡α▓┐','α▓¬α│ìα▓░α▓«α│üα▓û α▓╡α│ìα▓»α▓òα│ìα▓ñα▓┐','α▓╕α│ìα▓ñα│ìα▓░α│Çα▓»α▓░α▓¿α│ìα▓¿α│ü α▓¬α│ïα▓╖α▓┐α▓╕α│üα▓╡α▓╡α▓¿α│ü','α▓òα▓╛α▓░α│ìα▓»α▓¿α▓┐α▓░α▓ñ'],
      'Sun':     ['α▓òα│ïα▓¬α▓┐α▓╖α│ìα▓ƒ','α▓░α▓╛α▓£α▓¿α▓┐α▓ùα│å α▓¬α│ìα▓░α▓┐α▓»α▓╡α▓╛α▓ªα▓╡α▓¿α│ü','α▓¿α▓┐α▓ºα▓┐α▓ùα│å α▓Æα▓íα│åα▓»','α▓¬α│ìα▓░α▓¡α│ü','α▓«α▓òα│ìα▓òα▓│α▓┐α▓▓α│ìα▓▓α▓ªα▓╡α▓¿α│ü','α▓àα▓ñα▓┐ α▓╣α▓┐α▓éα▓╕α▓╛α▓ñα│ìα▓«α▓ò α▓òα│åα▓▓α▓╕ α▓«α▓╛α▓íα│üα▓╡α▓╡α▓¿α│ü'],
      'Jupiter': ['α▓¬α│ìα▓░α▓╕α▓┐α▓ªα│ìα▓º α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐','α▓»α│üα▓ªα│ìα▓ºα▓ªα▓▓α│ìα▓▓α▓┐ α▓╕α▓▓α▓╣α│å α▓¿α│Çα▓íα│üα▓╡α▓╡α▓¿α│ü','α▓╣α▓╛α▓╕α│ìα▓» α▓¼α▓▓α│ìα▓▓α▓╡α▓¿α│ü','α▓«α▓éα▓ñα│ìα▓░α▓┐','α▓òα▓╛α▓«α▓░α▓╣α▓┐α▓ñ','α▓╡α│âα▓ªα│ìα▓ºα▓░α▓éα▓ñα▓╣ α▓ùα│üα▓úα▓╡α│üα▓│α│ìα▓│α▓╡α▓¿α│ü'],
      'Saturn':  ['α▓òα▓íα▓┐α▓«α│å α▓╕α▓éα▓ñα▓╛α▓¿α▓╡α│üα▓│α│ìα▓│α▓╡α▓¿α│ü','α▓╕α▓éα▓¬α▓ñα│ìα▓ñα▓┐α▓ªα│ìα▓ªα▓░α│é α▓ªα│üα▓âα▓ûα▓┐α▓╕α│üα▓╡α▓╡α▓¿α│ü','α▓«α▓╛α▓¿ α▓╕α▓¿α│ìα▓«α▓╛α▓¿α▓ùα▓│α▓▓α│ìα▓▓α▓┐ α▓åα▓╕α▓òα│ìα▓ñ','α▓ñα▓¿α│ìα▓¿ α▓òα│åα▓▓α▓╕α▓ªα▓▓α│ìα▓▓α▓┐ α▓¿α▓┐α▓░α▓ñ','α▓ªα│üα▓╖α│ìα▓ƒ α▓╕α│ìα▓ñα│ìα▓░α│Çα▓»α▓░α▓¿α│ìα▓¿α│ü α▓çα▓╖α│ìα▓ƒα▓¬α▓íα│üα▓╡α▓╡α▓¿α│ü','α▓£α▓┐α▓¬α│üα▓ú'],
    };

    void evaluateCh17Nav(String targetPlanet, double targetLon) {
      final navRashi = _d9Rashi(targetLon);
      final navLord = rashiLords[navRashi];
      final targetKn = _knPlanets[targetPlanet]!;
      final tRashi = _rashiOf(targetLon);

      final aspectors = targetPlanet == 'Moon'
          ? ['Mars','Mercury','Jupiter','Venus','Saturn','Sun']
          : ['Mars','Mercury','Jupiter','Venus','Saturn','Moon'];

      final results = ch17NavResults[navLord];
      if (results != null) {
        for (int i = 0; i < 6; i++) {
          final aspector = aspectors[i];
          if (ch17Aspects(aspector, tRashi) || (aspector == 'Moon' && _rashiOf(moonLon) == tRashi)) {
            yogas.add(Yoga(
              shloka: 'α▓åα▓░α▓òα│ìα▓╖α▓òα│ï α▓╡α▓ºα▓░α│üα▓Üα▓┐α▓â... (α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» α│¬-α│«)',
              name: 'α▓¿α▓╡α▓╛α▓éα▓╢ α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓»α│ïα▓ù (α▓ªα│â α│¬-α│«)',
              description: '${_knPlanets[navLord]} α▓¿α▓╡α▓╛α▓éα▓╢α▓ªα▓▓α│ìα▓▓α▓┐α▓░α│üα▓╡ $targetKnα▓¿α▓┐α▓ùα│å ${_knPlanets[aspector]} α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
              result: results[i],
              rashi: tRashi, planets: [targetKn, _knPlanets[aspector]!],
            ));
          }
        }
      }
    }

    // Shloka 4-8: Navamsha aspects for Moon and Sun (Shloka 8: α▓Üα▓éα▓ªα│ìα▓░α│ç α▓¡α▓╛α▓¿α│î α▓ñα▓ªα│ìα▓╡α▓ªα│ì)
    evaluateCh17Nav('Moon', moonLon);
    evaluateCh17Nav('Sun', sun);


    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // Chapter 18: α▓¡α▓╛α▓╡α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» (Bhavaphaladhyaya - Results of Planets in Houses)
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

    int getBhava(int pRashi, int lagR) => ((pRashi - lagR) % 12) + 1;

    // --- Shloka 1-3: Sun in houses ---
    final ch18SunR = _rashiOf(sun);
    final ch18SunH = getBhava(ch18SunR, lagRashi);
    String sunRes = '';
    if (ch18SunH == 1) {
      if (ch18SunR == 0) sunRes = 'α▓ºα▓¿α▓╡α▓éα▓ñ α▓«α▓ñα│ìα▓ñα│ü α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓ªα│ïα▓╖α▓╡α│üα▓│α│ìα▓│α▓╡α▓¿α│ü';
      else if (ch18SunR == 4) sunRes = 'α▓░α▓╛α▓ñα│ìα▓░α▓┐α▓»α▓▓α│ìα▓▓α▓┐ α▓òα▓úα│ìα▓úα│ü α▓òα▓╛α▓úα▓┐α▓╕α▓ªα▓╡α▓¿α│ü';
      else if (ch18SunR == 3) sunRes = 'α▓ùα│üα▓│α│ìα▓│α│åα▓ùα▓│α▓éα▓ñα▓╣ α▓òα▓úα│ìα▓úα│üα▓│α│ìα▓│α▓╡α▓¿α│ü';
      else sunRes = 'α▓╢α│éα▓░, α▓£α▓íα▓╕α│ìα▓╡α▓¡α▓╛α▓╡α▓ªα▓╡α▓¿α│ü, α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓ªα│ïα▓╖α▓╡α│üα▓│α│ìα▓│α▓╡α▓¿α│ü, α▓òα▓░α│üα▓úα│åα▓»α▓┐α▓▓α│ìα▓▓α▓ªα▓╡α▓¿α│ü';
    } else if (ch18SunH == 2) sunRes = 'α▓¼α▓╣α▓│ α▓╕α▓éα▓¬α▓ñα│ìα▓ñα│üα▓│α│ìα▓│α▓╡α▓¿α│ü, α▓░α▓╛α▓£α▓¿α▓┐α▓éα▓ª α▓ºα▓¿ α▓¿α▓╖α│ìα▓ƒ, α▓«α│üα▓ûα▓ª α▓░α│ïα▓ù';
    else if (ch18SunH == 3) sunRes = 'α▓¼α│üα▓ªα│ìα▓ºα▓┐α▓╡α▓éα▓ñ α▓«α▓ñα│ìα▓ñα│ü α▓¬α▓░α▓╛α▓òα│ìα▓░α▓«α▓┐';
    else if (ch18SunH == 4) sunRes = 'α▓╕α│üα▓ûα▓╡α▓┐α▓▓α│ìα▓▓α▓ªα▓╡α▓¿α│ü, α▓«α▓╛α▓¿α▓╕α▓┐α▓ò α▓¬α│Çα▓íα│å';
    else if (ch18SunH == 5) sunRes = 'α▓«α▓òα│ìα▓òα▓│α▓┐α▓▓α│ìα▓▓α▓ªα▓╡α▓¿α│ü α▓«α▓ñα│ìα▓ñα│ü α▓ºα▓¿α▓╣α│Çα▓¿';
    else if (ch18SunH == 6) sunRes = 'α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐, α▓╢α▓ñα│ìα▓░α│üα▓ùα▓│α▓¿α│ìα▓¿α│ü α▓╕α│ïα▓▓α▓┐α▓╕α│üα▓╡α▓╡α▓¿α│ü';
    else if (ch18SunH == 7) sunRes = 'α▓╕α│ìα▓ñα│ìα▓░α│Çα▓»α▓░α▓┐α▓éα▓ª α▓àα▓╡α▓«α▓╛α▓¿';
    else if (ch18SunH == 8) sunRes = 'α▓òα▓íα▓┐α▓«α│å α▓«α▓òα│ìα▓òα▓│α│ü, α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓ªα│ïα▓╖';
    else if (ch18SunH == 9) sunRes = 'α▓«α▓òα│ìα▓òα▓│α│ü, α▓╣α▓ú α▓«α▓ñα│ìα▓ñα│ü α▓╕α│üα▓û';
    else if (ch18SunH == 10) sunRes = 'α▓╢α▓╛α▓╕α│ìα▓ñα│ìα▓░α▓£α│ìα▓₧α▓╛α▓¿ α▓«α▓ñα│ìα▓ñα│ü α▓╢α│îα▓░α│ìα▓»';
    else if (ch18SunH == 11) sunRes = 'α▓¼α▓╣α▓│ α▓ºα▓¿α▓╡α▓éα▓ñ';
    else if (ch18SunH == 12) sunRes = 'α▓¬α▓ñα▓┐α▓ñα▓¿α▓╛α▓ùα│üα▓ñα│ìα▓ñα▓╛α▓¿α│å';
    if (sunRes.isNotEmpty) {
      yogas.add(Yoga(
        shloka: 'α▓╢α│éα▓░α▓â α▓╕α│ìα▓ñα▓¼α│ìα▓º α▓╡α▓┐α▓òα▓▓α▓¿α▓»α▓¿α│ï... (α▓¡α▓╛α▓╡α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» α│º-α│⌐)',
        name: 'α▓╕α│éα▓░α│ìα▓» α▓¡α▓╛α▓╡ α▓½α▓▓ (${ch18SunH}α▓¿α│ç α▓«α▓¿α│å)',
        description: '${ch18SunH}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓╕α│éα▓░α│ìα▓» (${_rashiNames[ch18SunR]})',
        result: sunRes, rashi: ch18SunR, planets: ['α▓░α▓╡α▓┐'],
      ));
    }

    // --- Shloka 4-5: Moon in houses ---
    final ch18MoonR = _rashiOf(moonLon);
    final ch18MoonH = getBhava(ch18MoonR, lagRashi);
    // Moon's own rashi = Cancer(3), exalted = Taurus(1)
    String moonRes = '';
    if (ch18MoonH == 1) {
      if (ch18MoonR == 3 || ch18MoonR == 1) moonRes = 'α▓ºα▓¿α▓╡α▓éα▓ñ α▓«α▓ñα│ìα▓ñα│ü α▓¼α▓╣α▓│ α▓«α▓òα│ìα▓òα▓│α│üα▓│α│ìα▓│α▓╡α▓¿α│ü';
      else moonRes = 'α▓«α│éα▓ù, α▓╣α│üα▓Üα│ìα▓Ü, α▓£α▓íα▓¼α│üα▓ªα│ìα▓ºα▓┐, α▓òα│üα▓░α│üα▓í, α▓¿α│Çα▓Ü, α▓òα▓┐α▓╡α│üα▓í, α▓╕α│çα▓╡α▓ò';
    } else if (ch18MoonH == 2) moonRes = 'α▓ºα▓¿α▓╡α▓éα▓ñ, α▓ªα│èα▓íα│ìα▓í α▓òα│üα▓ƒα│üα▓éα▓¼';
    else if (ch18MoonH == 3) moonRes = 'α▓╣α▓┐α▓éα▓╕α▓òα▓¿α▓╛α▓ùα│üα▓ñα│ìα▓ñα▓╛α▓¿α│å';
    else if (ch18MoonH == 4 || ch18MoonH == 5) moonRes = 'α▓åα▓»α▓╛ α▓¡α▓╛α▓╡α▓ùα▓│α▓┐α▓ùα│å α▓╕α▓éα▓¼α▓éα▓ºα▓┐α▓╕α▓┐α▓ª α▓ëα▓ñα│ìα▓ñα▓« α▓½α▓▓α▓ùα▓│α│ü';
    else if (ch18MoonH == 6) moonRes = 'α▓àα▓¿α│çα▓ò α▓╢α▓ñα│ìα▓░α│üα▓ùα▓│α│ü, α▓«α│âα▓ªα│ü α▓╢α▓░α│Çα▓░, α▓òα▓╛α▓«α▓╛α▓ñα│üα▓░, α▓åα▓▓α▓╕α▓┐';
    else if (ch18MoonH == 7) moonRes = 'α▓àα▓╕α│éα▓»α│å α▓¬α▓íα│üα▓╡α▓╡α▓¿α│ü, α▓╕α│ìα▓ñα│ìα▓░α│Çα▓»α▓░α▓▓α│ìα▓▓α▓┐ α▓åα▓╕α▓òα│ìα▓ñ';
    else if (ch18MoonH == 8) moonRes = 'α▓¼α│üα▓ªα│ìα▓ºα▓┐α▓╡α▓éα▓ñ, α▓░α│ïα▓ùα▓ªα▓┐α▓éα▓ª α▓¬α│Çα▓íα▓┐α▓ñ';
    else if (ch18MoonH == 9) moonRes = 'α▓╕α│îα▓¡α▓╛α▓ùα│ìα▓», α▓«α▓òα│ìα▓òα▓│α│ü, α▓«α▓┐α▓ñα│ìα▓░α▓░α│ü, α▓¼α▓éα▓ºα│üα▓ùα▓│α│ü, α▓ºα▓¿';
    else if (ch18MoonH == 10) moonRes = 'α▓ºα▓░α│ìα▓«, α▓ºα▓¿, α▓¼α│üα▓ªα│ìα▓ºα▓┐, α▓╢α│îα▓░α│ìα▓», α▓òα▓╛α▓░α│ìα▓»α▓╕α▓┐α▓ªα│ìα▓ºα▓┐';
    else if (ch18MoonH == 11) moonRes = 'α▓¬α│ìα▓░α▓╕α▓┐α▓ªα│ìα▓º, α│ºα│ºα▓¿α│ç α▓¡α▓╛α▓╡α▓ª α▓ùα│üα▓úα▓ùα▓│α│ü';
    else if (ch18MoonH == 12) moonRes = 'α▓¿α│Çα▓Ü α▓«α▓ñα│ìα▓ñα│ü α▓àα▓éα▓ùα▓╣α│Çα▓¿';
    if (moonRes.isNotEmpty) {
      yogas.add(Yoga(
        shloka: 'α▓«α│éα▓òα│ïα▓¿α│ìα▓«α▓ñα│ìα▓ñα▓£α▓íα▓╛α▓éα▓ºα▓¿α│Çα▓Ü... (α▓¡α▓╛α▓╡α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» α│¬-α│½)',
        name: 'α▓Üα▓éα▓ªα│ìα▓░ α▓¡α▓╛α▓╡ α▓½α▓▓ (${ch18MoonH}α▓¿α│ç α▓«α▓¿α│å)',
        description: '${ch18MoonH}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓Üα▓éα▓ªα│ìα▓░ (${_rashiNames[ch18MoonR]})',
        result: moonRes, rashi: ch18MoonR, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }

    // --- Shloka 6: Mars in houses ---
    final ch18MarsR = _rashiOf(mars);
    final ch18MarsH = getBhava(ch18MarsR, lagRashi);
    String marsRes = '';
    if (ch18MarsH == 1) marsRes = 'α▓ùα▓╛α▓»α▓ùα│èα▓éα▓í α▓╢α▓░α│Çα▓░α▓╡α│üα▓│α│ìα▓│α▓╡α▓¿α│ü';
    else if (ch18MarsH == 2) marsRes = 'α▓òα│åα▓ƒα│ìα▓ƒ α▓àα▓¿α│ìα▓¿α▓╡α▓¿α│ìα▓¿α│ü α▓ñα▓┐α▓¿α│ìα▓¿α│üα▓╡α▓╡α▓¿α│ü';
    else if (ch18MarsH == 9) marsRes = 'α▓¬α▓╛α▓¬α▓òα▓╛α▓░α│ìα▓» α▓«α▓╛α▓íα│üα▓╡α▓╡α▓¿α│ü';
    else marsRes = 'α▓╕α│éα▓░α│ìα▓»α▓¿α▓éα▓ñα│åα▓»α│ç α▓½α▓▓: $sunRes';
    if (marsRes.isNotEmpty) {
      yogas.add(Yoga(
        shloka: 'α▓▓α▓ùα│ìα▓¿ α▓òα│üα▓£α│ç α▓òα│ìα▓╖α▓ñα▓ñα▓¿α│üα▓░α│ìα▓ºα▓¿α▓ùα│ç... (α▓¡α▓╛α▓╡α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» α│¼)',
        name: 'α▓òα│üα▓£ α▓¡α▓╛α▓╡ α▓½α▓▓ (${ch18MarsH}α▓¿α│ç α▓«α▓¿α│å)',
        description: '${ch18MarsH}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓òα│üα▓£ (${_rashiNames[ch18MarsR]})',
        result: marsRes, rashi: ch18MarsR, planets: ['α▓òα│üα▓£'],
      ));
    }

    // --- Shloka 6: Mercury in houses ---
    final ch18MercR = _rashiOf(mer);
    final ch18MercH = getBhava(ch18MercR, lagRashi);
    final mercResults = <int,String>{1:'α▓╡α▓┐α▓ªα│ìα▓╡α▓╛α▓éα▓╕',2:'α▓ºα▓¿α▓╡α▓éα▓ñ',3:'α▓¬α│ìα▓░α▓¼α▓▓',4:'α▓¬α▓éα▓íα▓┐α▓ñ',5:'α▓«α▓éα▓ñα│ìα▓░α▓┐',6:'α▓╢α▓ñα│ìα▓░α│üα▓╡α▓┐α▓▓α│ìα▓▓α▓ªα▓╡α▓¿α│ü',7:'α▓╣α▓╛α▓╕α│ìα▓» α▓¼α▓▓α│ìα▓▓α▓╡α▓¿α│ü'};
    String mercRes = '';
    if (ch18MercH == 8) mercRes = 'α▓╕α│éα▓░α│ìα▓»α▓¿α▓éα▓ñα│åα▓»α│ç α▓½α▓▓: $sunRes';
    else mercRes = mercResults[ch18MercH] ?? 'α▓¬α│ìα▓░α▓╕α▓┐α▓ªα│ìα▓º α▓ùα│üα▓úα▓╡α│üα▓│α│ìα▓│α▓╡α▓¿α│ü';
    yogas.add(Yoga(
      shloka: 'α▓╡α▓┐α▓ªα│ìα▓╡α▓╛α▓¿α│ì α▓ºα▓¿α│Ç α▓¬α│ìα▓░α▓¼α▓▓α▓¬α▓éα▓íα▓┐α▓ñα▓«α▓éα▓ñα│ìα▓░α│ìα▓»... (α▓¡α▓╛α▓╡α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» α│¼)',
      name: 'α▓¼α│üα▓º α▓¡α▓╛α▓╡ α▓½α▓▓ (${ch18MercH}α▓¿α│ç α▓«α▓¿α│å)',
      description: '${ch18MercH}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓¼α│üα▓º (${_rashiNames[ch18MercR]})',
      result: mercRes, rashi: ch18MercR, planets: ['α▓¼α│üα▓º'],
    ));

    // --- Shloka 7: Jupiter in houses ---
    final ch18JupR = _rashiOf(jup);
    final ch18JupH = getBhava(ch18JupR, lagRashi);
    final jupResults = <int,String>{
      1:'α▓╡α▓┐α▓ªα│ìα▓╡α▓╛α▓éα▓╕',2:'α▓Æα▓│α│ìα▓│α│åα▓» α▓«α▓╛α▓ñα│üα▓ùα▓╛α▓░',3:'α▓£α▓┐α▓¬α│üα▓ú',4:'α▓╕α│üα▓ûα▓┐',5:'α▓¼α│üα▓ªα│ìα▓ºα▓┐α▓╡α▓éα▓ñ',
      6:'α▓╢α▓ñα│ìα▓░α│üα▓╡α▓┐α▓▓α│ìα▓▓α▓ªα▓╡α▓¿α│ü',7:'α▓ñα▓éα▓ªα│åα▓ùα▓┐α▓éα▓ñ α▓╢α│ìα▓░α│çα▓╖α│ìα▓á',8:'α▓¿α│Çα▓Ü',9:'α▓ñα▓¬α▓╕α│ìα▓╡α▓┐',
      10:'α▓ºα▓¿α▓╡α▓éα▓ñ',11:'α▓▓α▓╛α▓¡α▓╡α│üα▓│α│ìα▓│α▓╡α▓¿α│ü',12:'α▓ªα│üα▓╖α│ìα▓ƒ'
    };
    final jupRes = jupResults[ch18JupH] ?? '';
    if (jupRes.isNotEmpty) {
      yogas.add(Yoga(
        shloka: 'α▓╡α▓┐α▓ªα│ìα▓╡α▓╛α▓¿α│ì α▓╕α│üα▓╡α▓╛α▓òα│ìα▓»α▓â α▓òα│âα▓¬α▓úα▓â... (α▓¡α▓╛α▓╡α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» α│¡)',
        name: 'α▓ùα│üα▓░α│ü α▓¡α▓╛α▓╡ α▓½α▓▓ (${ch18JupH}α▓¿α│ç α▓«α▓¿α│å)',
        description: '${ch18JupH}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓ùα│üα▓░α│ü (${_rashiNames[ch18JupR]})',
        result: jupRes, rashi: ch18JupR, planets: ['α▓ùα│üα▓░α│ü'],
      ));
    }

    // --- Shloka 8: Venus in houses ---
    final ch18VenR = _rashiOf(ven);
    final ch18VenH = getBhava(ch18VenR, lagRashi);
    String venRes = '';
    if (ch18VenH == 1) venRes = 'α▓òα▓╛α▓«α▓òα▓╛α▓░α│ìα▓»α▓ªα▓▓α│ìα▓▓α▓┐ α▓¿α▓┐α▓¬α│üα▓ú, α▓╕α│üα▓ûα▓┐';
    else if (ch18VenH == 5) venRes = 'α▓╕α│üα▓ûα▓┐';
    else if (ch18VenH == 7) venRes = 'α▓£α▓ùα▓│α▓ùα▓éα▓ƒ, α▓░α▓ñα▓┐α▓òα│ìα▓░α│Çα▓íα│åα▓»α▓▓α│ìα▓▓α▓┐ α▓åα▓╕α▓òα│ìα▓ñ';
    else venRes = '${jupResults[ch18VenH] ?? 'α▓ùα│üα▓░α│üα▓╡α▓┐α▓¿α▓éα▓ñα│å α▓½α▓▓'}, α▓ºα▓¿α▓╡α▓éα▓ñ';
    yogas.add(Yoga(
      shloka: 'α▓╕α│ìα▓«α▓░α▓¿α▓┐α▓¬α│üα▓ú: α▓╕α│üα▓ûα▓╡α▓╛α▓éα▓╢α│ìα▓Ü... (α▓¡α▓╛α▓╡α▓½α▓▓α▓╛α▓ºα│ìα▓»α▓╛α▓» α│«)',
      name: 'α▓╢α│üα▓òα│ìα▓░ α▓¡α▓╛α▓╡ α▓½α▓▓ (${ch18VenH}α▓¿α│ç α▓«α▓¿α│å)',
      description: '${ch18VenH}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓╢α│üα▓òα│ìα▓░ (${_rashiNames[ch18VenR]})',
      result: venRes, rashi: ch18VenR, planets: ['α▓╢α│üα▓òα│ìα▓░'],
    ));

    // --- Shloka 9: Saturn in houses ---
    final ch18SatR = _rashiOf(sat);
    final ch18SatH = getBhava(ch18SatR, lagRashi);
    // Saturn own: Capricorn(9), Aquarius(10). Exalted: Libra(6). Jupiter's: Sagittarius(8), Pisces(11)
    String satRes = '';
    if (ch18SatH == 1) {
      final satInGoodSign = {6,8,9,10,11}.contains(ch18SatR); // own/exalted/Jupiter's
      if (satInGoodSign) {
        satRes = 'α▓░α▓╛α▓£α▓¿α▓┐α▓ùα│å α▓╕α▓«α▓╛α▓¿, α▓ùα│ìα▓░α▓╛α▓«/α▓¿α▓ùα▓░ α▓Æα▓íα│åα▓», α▓╡α▓┐α▓ªα│ìα▓╡α▓╛α▓éα▓╕, α▓╕α│üα▓éα▓ªα▓░ α▓╢α▓░α│Çα▓░';
      } else {
        satRes = 'α▓ªα▓░α▓┐α▓ªα│ìα▓░, α▓░α│ïα▓ùα▓┐, α▓òα▓╛α▓«α▓╛α▓ñα│üα▓░, α▓«α▓▓α▓┐α▓¿, α▓¼α▓╛α▓▓α│ìα▓» α▓░α│ïα▓ù, α▓åα▓▓α▓╕ α▓«α▓╛α▓ñα│ü';
      }
    } else {
      satRes = 'α▓╕α│éα▓░α│ìα▓»α▓¿α▓éα▓ñα│åα▓»α│ç α▓½α▓▓: $sunRes';
    }
    yogas.add(Yoga(
