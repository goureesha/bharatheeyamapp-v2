    // ΓòÉΓòÉΓòÉ JK Shloka 19: House type from strongest planet ΓòÉΓòÉΓòÉ
    final jk19HouseMap = <String, String>{
      'Saturn': 'α▓╣α▓│α│åα▓»/α▓ªα│üα▓░α▓╕α│ìα▓ñα▓┐ α▓«α▓¿α│å', 'Mars': 'α▓╕α│üα▓ƒα│ìα▓ƒ α▓«α▓¿α│å', 'Moon': 'α▓╣α│èα▓╕ α▓«α▓¿α│å',
      'Sun': 'α▓«α▓░α▓ª/α▓ùα▓ƒα│ìα▓ƒα▓┐α▓»α▓┐α▓▓α│ìα▓▓α▓ª α▓«α▓¿α│å', 'Mercury': 'α▓╢α▓┐α▓▓α│ìα▓¬α▓òα▓▓α│å α▓«α▓¿α│å',
      'Venus': 'α▓╕α│üα▓éα▓ªα▓░/α▓Üα▓┐α▓ñα│ìα▓░α▓ùα▓│ α▓╣α│èα▓╕ α▓«α▓¿α│å', 'Jupiter': 'α▓ùα▓ƒα│ìα▓ƒα▓┐α▓»α▓╛α▓ª α▓«α▓¿α│å',
    };
    String jk19Strongest = 'Jupiter';
    for (final e in allPLons.entries) {
      if (isStrong(e.key)) { jk19Strongest = e.key; break; }
    }
    yogas.add(Yoga(
      shloka: 'α▓£α│Çα▓░α│ìα▓úα▓é α▓╕α▓éα▓╕α│ìα▓òα│âα▓ñα▓«α▓░α│ìα▓òα▓£α│ç α▓òα│ìα▓╖α▓┐α▓ñα▓┐α▓╕α│üα▓ñα│ç α▓ªα▓ùα│ìα▓ºα▓é α▓¿α▓╡α▓é α▓╢α│Çα▓ñα▓ùα│î',
      name: 'α▓╣α│åα▓░α▓┐α▓ùα│å α▓«α▓¿α│å α▓╕α│ìα▓╡α▓░α│éα▓¬ (α▓£α▓ò α│ºα│»)',
      description: 'α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐: ${_knPlanets[jk19Strongest]} ΓåÆ ${jk19HouseMap[jk19Strongest]}',
