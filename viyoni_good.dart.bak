      yogas.add(Yoga(shloka: 'α▓Üα▓éα▓ªα│ìα▓░α│ç α▓òα▓░α│ìα▓òα▓ƒα▓╡α│âα▓╢α│ìα▓Üα▓┐α▓òα▓╛α▓éα▓╢α▓òα▓ùα▓ñα│ç... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│¡)', name: 'α▓ùα│üα▓╣α│ìα▓»α▓░α│ïα▓ù α▓»α│ïα▓ù (α▓à α│¡)', description: 'α▓Üα▓éα▓ªα│ìα▓░ α▓òα▓░α│ìα▓òα▓ƒ/α▓╡α│âα▓╢α│ìα▓Üα▓┐α▓ò α▓¿α▓╡α▓╛α▓éα▓╢ + α▓¬α▓╛α▓¬ α▓»α│üα▓ñ', result: 'α▓ùα│üα▓╣α│ìα▓»α▓░α│ïα▓ù', rashi: ch21Moon, planets: ['α▓Üα▓éα▓ªα│ìα▓░']));
