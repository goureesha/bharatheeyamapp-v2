        if ({'Jupiter','Venus','Mercury'}.contains(e.key) && (_rashiOf(e.value) + 6) % 12 == lagRashi) jk14BenAsp = true;
      }
      yogas.add(Yoga(
        shloka: 'α▓¬α▓╛α▓¬α│çα▓òα│ìα▓╖α▓┐α▓ñα│ç α▓ñα│üα▓╣α▓┐α▓¿α▓ùα▓╛α▓╡α│üα▓ªα▓»α│ç α▓òα│üα▓£α│çsα▓╕α│ìα▓ñα│ç α▓ñα│ìα▓»α▓òα│ìα▓òα│ï α▓╡α▓┐α▓¿α▓╢α│ìα▓»α▓ñα▓┐',
