    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // Chapter 21: α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛α▓ºα│ìα▓»α▓╛α▓»
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    final ch21Ven = _rashiOf(ven);
    final ch21Sun = _rashiOf(sun);
    final ch21Moon = _rashiOf(moonLon);
    final ch21Mars = _rashiOf(mars);
    final ch21Sat = _rashiOf(sat);
    final ch21Jup = _rashiOf(jup);
    final ch21Mer = _rashiOf(mer);
    final ch21Rahu = _rashiOf(rahu);
    final ch21Ketu = _rashiOf(ketu);

    // Shloka 1: 5th/7th shubha check
    for (final refName in ['α▓▓α▓ùα│ìα▓¿', 'α▓Üα▓éα▓ªα│ìα▓░']) {
      final refR = refName == 'α▓▓α▓ùα│ìα▓¿' ? lagRashi : ch21Moon;
      final h5 = (refR + 4) % 12;
      final h7 = (refR + 6) % 12;
      final shIn5 = ch21Jup == h5 || ch21Ven == h5 || ch21Mer == h5;
      final shIn7 = ch21Jup == h7 || ch21Ven == h7 || ch21Mer == h7;
      if (shIn5 || shIn7) {
        yogas.add(Yoga(
          shloka: 'α▓▓α▓ùα│ìα▓¿α▓╛α▓ñα│ìα▓¬α│üα▓ñα│ìα▓░α▓òα▓▓α▓ñα│ìα▓░α▓¡α│ç... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│º)',
          name: 'α▓¬α│üα▓ñα│ìα▓░-α▓òα▓▓α▓ñα│ìα▓░ α▓╕α│üα▓û α▓»α│ïα▓ù (α▓à α│º)',
          description: '${refName}α▓ªα▓┐α▓éα▓ª ${shIn5 ? "5α▓¿α│ç" : "7α▓¿α│ç"} α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓╢α│üα▓¡α▓ùα│ìα▓░α▓╣',
          result: 'α▓«α▓òα│ìα▓òα▓│α│ü α▓«α▓ñα│ìα▓ñα│ü α▓╣α│åα▓éα▓íα▓ñα▓┐α▓»α▓┐α▓éα▓ª α▓╕α│üα▓û',
          rashi: refR, planets: [refName],
        ));
      }
    }
    if (lagRashi == 5 && ch21Sun == 5 && ch21Sat == 11) {
      yogas.add(Yoga(shloka: 'α▓¬α▓╛α▓░α│ìα▓Ñα│ïα▓¿α│ïα▓ªα▓»α▓ùα│ç α▓░α▓╡α│î... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│º)', name: 'α▓ªα▓╛α▓░ α▓╣α▓╛α▓¿α▓┐ α▓»α│ïα▓ù (α▓à α│º)', description: 'α▓òα▓¿α│ìα▓»α▓╛ α▓▓α▓ùα│ìα▓¿+α▓░α▓╡α▓┐, α▓«α│Çα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ α▓╢α▓¿α▓┐', result: 'α▓╣α│åα▓éα▓íα▓ñα▓┐α▓» α▓«α▓░α▓ú', rashi: lagRashi, planets: ['α▓░α▓╡α▓┐','α▓╢α▓¿α▓┐']));
    }
    if (getBhava(ch21Mars, lagRashi) == 5) {
      yogas.add(Yoga(shloka: 'α▓¬α│üα▓ñα│ìα▓░α▓╕α│ìα▓Ñα▓╛α▓¿α▓ùα▓ñα▓╢α│ìα▓Ü... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│º)', name: 'α▓¬α│üα▓ñα│ìα▓░ α▓╣α▓╛α▓¿α▓┐ α▓»α│ïα▓ù (α▓à α│º)', description: 'α▓òα│üα▓£ 5α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐', result: 'α▓«α▓òα│ìα▓òα▓│ α▓«α▓░α▓ú/α▓òα▓╖α│ìα▓ƒ', rashi: ch21Mars, planets: ['α▓òα│üα▓£']));
    }
    // Shloka 2: Venus hemmed
    final ch21VenH = getBhava(ch21Ven, lagRashi);
    final v4 = (ch21Ven+3)%12; final v8 = (ch21Ven+7)%12;
    final p4 = ch21Sun==v4||ch21Mars==v4||ch21Sat==v4||ch21Rahu==v4||ch21Ketu==v4;
    final p8 = ch21Sun==v8||ch21Mars==v8||ch21Sat==v8||ch21Rahu==v8||ch21Ketu==v8;
    final vn=(ch21Ven+1)%12; final vp=(ch21Ven+11)%12;
    final hm=(ch21Sun==vn||ch21Mars==vn||ch21Sat==vn)&&(ch21Sun==vp||ch21Mars==vp||ch21Sat==vp);
    final sv = ch21Jup==ch21Ven||ch21Mer==ch21Ven;
    if ((p4&&p8||hm)&&!sv) {
      yogas.add(Yoga(shloka: 'α▓ëα▓ùα│ìα▓░α▓ùα│ìα▓░α▓╣α│ê:... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│¿)', name: 'α▓£α▓╛α▓»α▓╛ α▓╡α▓º α▓»α│ïα▓ù (α▓à α│¿)', description: 'α▓╢α│üα▓òα│ìα▓░α▓¿α▓┐α▓éα▓ª 4/8α▓░α▓▓α│ìα▓▓α▓┐ α▓¬α▓╛α▓¬, α▓╢α│üα▓¡α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓çα▓▓α│ìα▓▓', result: 'α▓╣α│åα▓éα▓íα▓ñα▓┐α▓ùα│å α▓àα▓¬α▓╛α▓»', rashi: ch21Ven, planets: ['α▓╢α│üα▓òα│ìα▓░']));
    }
    // Shloka 3
    final ch21SunH = getBhava(ch21Sun, lagRashi); final ch21MoonH = getBhava(ch21Moon, lagRashi);
    if ((ch21SunH==12&&ch21MoonH==6)||(ch21SunH==6&&ch21MoonH==12)) {
      yogas.add(Yoga(shloka: 'α▓▓α▓ùα│ìα▓¿α▓╛α▓ªα│ì α▓╡α│ìα▓»α▓»α▓╛α▓░α▓┐α▓ùα▓ñα▓»α│ïα▓â... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│⌐)', name: 'α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓ªα│ïα▓╖ α▓»α│ïα▓ù (α▓à α│⌐)', description: 'α▓╕α│éα▓░α│ìα▓»+α▓Üα▓éα▓ªα│ìα▓░ 12/6α▓░α▓▓α│ìα▓▓α▓┐', result: 'α▓ªα│âα▓╖α│ìα▓ƒα▓┐α▓ªα│ïα▓╖', rashi: ch21Sun, planets: ['α▓░α▓╡α▓┐','α▓Üα▓éα▓ªα│ìα▓░']));
    }
    if (ch21Ven==ch21Sun) { final cH=getBhava(ch21Sun,lagRashi); if(cH==7||cH==5||cH==9) {
      yogas.add(Yoga(shloka: 'α▓╢α│üα▓òα│ìα▓░α▓╛α▓░α│ìα▓òα▓»α│ïα▓░α│ìα▓╡α▓┐α▓òα▓▓... (α▓àα▓¿α▓┐α▓╖α│ìα▓ƒα▓»α│ïα▓ùα▓╛ α│⌐)', name: 'α▓╡α▓┐α▓òα▓▓ α▓ªα▓╛α▓░ α▓»α│ïα▓ù (α▓à α│⌐)', description: 'α▓╕α│éα▓░α│ìα▓»+α▓╢α│üα▓òα│ìα▓░ ${cH}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐', result: 'α▓╡α▓┐α▓òα▓▓α▓╛α▓éα▓ù α▓╣α│åα▓éα▓íα▓ñα▓┐', rashi: ch21Sun, planets: ['α▓░α▓╡α▓┐','α▓╢α│üα▓òα│ìα▓░']));
    }}
