    // ΓòÉΓòÉΓòÉ JK Shloka 14: Abandoned & perishes / survives ΓòÉΓòÉΓòÉ
    final jk14MoonLag = moonR2 == lagRashi;
    final jk14MarsIn7 = ((marsR - lagRashi) % 12) + 1 == 7;
    final jk14MarsSatLag = marsR == lagRashi && satR2 == lagRashi;
