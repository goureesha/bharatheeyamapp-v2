    // Chapter 14: α▓ªα│ìα▓╡α▓┐α▓ùα│ìα▓░α▓╣α▓»α│ïα▓ùα▓╛α▓ºα│ìα▓»α▓╛α▓» (Dvigraha Yogadhyaya - Two-planet combinations)
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

    bool dyAreTogether(String p1, String p2) {
      if (!allPLons.containsKey(p1) || !allPLons.containsKey(p2)) return false;
      return _rashiOf(allPLons[p1]!) == _rashiOf(allPLons[p2]!);
    }
    
    int dyTogetherRashi(String p1, String p2) {
      return _rashiOf(allPLons[p1]!);
    }

