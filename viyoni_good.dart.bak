    final jk21H6 = ((lagRashi + 5) % 12);
    final jk21H8 = ((lagRashi + 7) % 12);
    final jk21H9 = ((lagRashi + 8) % 12);
    final jk21H12 = ((lagRashi + 11) % 12);
    yogas.add(Yoga(
      shloka: 'α▓¬α│ìα▓░α▓╛α▓Üα│ìα▓»α▓╛α▓ªα▓┐α▓ùα│âα▓╣α│ç α▓òα│ìα▓░α▓┐α▓»α▓╛α▓ªα▓»α│ï α▓òα│ïα▓úα▓ùα▓ñα▓╛ α▓ªα│ìα▓╡α▓┐α▓«α│éα▓░α│ìα▓ñα▓»α▓â',
      name: 'α▓╣α▓╛α▓╕α▓┐α▓ùα│å α▓¬α▓╛α▓ª α▓»α│ïα▓ù (α▓£α▓ò α│¿α│º)',
      description: 'α▓¬α▓╛α▓ª α▓ªα▓┐α▓òα│ìα▓òα│ü: ${_rashiNames[jk21H6]},${_rashiNames[jk21H8]},${_rashiNames[jk21H9]},${_rashiNames[jk21H12]}',
      result: 'α▓╣α▓╛α▓╕α▓┐α▓ùα│å: ${jk20DirMap[jk21H6] ?? "α▓¬α│éα▓░α│ìα▓╡"} α▓¬α▓╛α▓ª',
      rashi: lagRashi, planets: [],
    ));

    // ΓòÉΓòÉΓòÉ JK Shloka 22: Attendants at birth ΓòÉΓòÉΓòÉ
    int jk22Count = 0;
    final jk22Visible = <String>[];
    final jk22Hidden = <String>[];
    for (final e in allPLons.entries) {
      final eR = _rashiOf(e.value);
      final fromLag = (eR - lagRashi) % 12;
      final fromMoon = (eR - moonR2) % 12;
      if (fromLag > 0 && fromLag < (moonR2 - lagRashi) % 12 || fromMoon > 0 && fromMoon < (lagRashi - moonR2) % 12) {
        jk22Count++;
        final hFL = (eR - lagRashi) % 12;
        if (hFL >= 1 && hFL <= 6) {
          jk22Visible.add(_knPlanets[e.key]!);
        } else {
          jk22Hidden.add(_knPlanets[e.key]!);
        }
      }
    }
    yogas.add(Yoga(
      shloka: 'α▓Üα▓éα▓ªα│ìα▓░α▓▓α▓ùα│ìα▓¿α▓╛α▓éα▓ñα▓░α▓ùα▓ñα│êα▓ùα│ìα▓░α│ìα▓░α▓╣α│êα▓â α▓╕α│ìα▓»α│üα▓░α│üα▓¬α▓╕α│éα▓ñα▓┐α▓òα▓╛α▓â',
      name: 'α▓ëα▓¬α▓╕α│éα▓ñα▓┐α▓òα▓╛ α▓»α│ïα▓ù (α▓£α▓ò α│¿α│¿)',
      description: '$jk22Count α▓╣α│åα▓éα▓ùα▓╕α▓░α│ü${jk22Visible.isNotEmpty ? "\nα▓╣α│èα▓░α▓ùα│å: ${jk22Visible.join(",")}" : ""}${jk22Hidden.isNotEmpty ? "\nα▓Æα▓│α▓ùα│å: ${jk22Hidden.join(",")}" : ""}',
      result: '$jk22Count α▓╣α│åα▓éα▓ùα▓╕α▓░α│ü α▓╣α│åα▓░α▓┐α▓ùα│å α▓òα│ïα▓úα│åα▓»α▓▓α│ìα▓▓α▓┐',
      rashi: lagRashi, planets: [],
    ));

    // ΓòÉΓòÉΓòÉ JK Shloka 23: Body & color of child ΓòÉΓòÉΓòÉ
    final jk23LagNavLord = rashiLords[_d9Rashi(lag)];
    final jk23MoonNavLord = rashiLords[_d9Rashi(moonLon)];
    final jk23ColorMap = <String, String>{
      'Sun': 'α▓òα│åα▓éα▓¬α│ü', 'Moon': 'α▓¼α▓┐α▓│α▓┐', 'Mars': 'α▓òα│åα▓éα▓¬α│ü', 'Mercury': 'α▓╣α▓╕α▓┐α▓░α│ü',
      'Jupiter': 'α▓╣α│èα▓éα▓¼α▓úα│ìα▓ú', 'Venus': 'α▓¼α▓┐α▓│α▓┐/α▓╣α│èα▓│α│åα▓»α│üα▓╡', 'Saturn': 'α▓òα▓¬α│ìα▓¬α│ü',
    };
    yogas.add(Yoga(
      shloka: 'α▓▓α▓ùα│ìα▓¿α▓¿α▓╡α▓╛α▓éα▓╢α▓¬α▓ñα│üα▓▓α│ìα▓»α▓ñα▓¿α│üα▓╕α│ìα▓╕α▓╛α▓ªα│ìα▓╡α│Çα▓░α│ìα▓»α▓»α│üα▓ñα▓ùα│ìα▓░α▓╣α▓ñα│üα▓▓α│ìα▓»α▓ñα▓¿α│üα▓░α│ìα▓╡α▓╛',
      name: 'α▓╢α▓┐α▓╢α│ü α▓╢α▓░α│Çα▓░/α▓¼α▓úα│ìα▓ú (α▓£α▓ò α│¿α│⌐)',
      description: 'α▓╢α▓░α│Çα▓░: ${_knPlanets[jk23LagNavLord]} α▓░α│Çα▓ñα▓┐\nα▓¼α▓úα│ìα▓ú: ${_knPlanets[jk23MoonNavLord]} ΓåÆ ${jk23ColorMap[jk23MoonNavLord] ?? ""}',
      result: '${jk23ColorMap[jk23MoonNavLord] ?? ""} α▓¼α▓úα│ìα▓úα▓ª α▓╢α▓┐α▓╢α│ü',
      rashi: lagRashi, planets: [_knPlanets[jk23LagNavLord]!, _knPlanets[jk23MoonNavLord]!],
    ));

    // ΓòÉΓòÉΓòÉ JK Shloka 24: Body parts mapping (informational) ΓòÉΓòÉΓòÉ
    yogas.add(Yoga(
      shloka: 'α▓òα▓é α▓ªα│âα▓òα│ìα▓¢α│çα▓ñα│ìα▓░α▓¿α▓╕α▓╛α▓òα▓¬α│ïα▓▓α▓╣α▓¿α▓╡α│ï α▓╡α▓╕α│ìα▓ñα│ìα▓░α▓é α▓Ü α▓╣α│ïα▓░α▓╛α▓ªα▓»',
      name: 'α▓ªα│çα▓╣α▓╛α▓éα▓ù α▓░α▓╛α▓╢α▓┐ α▓«α│ìα▓»α▓╛α▓¬α│ì (α▓£α▓ò α│¿α│¬)',
      description: '1-α▓ñα▓▓α│å, 2-α▓òα▓úα│ìα▓úα│ü, 3-α▓òα▓┐α▓╡α▓┐, 4-α▓«α│éα▓ùα│ü, 5-α▓òα│åα▓¿α│ìα▓¿α│å, 6-α▓ªα▓╡α▓íα│å\n7-α▓¼α▓╛α▓»α▓┐, 8-α▓òα│üα▓ñα│ìα▓ñα▓┐α▓ùα│å, 9-α▓¡α│üα▓£, 10-α▓ñα│ïα▓│α│ü, 11-α▓¬α▓╛α▓░α│ìα▓╢α│ìα▓╡, 12-α▓Äα▓ªα│å',
      result: 'α▓ªα│çα▓╣α▓╛α▓éα▓ù α▓░α▓╛α▓╢α▓┐ α▓╕α▓éα▓¼α▓éα▓º',
      rashi: lagRashi, planets: [],
    ));

    // ΓòÉΓòÉΓòÉ JK Shloka 25: Wound or mole marks ΓòÉΓòÉΓòÉ
    for (final e in allPLons.entries) {
      final pRashi = _rashiOf(e.value);
      final pDrekNum = _drekkanaNum(e.value); // 1, 2, or 3 based on degree
      final pDrekRashi = (pRashi + (pDrekNum - 1) * 4) % 12;
      // Check if this drekkana falls within lagna's 3 drekkanas
      for (int drek = 0; drek < 3; drek++) {
        final lagDrekR = (lagRashi + drek * 4) % 12;
        if (pDrekRashi == lagDrekR) {
          final isMal = {'Sun','Mars','Saturn','Rahu','Ketu'}.contains(e.key);
          final inOwnNav = _d9Rashi(e.value) == pRashi;
          final isSthira25 = pDrekRashi == 1 || pDrekRashi == 4 || pDrekRashi == 7 || pDrekRashi == 10;
          final markType = isMal ? 'α▓ùα▓╛α▓» α▓ùα│üα▓░α│üα▓ñα│ü' : 'α▓«α▓Üα│ìα▓Üα│å';
          final origin = (inOwnNav || isSthira25) ? 'α▓╣α│üα▓ƒα│ìα▓ƒα▓┐α▓¿α▓┐α▓éα▓ª' : 'α▓¿α▓éα▓ñα▓░';
          yogas.add(Yoga(
            shloka: 'α▓ñα▓╕α│ìα▓«α▓┐α▓¿α│ì α▓¬α▓╛α▓¬α▓»α│üα▓ñα│ç α▓╡α│ìα▓░α▓úα▓â α▓╢α│üα▓¡α▓»α│üα▓ñα│ç α▓ªα│âα▓╖α│ìα▓ƒα│ç α▓▓α▓òα│ìα▓╖α▓╛α▓ªα▓┐α▓╢α│çα▓ñα│ì',
            name: '$markType (α▓£α▓ò α│¿α│½)',
            description: '${_knPlanets[e.key]} ${_rashiNames[pRashi]} ${pDrekNum}α▓¿α│ç α▓ªα│ìα▓░α│çα▓òα│ìα▓òα▓╛α▓ú (${_rashiNames[pDrekRashi]})\n$origin α▓¼α▓éα▓ª $markType',
            result: '$origin $markType',
            rashi: pDrekRashi, planets: [_knPlanets[e.key]!],
          ));
          break;
        }
      }
    }

    // ΓòÉΓòÉΓòÉ JK Shloka 26: Cause of wound ΓòÉΓòÉΓòÉ
    final jk26CauseMap = <String, String>{
      'Saturn': 'α▓òα▓▓α│ìα▓▓α│ü/α▓ùα▓╛α▓│α▓┐', 'Mars': 'α▓¼α│åα▓éα▓òα▓┐/α▓╢α▓╕α│ìα▓ñα│ìα▓░/α▓╡α▓┐α▓╖', 'Mercury': 'α▓«α▓úα│ìα▓úα│ü',
      'Sun': 'α▓òα▓ƒα│ìα▓ƒα▓┐α▓ùα│å/α▓¬α│ìα▓░α▓╛α▓úα▓┐', 'Moon': 'α▓òα│èα▓éα▓¼α│ü α▓¬α│ìα▓░α▓╛α▓úα▓┐/α▓¿α│Çα▓░α│ü',
    };
    for (final e in malLons.entries) {
      if (jk26CauseMap.containsKey(e.key)) {
        final hFLag = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
        if (hFLag == 1 || hFLag == 6) {
          yogas.add(Yoga(
            shloka: 'α▓«α▓éα▓ªα│çsα▓╕α│ìα▓«α▓╛α▓¿α▓┐α▓▓α▓£α│ïsα▓ùα│ìα▓¿α▓┐α▓╢α▓╕α│ìα▓ñα│ìα▓░α▓╡α▓┐α▓╖α▓£α│ï α▓¡α│îα▓«α│ç α▓¼α│üα▓ºα│ç α▓¡α│éα▓¡α▓╡α▓â',
            name: 'α▓ùα▓╛α▓» α▓òα▓╛α▓░α▓ú (α▓£α▓ò α│¿α│¼)',
            description: '${_knPlanets[e.key]} ${hFLag}α▓¿α│ç α▓«α▓¿α│å ΓåÆ ${jk26CauseMap[e.key]}',
            result: '${jk26CauseMap[e.key]}α▓ªα▓┐α▓éα▓ª α▓ùα▓╛α▓»',
            rashi: _rashiOf(e.value), planets: [_knPlanets[e.key]!],
          ));
        }
      }
    }

    // ΓòÉΓòÉΓòÉ JK Shloka 27: Multiple marks when 3+ planets with Mercury ΓòÉΓòÉΓòÉ
    final jk27MerR = _rashiOf(mer);
    int jk27WithMer = 0;
    for (final e in allPLons.entries) {
      if (e.key != 'Mercury' && _rashiOf(e.value) == jk27MerR) jk27WithMer++;
    }
    if (jk27WithMer >= 3) {
      yogas.add(Yoga(
        shloka: 'α▓╕α▓«α▓¿α│üα▓¬α▓ñα▓┐α▓ñα▓╛ α▓»α▓╕α│ìα▓«α▓┐α▓¿α│ì α▓ùα▓╛α▓╡α│ï α▓ñα│ìα▓░α▓»α▓â α▓╕α▓¼α│üα▓ºα▓╛ α▓ùα│ìα▓░α▓╣α▓╛',
        name: 'α▓¼α▓╣α│ü α▓ùα│üα▓░α│üα▓ñα│ü α▓»α│ïα▓ù (α▓£α▓ò α│¿α│¡)',
        description: '$jk27WithMer α▓ùα│ìα▓░α▓╣α▓░α│ü α▓¼α│üα▓ºα▓¿α│èα▓éα▓ªα▓┐α▓ùα│å ${_rashiNames[jk27MerR]} α▓░α▓╛α▓╢α▓┐α▓»α▓▓α│ìα▓▓α▓┐',
        result: 'α▓ªα│çα▓╣α▓ªα▓▓α│ìα▓▓α▓┐ α▓ûα▓Üα▓┐α▓ñ α▓ùα│üα▓░α│üα▓ñα│üα▓ùα▓│α│ü',
        rashi: jk27MerR, planets: ['α▓¼α│üα▓º'],
      ));
    }

    // ΓòÉΓòÉΓòÉ JK Shloka 28: Wound in 6th house / Mole in lagna ΓòÉΓòÉΓòÉ
    for (final e in malLons.entries) {
      final hFLag28 = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
      if (hFLag28 == 6) {
        bool jk28BenAsp = false;
        for (final b in allPLons.entries) {
          if ({'Jupiter','Venus','Mercury'}.contains(b.key) && (_rashiOf(b.value) + 6) % 12 == _rashiOf(e.value)) jk28BenAsp = true;
        }
        yogas.add(Yoga(
          shloka: 'α▓╡α│ìα▓░α▓úα▓òα│âα▓ªα│üα▓╢α│üα▓¡α▓â α▓╖α▓╖α│ìα▓ƒα│ç α▓▓α▓ùα│ìα▓¿α▓╛α▓ñα│ì α▓ñα▓¿α│î α▓¡α▓╕α▓«α▓╛α▓╢α│ìα▓░α▓┐α▓ñα│ç',
          name: '${jk28BenAsp ? "α▓«α▓Üα│ìα▓Üα│å" : "α▓ùα▓╛α▓»"} α▓»α│ïα▓ù (α▓£α▓ò α│¿α│«)',
          description: '${_knPlanets[e.key]} 6α▓¿α│ç α▓«α▓¿α│å${jk28BenAsp ? " + α▓╢α│üα▓¡ α▓ªα│âα▓╖α│ìα▓ƒα▓┐ ΓåÆ α▓«α▓Üα│ìα▓Üα│å" : " ΓåÆ α▓ùα▓╛α▓»"}',
          result: jk28BenAsp ? 'α▓å α▓¡α▓╛α▓ùα▓ªα▓▓α│ìα▓▓α▓┐ α▓«α▓Üα│ìα▓Üα│å' : 'α▓å α▓¡α▓╛α▓ùα▓ªα▓▓α│ìα▓▓α▓┐ α▓ùα▓╛α▓»',
          rashi: _rashiOf(e.value), planets: [_knPlanets[e.key]!],
        ));
        break;
      }
    }

    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // Chapter 6: α▓àα▓░α▓┐α▓╖α│ìα▓ƒα▓╛α▓ºα│ìα▓»α▓╛α▓» (Arishtadhyaya - Yogas for infant mortality)
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

    // ΓòÉΓòÉΓòÉ AR Shloka 1: Infant mortality in Sandhya & Hora ΓòÉΓòÉΓòÉ
    final ar1MoonInLag = moonR2 == lagRashi;
    bool ar1MalInKendra = false;
    for (final e in malLons.entries) {
      final h = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
      if (h == 1 || h == 4 || h == 7 || h == 10) {
        ar1MalInKendra = true;
        break;
      }
    }
    if (ar1MoonInLag && ar1MalInKendra) {
      yogas.add(Yoga(
        shloka: 'α▓╕α▓éα▓ºα│ìα▓»α▓╛α▓»α▓╛α▓é α▓╣α▓┐α▓«α▓ªα│Çα▓ºα▓┐α▓ñα▓┐α▓╣α│ïα▓░α▓╛ α▓¬α▓╛α▓¬α│êα▓░α│ìα▓¡α▓╛α▓éα▓ñα▓ùα▓ñα│êα▓░α│ìα▓¿α▓┐α▓ºα▓¿α▓╛α▓»',
        name: 'α▓àα▓░α▓┐α▓╖α│ìα▓ƒ α▓»α│ïα▓ù (α▓àα▓░α▓┐ α│º)',
        description: 'α▓▓α▓ùα│ìα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ α▓Üα▓éα▓ªα│ìα▓░ + α▓òα│çα▓éα▓ªα│ìα▓░α▓ªα▓▓α│ìα▓▓α▓┐ α▓¬α▓╛α▓¬α▓ùα│ìα▓░α▓╣α▓░α│ü',
        result: 'α▓╢α▓┐α▓╢α│üα▓╡α▓┐α▓¿ α▓«α▓░α▓ú/α▓¿α▓╛α▓╢',
        rashi: lagRashi, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉ AR Shloka 2: Scorpio Lagna & Malefics in East/West ΓòÉΓòÉΓòÉ
    bool ar2MalIn2 = false, ar2MalIn12 = false, ar2MalIn6 = false, ar2MalIn8 = false;
    for (final e in malLons.entries) {
      final h = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
      if (h == 2) ar2MalIn2 = true;
      if (h == 12) ar2MalIn12 = true;
      if (h == 6) ar2MalIn6 = true;
      if (h == 8) ar2MalIn8 = true;
    }
    final ar2PapakartariLagna = ar2MalIn2 && ar2MalIn12;
    final ar2Papakartari7 = ar2MalIn6 && ar2MalIn8;
    if (ar2PapakartariLagna && ar2Papakartari7) {
      yogas.add(Yoga(
        shloka: 'α▓Üα▓òα│ìα▓░α▓╕α│ìα▓» α▓¬α│éα▓░α│ìα▓╡α│çα▓ñα▓░α▓¡α▓╛α▓ùα▓ùα│çα▓╖α│ü α▓òα│ìα▓░α│éα▓░α│çα▓╖α│ü α▓╕α│îα▓«α│ìα▓»α▓╖α│ü α▓Ü α▓òα│Çα▓ƒα▓▓α▓¿α│ìα▓¿α│ç',
        name: 'α▓ëα▓¡α▓» α▓¬α▓╛α▓¬α▓òα▓░α│ìα▓ñα▓░α▓┐ α▓»α│ïα▓ù (α▓àα▓░α▓┐ α│¿)',
        description: 'α▓▓α▓ùα│ìα▓¿ (12, 2) α▓«α▓ñα│ìα▓ñα│ü 7α▓¿α│ç α▓«α▓¿α│åα▓» (6, 8) α▓Äα▓░α▓íα│é α▓òα▓íα│å α▓¬α▓╛α▓¬α▓ùα│ìα▓░α▓╣α▓░α│ü',
        result: 'α▓╢α│Çα▓ÿα│ìα▓░ α▓«α▓░α▓ú',
        rashi: lagRashi, planets: [],
      ));
    }

    // ΓòÉΓòÉΓòÉ AR Shloka 3: Mars in Lagna without benefic aspect + Saturn in 6/8 ΓòÉΓòÉΓòÉ
    final ar3MarsInLag = marsR == lagRashi;
    bool ar3BenAspLag = false;
    for (final e in allPLons.entries) {
      if ({'Jupiter', 'Venus', 'Mercury'}.contains(e.key)) {
        if ((_rashiOf(e.value) + 6) % 12 == lagRashi) ar3BenAspLag = true;
      }
    }
    final ar3SatH = ((satR2 - lagRashi) % 12) + 1;
    final ar3SatIn68 = ar3SatH == 6 || ar3SatH == 8;
