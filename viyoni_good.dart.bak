          name: 'α▓Üα▓éα▓ªα│ìα▓░ α▓▓α▓ùα│ìα▓¿ α▓¬α▓╛α▓¬ α▓àα▓░α▓┐α▓╖α│ìα▓ƒ (α▓àα▓░α▓┐ α│»)',
          description: 'α▓Üα▓éα▓ªα│ìα▓░ α▓▓α▓ùα│ìα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ + 7α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓¬α▓╛α▓¬α▓ùα│ìα▓░α▓╣α▓░α│ü',
          result: 'α▓«α▓░α▓ú',
          rashi: lagRashi, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
        ));
    }

    // ΓòÉΓòÉΓòÉ AR Shloka 10: Eclipsed Moon + Malefic + Mars in 8th ΓòÉΓòÉΓòÉ
    final ar10MoonRahu = moonR2 == _rashiOf(allPLons['Rahu']!) || moonR2 == _rashiOf(allPLons['Ketu']!);
    bool ar10MarsIn8 = ((marsR - lagRashi) % 12) + 1 == 8;
    if (ar10MoonRahu && ar4MoonWithMal && ar10MarsIn8) {
       yogas.add(Yoga(
          shloka: 'α▓àα▓╢α│üα▓¡α▓╕α▓╣α▓┐α▓ñα│ç α▓ùα│ìα▓░α▓╕α│ìα▓ñ α▓Üα▓éα▓ªα│ìα▓░ α▓òα│üα▓£α│ç α▓¿α▓┐α▓ºα▓¿α▓╛α▓╢α│ìα▓░α▓┐α▓ñα│ç',
          name: 'α▓«α▓╛α▓ñα│â-α▓╢α▓┐α▓╢α│ü α▓«α▓░α▓ú α▓»α│ïα▓ù (α▓àα▓░α▓┐ α│ºα│ª)',
          description: 'α▓ùα│ìα▓░α▓╣α▓ú α▓Üα▓éα▓ªα│ìα▓░ α▓¬α▓╛α▓¬α▓¿α│èα▓éα▓ªα▓┐α▓ùα│å + α▓òα│üα▓£ 8α▓░α▓▓α│ìα▓▓α▓┐',
          result: 'α▓ñα▓╛α▓»α▓┐-α▓«α▓ùα│ü α▓çα▓¼α│ìα▓¼α▓░ α▓«α▓░α▓ú',
          rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£'],
        ));
       if (sunR == lagRashi) {
         yogas.add(Yoga(
            shloka: 'α▓▓α▓ùα│ìα▓¿ α▓░α▓ªα│î α▓ñα│ü α▓╕ α▓╢α▓╕α│ìα▓ñα│ìα▓░α▓£α▓â',
            name: 'α▓╢α▓╕α│ìα▓ñα│ìα▓░ α▓«α▓░α▓ú α▓»α│ïα▓ù (α▓àα▓░α▓┐ α│ºα│ª)',
            description: 'α▓ùα│ìα▓░α▓╣α▓ú α▓Üα▓éα▓ªα│ìα▓░ + α▓òα│üα▓£ 8α▓░α▓▓α│ìα▓▓α▓┐ + α▓▓α▓ùα│ìα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ α▓░α▓╡α▓┐',
            result: 'α▓╢α▓╕α│ìα▓ñα│ìα▓░α▓ªα▓┐α▓éα▓ª α▓«α▓░α▓ú',
            rashi: lagRashi, planets: ['α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£'],
          ));
       }
    }
    if (sunR == lagRashi || moonR2 == lagRashi) {
      bool ar10StrongMalInTri = false;
      bool ar10StrongMalIn8 = false;
      for (final e in malLons.entries) {
        if (isStrong(e.key)) {
          final h = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
          if (h == 5 || h == 9) ar10StrongMalInTri = true;
          if (h == 8) ar10StrongMalIn8 = true;
        }
      }
      if (ar10StrongMalInTri && ar10StrongMalIn8) {
         bool ar10BenAsp = false;
         for (final e in allPLons.entries) {
           if ({'Jupiter', 'Venus', 'Mercury'}.contains(e.key)) {
             final h = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
             if (h == 1 || (_rashiOf(e.value) + 6) % 12 == lagRashi) ar10BenAsp = true;
           }
         }
         if (!ar10BenAsp) {
           yogas.add(Yoga(
            shloka: 'α▓ëα▓ªα▓»α▓ñα▓┐ α▓░α▓╡α│î α▓╢α│Çα▓ñα▓╛α▓éα▓╢α│î α▓╡α▓╛ α▓ñα│ìα▓░α▓┐α▓òα│ïα▓úα▓╡α▓┐α▓¿α▓╛α▓╢α▓ùα│êΓÇª',
            name: 'α▓▓α▓ùα│ìα▓¿ α▓░α▓╡α▓┐/α▓Üα▓éα▓ªα│ìα▓░ α▓àα▓░α▓┐α▓╖α│ìα▓ƒ (α▓àα▓░α▓┐ α│ºα│ª)',
            description: 'α▓▓α▓ùα│ìα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ α▓░α▓╡α▓┐/α▓Üα▓éα▓ªα│ìα▓░ + α▓ñα│ìα▓░α▓┐α▓òα│ïα▓ú, 8α▓░α▓▓α│ìα▓▓α▓┐ α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐ α▓¬α▓╛α▓¬α▓░α│ü + α▓╢α│üα▓¡ α▓ªα│âα▓╖α│ìα▓ƒα▓┐/α▓»α│ïα▓ù α▓çα▓▓α│ìα▓▓',
            result: 'α▓«α▓░α▓ú',
            rashi: lagRashi, planets: ['α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░'],
          ));
         }
      }
    }

    // ΓòÉΓòÉΓòÉ AR Shloka 11: Saturn, Sun, Moon, Mars in 12, 9, 1, 8 ΓòÉΓòÉΓòÉ
    final ar11Sat12 = ((satR2 - lagRashi) % 12) + 1 == 12;
    final ar11Sun9 = ((sunR - lagRashi) % 12) + 1 == 9;
    final ar11Moon1 = moonR2 == lagRashi;
    final ar11Mars8 = ((marsR - lagRashi) % 12) + 1 == 8;
    if (ar11Sat12 && ar11Sun9 && ar11Moon1 && ar11Mars8) {
      final ar11JupAsp = (_rashiOf(jup) + 6) % 12 == lagRashi || (_rashiOf(jup) + 4) % 12 == lagRashi || (_rashiOf(jup) + 8) % 12 == lagRashi;
      if (!ar11JupAsp || !isStrong('Jupiter')) {
        yogas.add(Yoga(
            shloka: 'α▓àα▓╕α▓┐α▓ñα▓░α▓╡α▓┐α▓╢α▓╢α▓╛α▓éα▓òα▓¡α│éα▓«α▓┐α▓Üα│êα▓░α│ìα▓╡α│ìα▓»α▓»α▓¿α▓╡α▓«α│ïα▓ªα▓»α▓¿α│êα▓ºα▓¿α▓╛α▓╢α│ìα▓░α▓┐α▓ñα│ê:',
            name: 'α▓Üα▓ñα│üα▓░α│ìα▓ùα│ìα▓░α▓╣ α▓àα▓░α▓┐α▓╖α│ìα▓ƒ α▓»α│ïα▓ù (α▓àα▓░α▓┐ α│ºα│º)',
            description: 'α▓╢α▓¿α▓┐(12), α▓░α▓╡α▓┐(9), α▓Üα▓éα▓ªα│ìα▓░(1), α▓òα│üα▓£(8) + α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐ α▓ùα│üα▓░α│ü α▓ªα│âα▓╖α│ìα▓ƒα▓┐ α▓çα▓▓α│ìα▓▓',
            result: 'α▓╢α│Çα▓ÿα│ìα▓░ α▓«α▓░α▓ú',
            rashi: lagRashi, planets: ['α▓╢α▓¿α▓┐', 'α▓░α▓╡α▓┐', 'α▓Üα▓éα▓ªα│ìα▓░', 'α▓òα│üα▓£'],
          ));
      }
    }

    // ΓòÉΓòÉΓòÉ AR Shloka 12: Moon with malefic in 5/7/9/12/1/8 ΓòÉΓòÉΓòÉ
    final ar12MoonInBad = [5, 7, 9, 12, 1, 8].contains(ar5MoonH);
    if (ar12MoonInBad && ar4MoonWithMal) {
       bool ar12StrongBenAsp = false;
       for (final e in allPLons.entries) {
         if ({'Jupiter', 'Venus', 'Mercury'}.contains(e.key) && isStrong(e.key)) {
           if (_rashiOf(e.value) == moonR2 || (_rashiOf(e.value) + 6) % 12 == moonR2) ar12StrongBenAsp = true;
         }
       }
       if (!ar12StrongBenAsp) {
          yogas.add(Yoga(
            shloka: 'α▓╕α│üα▓ñα▓«α▓ªα▓¿α▓╡α▓«α▓╛α▓éα▓ñα│ìα▓»α▓▓α▓ùα│ìα▓¿α▓░α▓éα▓ºα│çα▓╖α│ìα▓ƒα▓╢α│üα▓¡α▓»α│üα▓ñα│ï α▓«α▓░α▓úα▓╛α▓» α▓╢α│Çα▓ñα▓░α▓â',
            name: 'α▓Üα▓éα▓ªα│ìα▓░ α▓¬α▓╛α▓¬ α▓»α│ïα▓ù (α▓àα▓░α▓┐ α│ºα│¿)',
            description: 'α▓Üα▓éα▓ªα│ìα▓░ α▓¬α▓╛α▓¬α▓¿α│èα▓éα▓ªα▓┐α▓ùα│å ${ar5MoonH}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ + α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐ α▓╢α│üα▓òα│ìα▓░/α▓¼α│üα▓º/α▓ùα│üα▓░α│ü α▓ªα│âα▓╖α│ìα▓ƒα▓┐/α▓»α│ïα▓ù α▓çα▓▓α│ìα▓▓',
            result: 'α▓«α▓░α▓ú',
            rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
          ));
       }
    }

    // ΓòÉΓòÉΓòÉ AR Shloka 13: Strong Moon in own house or Lagna with malefic aspect ΓòÉΓòÉΓòÉ
    final ar13MoonStrong = isStrong('Moon');
    final ar13MoonInOwn = moonR2 == 3;
    final ar13MoonInLag = moonR2 == lagRashi;
    if (ar13MoonStrong && (ar13MoonInOwn || ar13MoonInLag)) {
       bool ar13MalAsp = false;
       for (final e in malLons.entries) {
         if ((_rashiOf(e.value) + 6) % 12 == moonR2) ar13MalAsp = true;
       }
       if (ar13MalAsp) {
          yogas.add(Yoga(
            shloka: 'α▓»α│ïα▓ùα│ç α▓╕α│ìα▓Ñα▓╛α▓¿α▓é α▓ùα▓ñα▓╡α▓ñα▓┐ α▓¼α▓▓α▓┐α▓¿α▓╢α│ìα▓Üα▓éα▓ªα│ìα▓░α│å α▓╕α│ìα▓╡α▓é α▓╡α▓╛ α▓ñα▓¿α│üα▓ùα│âα▓╣α▓«α▓Ñα▓╡α▓╛',
            name: 'α▓¼α▓▓α▓┐α▓╖α│ìα▓á α▓Üα▓éα▓ªα│ìα▓░ α▓àα▓░α▓┐α▓╖α│ìα▓ƒ (α▓àα▓░α▓┐ α│ºα│⌐)',
            description: 'α▓¼α▓▓α▓╢α▓╛α▓▓α▓┐ α▓Üα▓éα▓ªα│ìα▓░ α▓╕α│ìα▓╡α▓òα│ìα▓╖α│çα▓ñα│ìα▓░/α▓▓α▓ùα│ìα▓¿α▓ªα▓▓α│ìα▓▓α▓┐ + α▓¬α▓╛α▓¬ α▓ªα│âα▓╖α│ìα▓ƒα▓┐',
            result: 'α▓Æα▓éα▓ªα│ü α▓╡α▓░α│ìα▓╖α▓ªα│èα▓│α▓ùα│å α▓«α▓░α▓ú',
            rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
          ));
       }
    }

    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ
    // Chapter 13: α▓Üα▓╛α▓éα▓ªα│ìα▓░α▓»α│ïα▓ùα▓╛α▓ºα│ìα▓»α▓╛α▓» (Chandrayogadhyaya - Lunar Yogas)
    // ΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉΓòÉ

    // ΓòÉΓòÉΓòÉ CY Shloka 1: Moon in Kendra/Panaphara/Apoklima from Sun ΓòÉΓòÉΓòÉ
    final cy1MoonFromSunH = ((moonR2 - sunR) % 12) + 1;
    String cy1Phala = '';
    if (cy1MoonFromSunH == 1 || cy1MoonFromSunH == 4 || cy1MoonFromSunH == 7 || cy1MoonFromSunH == 10) {
      cy1Phala = 'α▓àα▓ºα▓«';
    } else if (cy1MoonFromSunH == 2 || cy1MoonFromSunH == 5 || cy1MoonFromSunH == 8 || cy1MoonFromSunH == 11) {
      cy1Phala = 'α▓╕α▓«';
    } else {
      cy1Phala = 'α▓╡α▓░α▓┐α▓╖α│ìα▓á';
    }
    
    // Day birth vs Night birth
    final cy1SunFromLagH = ((sunR - lagRashi) % 12) + 1;
    final cy1IsDay = cy1SunFromLagH >= 7 && cy1SunFromLagH <= 12;
    
    final cy1MoonNavLord = rashiLords[_d9Rashi(moonLon)];
    final cy1MoonNavOwnOrMitra = cy1MoonNavLord == 'Moon' || {'Sun', 'Mercury'}.contains(cy1MoonNavLord); 
    
    bool cy1JupAsp = (_rashiOf(jup) + 6) % 12 == moonR2 || (_rashiOf(jup) + 4) % 12 == moonR2 || (_rashiOf(jup) + 8) % 12 == moonR2;
    bool cy1VenAsp = (_rashiOf(ven) + 6) % 12 == moonR2;
    
    String cy1WealthPhala = '';
    if (cy1IsDay && cy1MoonNavOwnOrMitra && cy1JupAsp) {
      cy1WealthPhala = '\nα▓╣α▓ùα▓▓α│ü α▓£α▓¿α▓¿ + α▓ùα│üα▓░α│ü α▓ªα│âα▓╖α│ìα▓ƒα▓┐ ΓåÆ α▓ºα▓¿α▓╡α▓éα▓ñ α▓«α▓ñα│ìα▓ñα│ü α▓╕α│üα▓ûα▓┐';
    } else if (!cy1IsDay && cy1VenAsp) {
      cy1WealthPhala = '\nα▓░α▓╛α▓ñα│ìα▓░α▓┐ α▓£α▓¿α▓¿ + α▓╢α│üα▓òα│ìα▓░ α▓ªα│âα▓╖α│ìα▓ƒα▓┐ ΓåÆ α▓ºα▓¿α▓╡α▓éα▓ñ α▓«α▓ñα│ìα▓ñα│ü α▓╕α│üα▓ûα▓┐';
    }

    yogas.add(Yoga(
      shloka: 'α▓àα▓ºα▓«α▓╕α▓«α▓╡α▓░α▓┐α▓╖α│ìα▓áα▓╛α▓¿α│ìα▓»α▓░α│ìα▓òα▓òα│çα▓éα▓ªα│ìα▓░α▓╛α▓ªα▓┐α▓╕α▓éα▓╕α│ìα▓Ñα│å α▓╢α▓╢α▓┐α▓¿α▓┐ α▓╡α▓┐α▓¿α▓»α▓╡α▓┐α▓ñα│ìα▓ñα▓£α│ìα▓₧α▓╛α▓¿α▓ºα│Çα▓¿α│êα▓¬α│üα▓úα▓╛α▓¿α▓┐',
      name: 'α▓Üα▓éα▓ªα│ìα▓░-α▓░α▓╡α▓┐ α▓»α│ïα▓ù (α▓Üα▓╛ α│º)',
      description: 'α▓Üα▓éα▓ªα│ìα▓░α▓¿α│ü α▓░α▓╡α▓┐α▓»α▓┐α▓éα▓ª $cy1MoonFromSunHα▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ ($cy1Phala α▓╕α│ìα▓Ñα▓╛α▓¿)$cy1WealthPhala',
      result: '$cy1Phala α▓½α▓▓: α▓╡α▓┐α▓¿α▓», α▓╡α▓┐α▓ñα│ìα▓ñ, α▓£α│ìα▓₧α▓╛α▓¿, α▓¿α│êα▓¬α│üα▓úα│ìα▓»',
      rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░', 'α▓░α▓╡α▓┐'],
    ));

    // ΓòÉΓòÉΓòÉ CY Shloka 2: Adhi Yoga (Benefics in 6, 7, 8 from Moon AND Lagna) ΓòÉΓòÉΓòÉ
    bool cy2BenIn6M = false, cy2BenIn7M = false, cy2BenIn8M = false;
    bool cy2BenIn6L = false, cy2BenIn7L = false, cy2BenIn8L = false;
    for (final e in allPLons.entries) {
      if ({'Jupiter', 'Venus', 'Mercury'}.contains(e.key)) {
        final hM = ((_rashiOf(e.value) - moonR2) % 12) + 1;
        if (hM == 6) cy2BenIn6M = true;
        if (hM == 7) cy2BenIn7M = true;
        if (hM == 8) cy2BenIn8M = true;
        final hL = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
        if (hL == 6) cy2BenIn6L = true;
        if (hL == 7) cy2BenIn7L = true;
        if (hL == 8) cy2BenIn8L = true;
      }
    }
    if (cy2BenIn6M || cy2BenIn7M || cy2BenIn8M || cy2BenIn6L || cy2BenIn7L || cy2BenIn8L) {
       final details = <String>[];
       if (cy2BenIn6M || cy2BenIn7M || cy2BenIn8M) {
         final mH = <String>[];
         if (cy2BenIn6M) mH.add('6');
         if (cy2BenIn7M) mH.add('7');
         if (cy2BenIn8M) mH.add('8');
         details.add('α▓Üα▓éα▓ªα│ìα▓░α▓¿α▓┐α▓éα▓ª ${mH.join(",")}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓╢α│üα▓¡α▓ùα│ìα▓░α▓╣α▓░α│ü');
       }
       if (cy2BenIn6L || cy2BenIn7L || cy2BenIn8L) {
         final lH = <String>[];
         if (cy2BenIn6L) lH.add('6');
         if (cy2BenIn7L) lH.add('7');
         if (cy2BenIn8L) lH.add('8');
         details.add('α▓▓α▓ùα│ìα▓¿α▓ªα▓┐α▓éα▓ª ${lH.join(",")}α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐ α▓╢α│üα▓¡α▓ùα│ìα▓░α▓╣α▓░α│ü');
       }
       yogas.add(Yoga(
        shloka: 'α▓╕α│îα▓«α│ìα▓» α▓╕α│ìα▓«α▓░α▓╛α▓░α▓┐α▓¿α▓┐α▓ºα▓¿α│çα▓╖α│ìα▓ƒα▓ºα▓┐α▓»α│ïα▓ù α▓çα▓éα▓ªα│ïα▓╕α│ìα▓ñα▓╕α│ìα▓«α▓┐α▓éα▓╢α│ìα▓Üα▓«α│éα▓¬α▓╕α▓Üα▓┐α▓╡α▓òα│ìα▓╖α▓┐α▓ñα▓┐α▓¬α▓╛α▓▓α▓£α▓¿α│ìα▓«',
        name: 'α▓àα▓ºα▓┐α▓»α│ïα▓ù (α▓Üα▓╛ α│¿)',
        description: details.join('\n'),
        result: 'α▓╕α│çα▓¿α▓╛α▓¬α▓ñα▓┐/α▓«α▓éα▓ñα│ìα▓░α▓┐/α▓░α▓╛α▓£, α▓ªα│Çα▓░α│ìα▓ÿα▓╛α▓»α│ü, α▓╢α▓ñα│ìα▓░α│üα▓¿α▓╛α▓╢',
        rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }

    // ΓòÉΓòÉΓòÉ CY Shloka 3 & 4: Sunapha, Anapha, Durudhura, Kemadruma Yogas ΓòÉΓòÉΓòÉ
    bool cy3PlanetIn2 = false, cy3PlanetIn12 = false;
    final cy3PlanetsIn2 = <String>[];
    final cy3PlanetsIn12 = <String>[];
    bool cy3PlanetInKendra = false;
    bool cy3PlanetWithMoon = false;
    // Also from lagna
    bool cy3PlanetIn2L = false, cy3PlanetIn12L = false;
    final cy3PlanetsIn2L = <String>[];
    final cy3PlanetsIn12L = <String>[];
    
    for (final e in allPLons.entries) {
      if (e.key != 'Sun' && e.key != 'Moon' && e.key != 'Rahu' && e.key != 'Ketu') {
        final hFromMoon = ((_rashiOf(e.value) - moonR2) % 12) + 1;
        if (hFromMoon == 2) {
          cy3PlanetIn2 = true;
          cy3PlanetsIn2.add(_knPlanets[e.key]!);
        }
        if (hFromMoon == 12) {
          cy3PlanetIn12 = true;
          cy3PlanetsIn12.add(_knPlanets[e.key]!);
        }
        if (hFromMoon == 1) cy3PlanetWithMoon = true;
        
        final hFromLag = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
        if (hFromLag == 1 || hFromLag == 4 || hFromLag == 7 || hFromLag == 10) cy3PlanetInKendra = true;
        if (hFromLag == 2) {
          cy3PlanetIn2L = true;
          cy3PlanetsIn2L.add(_knPlanets[e.key]!);
        }
        if (hFromLag == 12) {
          cy3PlanetIn12L = true;
          cy3PlanetsIn12L.add(_knPlanets[e.key]!);
        }
      }
    }

    bool hasSunapha = cy3PlanetIn2 && !cy3PlanetIn12;
    bool hasAnapha = !cy3PlanetIn2 && cy3PlanetIn12;
    bool hasDurudhura = cy3PlanetIn2 && cy3PlanetIn12;
    bool hasKemadruma = !cy3PlanetIn2 && !cy3PlanetIn12 && !cy3PlanetInKendra && !cy3PlanetWithMoon;
    // Lagna-based variants
    bool hasSunaphaL = cy3PlanetIn2L && !cy3PlanetIn12L;
    bool hasAnaphaL = !cy3PlanetIn2L && cy3PlanetIn12L;
    bool hasDurudhuraL = cy3PlanetIn2L && cy3PlanetIn12L;
    
    if (hasSunapha) {
      yogas.add(Yoga(
        shloka: 'α▓╕α│ìα▓╡α▓»α▓«α▓ºα▓┐α▓ùα▓ñα▓╡α▓┐α▓ñα│ìα▓ñα▓â α▓¬α▓╛α▓░α│ìα▓Ñα▓┐α▓╡α▓╕α│ìα▓ñα▓ñα│ìα▓╕α▓«α│ï α▓╡α▓╛ α▓¡α▓╡α▓ñα▓┐ α▓╣α▓┐ α▓╕α│üα▓¿α▓¡α▓╛α▓»α▓╛α▓é α▓ºα│Çα▓ºα▓¿α▓ûα│ìα▓»α▓╛α▓ñα▓┐α▓«α▓╛α▓éα▓╢α│ìα▓Ü',
        name: 'α▓╕α│üα▓¿α▓½α▓╛ α▓»α│ïα▓ù (α▓Üα▓╛ α│⌐,α│¬,α│½,α│¡)',
        description: 'α▓Üα▓éα▓ªα│ìα▓░α▓¿α▓┐α▓éα▓ª 2α▓¿α│ç α▓«α▓¿α│å: ${cy3PlanetsIn2.join(', ')}${cy3PlanetsIn2L.isNotEmpty ? '\nα▓▓α▓ùα│ìα▓¿α▓ªα▓┐α▓éα▓ª 2α▓¿α│ç α▓«α▓¿α│å: ${cy3PlanetsIn2L.join(', ')}' : ''}',
        result: 'α▓╕α│ìα▓╡α▓éα▓ñ α▓¬α▓░α▓┐α▓╢α│ìα▓░α▓«α▓ªα▓┐α▓éα▓ª α▓ºα▓¿, α▓░α▓╛α▓£α▓¿ α▓╕α▓«α▓╛α▓¿, α▓¼α│üα▓ªα│ìα▓ºα▓┐α▓╡α▓éα▓ñ',
        rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    } else if (hasAnapha) {
      yogas.add(Yoga(
        shloka: 'α▓¬α│ìα▓░α▓¡α│üα▓░α▓ùα▓ªα▓╢α▓░α│Çα▓░α▓â α▓╢α│Çα▓▓α▓╡α▓╛α▓¿α│ì α▓ûα│ìα▓»α▓╛α▓ñα▓òα│Çα▓░α│ìα▓ñα▓┐α▓╡α▓┐α│ìα▓░α▓╖α▓»α▓╕α│üα▓ûα▓╕α│üα▓╡α│çα▓╖α│ï α▓¿α▓┐α▓░α│ìα▓╡α│âα▓ñα▓╢α│ìα▓Üα▓╛α▓¿α▓¡α▓╛α▓»α▓╛α▓«α│ì',
        name: 'α▓àα▓¿α▓½α▓╛ α▓»α│ïα▓ù (α▓Üα▓╛ α│⌐,α│¬,α│½,α│¡)',
        description: 'α▓Üα▓éα▓ªα│ìα▓░α▓¿α▓┐α▓éα▓ª 12α▓¿α│ç α▓«α▓¿α│åα▓»α▓▓α│ìα▓▓α▓┐: ${cy3PlanetsIn12.join(', ')}',
        result: 'α▓¬α│ìα▓░α▓¡α│ü, α▓░α│ïα▓ùα▓╡α▓┐α▓▓α│ìα▓▓α▓ª α▓╢α▓░α│Çα▓░, α▓òα│Çα▓░α│ìα▓ñα▓┐, α▓¿α│åα▓«α│ìα▓«α▓ªα▓┐',
        rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    } else if (hasDurudhura) {
      yogas.add(Yoga(
        shloka: 'α▓ëα▓ñα│ìα▓¬α▓¿α│ìα▓¿α▓¡α│ïα▓ùα▓╕α│üα▓ûα▓¡α▓╛α▓ùα│ì α▓ºα▓¿α▓╡α▓╛α▓╣α▓¿α▓╛α▓íα│ìα▓»α▓╛α▓ùα▓╛α▓¿α│ìα▓╡α▓┐α▓ñα│ï α▓ºα│üα▓░α│üα▓ºα│üα▓░α▓╛α▓¬α│ìα▓░α▓¡α▓╡α▓â α▓╕α│üα▓¿α│âα▓ñα│ìα▓»α▓â',
        name: 'α▓ªα│üα▓░α│üα▓ºα│üα▓░α▓╛ α▓»α│ïα▓ù (α▓Üα▓╛ α│⌐,α│¬,α│¼)',
        description: 'α▓Üα▓éα▓ªα│ìα▓░α▓¿α▓┐α▓éα▓ª 2α▓░α▓▓α│ìα▓▓α▓┐: ${cy3PlanetsIn2.join(', ')}, 12α▓░α▓▓α│ìα▓▓α▓┐: ${cy3PlanetsIn12.join(', ')}',
        result: 'α▓¡α│ïα▓ù, α▓╕α│üα▓û, α▓╡α▓╛α▓╣α▓¿ α▓╕α▓éα▓¬α▓ñα│ìα▓ñα│ü, α▓ñα│ìα▓»α▓╛α▓ùα▓ùα│üα▓ú',
        rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    } else if (hasKemadruma) {
      yogas.add(Yoga(
        shloka: 'α▓òα│çα▓«α▓ªα│ìα▓░α│üα▓«α│ç α▓«α▓▓α▓┐α▓¿α▓ªα│üα▓âα▓ûα▓┐α▓ñα▓¿α│Çα▓Üα▓¿α▓┐α▓âα▓╕α│ìα▓╡α▓â α▓¬α│ìα▓░α│çα▓╖α│ìα▓»α▓â α▓ûα▓▓α▓╢α│ìα▓Ü α▓¿α│âα▓¬α▓ñα│çα▓░α▓¬α▓┐ α▓╡α▓éα▓╢α▓£α▓╛α▓ñα▓â',
        name: 'α▓òα│çα▓«α▓ªα│ìα▓░α│üα▓« α▓»α│ïα▓ù (α▓Üα▓╛ α│⌐,α│¼)',
        description: 'α▓Üα▓éα▓ªα│ìα▓░α▓¿ α▓àα▓òα│ìα▓òα▓¬α▓òα│ìα▓ò, α▓▓α▓ùα│ìα▓¿α▓òα│çα▓éα▓ªα│ìα▓░, α▓«α▓ñα│ìα▓ñα│ü α▓£α│èα▓ñα│åα▓»α▓▓α│ìα▓▓α▓┐ α▓¼α│çα▓░α│å α▓ùα│ìα▓░α▓╣α▓░α▓┐α▓▓α│ìα▓▓',
        result: 'α▓«α▓▓α▓┐α▓¿, α▓ªα│üα▓âα▓ûα▓┐α▓ñ, α▓ªα▓░α▓┐α▓ªα│ìα▓░, α▓╕α│çα▓╡α▓ò',
        rashi: moonR2, planets: ['α▓Üα▓éα▓ªα│ìα▓░'],
      ));
    }
    
    if (hasSunapha || hasAnapha || hasDurudhura) {
      final combinedPlanets = [...cy3PlanetsIn2, ...cy3PlanetsIn12];
      if (combinedPlanets.contains('α▓òα│üα▓£')) {
        yogas.add(Yoga(
          shloka: 'α▓ëα▓ñα│ìα▓╕α▓╛α▓╣α▓╢α│îα▓░α│ìα▓»α▓ºα▓¿α▓╕α▓╛α▓╣α▓╕α▓╡α▓╛α▓¿α│ìα▓«α▓╣α│Çα▓£α│ç',
          name: 'α▓òα│üα▓£ α▓╕α│üα▓¿α▓½α▓╛α▓ªα▓┐ α▓½α▓▓ (α▓Üα▓╛ α│¡)',
          description: 'α▓»α│ïα▓ù α▓òα▓╛α▓░α▓ò α▓«α▓éα▓ùα▓│',
          result: 'α▓ëα▓ñα│ìα▓╕α▓╛α▓╣, α▓╢α│îα▓░α│ìα▓», α▓ºα▓¿, α▓╕α▓╛α▓╣α▓╕',
          rashi: moonR2, planets: ['α▓òα│üα▓£'],
        ));
      }
      if (combinedPlanets.contains('α▓¼α│üα▓º')) {
        yogas.add(Yoga(
          shloka: 'α▓╕α│îα▓«α│ìα▓» α▓¬α▓ƒα│üα▓â α▓╕α│üα▓╡α▓Üα▓¿α│ï α▓¿α▓┐α▓¬α│üα▓úα▓â α▓òα▓▓α▓╛α▓╕α│ü',
          name: 'α▓¼α│üα▓º α▓╕α│üα▓¿α▓½α▓╛α▓ªα▓┐ α▓½α▓▓ (α▓Üα▓╛ α│¡)',
          description: 'α▓»α│ïα▓ù α▓òα▓╛α▓░α▓ò α▓¼α│üα▓º',
          result: 'α▓Üα▓ñα│üα▓░, α▓Æα▓│α│ìα▓│α│åα▓» α▓«α▓╛α▓ñα│üα▓ùα▓╛α▓░, α▓òα▓▓α│åα▓ùα▓│α▓▓α│ìα▓▓α▓┐ α▓¿α▓┐α▓¬α│üα▓ú',
          rashi: moonR2, planets: ['α▓¼α│üα▓º'],
        ));
      }
      if (combinedPlanets.contains('α▓ùα│üα▓░α│ü')) {
        yogas.add(Yoga(
          shloka: 'α▓£α│Çα▓╡α│çsα▓░α│ìα▓Ñα▓ºα▓░α│ìα▓«α▓╕α│üα▓ûα▓¡α▓╛α▓£α│ì α▓¿α│âα▓¬α▓¬α│éα▓£α▓┐α▓ñα▓╢α│ìα▓Ü',
          name: 'α▓ùα│üα▓░α│ü α▓╕α│üα▓¿α▓½α▓╛α▓ªα▓┐ α▓½α▓▓ (α▓Üα▓╛ α│¡)',
          description: 'α▓»α│ïα▓ù α▓òα▓╛α▓░α▓ò α▓ùα│üα▓░α│ü',
          result: 'α▓ºα▓¿, α▓ºα▓░α│ìα▓«, α▓░α▓╛α▓£α▓¿α▓┐α▓éα▓ª α▓¬α│éα▓£α│å',
          rashi: moonR2, planets: ['α▓ùα│üα▓░α│ü'],
        ));
      }
      if (combinedPlanets.contains('α▓╢α│üα▓òα│ìα▓░')) {
        yogas.add(Yoga(
          shloka: 'α▓òα▓╛α▓«α│Ç α▓¿α│âα▓ùα│î α▓¼α▓╣α│üα▓ºα▓¿α│ï α▓╡α▓┐α▓╖α▓»α│ïα▓¬α▓¡α│ïα▓òα│ìα▓ñα▓╛',
          name: 'α▓╢α│üα▓òα│ìα▓░ α▓╕α│üα▓¿α▓½α▓╛α▓ªα▓┐ α▓½α▓▓ (α▓Üα▓╛ α│¡)',
          description: 'α▓»α│ïα▓ù α▓òα▓╛α▓░α▓ò α▓╢α│üα▓òα│ìα▓░',
          result: 'α▓¼α▓╣α│ü α▓ºα▓¿α▓╡α▓éα▓ñ, α▓╡α▓┐α▓╖α▓» α▓╕α│üα▓û',
          rashi: moonR2, planets: ['α▓╢α│üα▓òα│ìα▓░'],
        ));
      }
      if (combinedPlanets.contains('α▓╢α▓¿α▓┐')) {
        yogas.add(Yoga(
          shloka: 'α▓¬α▓░α▓╡α▓┐α▓¡α▓╡α▓¬α▓░α▓┐α▓Üα│ìα▓¢α▓ªα│ïα▓¬α▓¡α│ïα▓òα│ìα▓ñα▓╛ α▓░α▓╡α▓┐α▓ñα▓¿α▓»α│ç α▓¼α▓╣α│üα▓òα▓╛α▓░α│ìα▓»α▓òα│âα▓ªα│ìα▓ùα▓úα│çα▓╢α▓â',
          name: 'α▓╢α▓¿α▓┐ α▓╕α│üα▓¿α▓½α▓╛α▓ªα▓┐ α▓½α▓▓ (α▓Üα▓╛ α│«)',
          description: 'α▓»α│ïα▓ù α▓òα▓╛α▓░α▓ò α▓╢α▓¿α▓┐',
          result: 'α▓çα▓ñα▓░α▓░ α▓╕α▓éα▓¬α▓ñα│ìα▓ñα│ü α▓àα▓¿α│üα▓¡α▓╡α▓┐α▓╕α│üα▓╡α▓╡α▓¿α│ü, α▓ùα▓úα▓¿α▓╛α▓»α▓ò',
          rashi: moonR2, planets: ['α▓╢α▓¿α▓┐'],
        ));
      }
    }

    // ΓòÉΓòÉΓòÉ CY Shloka 9: Vasumathi Yoga ΓòÉΓòÉΓòÉ
    int cy9BenInUpachayaLag = 0;
    int cy9BenInUpachayaMoon = 0;
    for (final e in allPLons.entries) {
      if ({'Jupiter', 'Venus', 'Mercury'}.contains(e.key)) {
        final hLag = ((_rashiOf(e.value) - lagRashi) % 12) + 1;
        if (hLag == 3 || hLag == 6 || hLag == 10 || hLag == 11) cy9BenInUpachayaLag++;
        
        final hMoon = ((_rashiOf(e.value) - moonR2) % 12) + 1;
        if (hMoon == 3 || hMoon == 6 || hMoon == 10 || hMoon == 11) cy9BenInUpachayaMoon++;
      }
    }
    
    if (cy9BenInUpachayaLag > 0 || cy9BenInUpachayaMoon > 0) {
      String cy9Desc = '';
      String cy9Res = '';
      if (cy9BenInUpachayaLag == 3) {
        cy9Desc = 'α▓Äα▓▓α│ìα▓▓α▓╛ (3) α▓╢α│üα▓¡α▓ùα│ìα▓░α▓╣α▓░α│ü α▓▓α▓ùα│ìα▓¿α▓ªα▓┐α▓éα▓ª α▓ëα▓¬α▓Üα▓»α▓ªα▓▓α│ìα▓▓α▓┐ (3,6,10,11)';
        cy9Res = 'α▓àα▓ñα▓┐α▓╢α▓»α▓╡α▓╛α▓ª α▓ºα▓¿α▓╡α▓éα▓ñ (α▓╡α▓╕α│üα▓«α▓ñα│Ç α▓»α│ïα▓ù)';
      } else if (cy9BenInUpachayaLag == 2) {
        cy9Desc = '2 α▓╢α│üα▓¡α▓ùα│ìα▓░α▓╣α▓░α│ü α▓▓α▓ùα│ìα▓¿α▓ªα▓┐α▓éα▓ª α▓ëα▓¬α▓Üα▓»α▓ªα▓▓α│ìα▓▓α▓┐';
        cy9Res = 'α▓«α▓ºα│ìα▓»α▓« α▓ºα▓¿α▓╡α▓éα▓ñ';
      } else if (cy9BenInUpachayaLag == 1) {
        cy9Desc = '1 α▓╢α│üα▓¡α▓ùα│ìα▓░α▓╣ α▓▓α▓ùα│ìα▓¿α▓ªα▓┐α▓éα▓ª α▓ëα▓¬α▓Üα▓»α▓ªα▓▓α│ìα▓▓α▓┐';
        cy9Res = 'α▓àα▓▓α│ìα▓¬ α▓ºα▓¿α▓╡α▓éα▓ñ';
      } else if (cy9BenInUpachayaMoon > 0) {
        cy9Desc = '$cy9BenInUpachayaMoon α▓╢α│üα▓¡α▓ùα│ìα▓░α▓╣α▓░α│ü α▓Üα▓éα▓ªα│ìα▓░α▓¿α▓┐α▓éα▓ª α▓ëα▓¬α▓Üα▓»α▓ªα▓▓α│ìα▓▓α▓┐';
        cy9Res = 'α▓╕α▓╛α▓ºα▓╛α▓░α▓ú α▓ºα▓¿α▓╡α▓éα▓ñ';
      }
      
      if (cy9Desc.isNotEmpty) {
        yogas.add(Yoga(
          shloka: 'α▓▓α▓ùα│ìα▓¿α▓╛α▓ªα▓ñα│Çα▓╡ α▓╡α▓╕α│üα▓«α▓╛α▓¿α│ìα▓╡α▓╕α│üα▓«α▓╛α▓₧α│ìα▓₧α▓╢α▓╛α▓éα▓òα▓╛α▓ñα│ìα▓«α│ìα▓»α▓ùα│ìα▓░α▓╣α│êα▓░α│üα▓¬α▓Üα▓»α│ïα▓¬α▓ùα▓ñα│ê: α▓╕α▓«α▓╕α│ìα▓»α│å:',
          name: 'α▓╡α▓╕α│üα▓«α▓ñα│Ç α▓»α│ïα▓ù (α▓Üα▓╛ α│»)',
          description: cy9Desc,
          result: cy9Res,
          rashi: lagRashi, planets: [],
        ));
