      final details = <String>[];
      if (jk17MalIn7.isNotEmpty) details.add('α▓Üα▓éα▓ªα│ìα▓░α▓¿α▓┐α▓éα▓ª 7α▓¿α│ç: ${jk17MalIn7.join(",")}');
      if (jk17MalIn4.isNotEmpty) details.add('α▓Üα▓éα▓ªα│ìα▓░α▓¿α▓┐α▓éα▓ª 4α▓¿α│ç: ${jk17MalIn4.join(",")}');
      if (jk17MalIn7L.isNotEmpty) details.add('α▓▓α▓ùα│ìα▓¿α▓ªα▓┐α▓éα▓ª 7α▓¿α│ç: ${jk17MalIn7L.join(",")}');
      if (jk17MalIn4L.isNotEmpty) details.add('α▓▓α▓ùα│ìα▓¿α▓ªα▓┐α▓éα▓ª 4α▓¿α│ç: ${jk17MalIn4L.join(",")}');
      yogas.add(Yoga(
