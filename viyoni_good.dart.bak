    // ΓòÉΓòÉΓòÉ JK Shloka 13: Mother abandons child ΓòÉΓòÉΓòÉ
    final jk13SunInTri = ((sunR - lagRashi) % 12) + 1;
    final jk13MarsInTri = ((marsR - lagRashi) % 12) + 1;
    final jk13MoonInLag = moonR2 == lagRashi;
    final jk13SunMarsInTrik = (jk13SunInTri == 5 || jk13SunInTri == 9) && (jk13MarsInTri == 5 || jk13MarsInTri == 9);
    if (jk13SunMarsInTrik && jk13MoonInLag) {
      final jk13JupAsp = (jk5JupR + 6) % 12 == lagRashi || (jk5JupR + 4) % 12 == lagRashi || (jk5JupR + 8) % 12 == lagRashi;
      yogas.add(Yoga(
        shloka: 'α▓åα▓░α▓╛α▓░α│ìα▓òα▓£α▓»α│ïα▓╕α│ìα▓ñα│ìα▓░α▓┐α▓òα│ïα▓úα▓ùα│ç α▓Üα▓éα▓ªα│ìα▓░α│çsα▓░α│ìα▓òα│ç α▓Ü α▓╡α▓┐α▓╕α│âα▓£α│ìα▓»α▓ñα│çsα▓éα▓¼α▓»α▓╛',
        name: 'α▓«α▓╛α▓ñα│â α▓ñα│ìα▓»α▓╛α▓ù α▓»α│ïα▓ù (α▓£α▓ò α│ºα│⌐)',
        description: 'α▓░α▓╡α▓┐,α▓òα│üα▓£ α▓ñα│ìα▓░α▓┐α▓òα│ïα▓ú + α▓Üα▓éα▓ªα│ìα▓░ α▓▓α▓ùα│ìα▓¿${jk13JupAsp ? "\nα▓ùα│üα▓░α│ü α▓ªα│âα▓╖α│ìα▓ƒα▓┐ ΓåÆ α▓ªα│Çα▓░α│ìα▓ÿα▓╛α▓»α│ü, α▓╕α│üα▓û" : ""}',
        result: jk13JupAsp ? 'α▓ñα▓╛α▓»α▓┐ α▓ñα│ìα▓»α▓£α▓┐α▓╕α▓┐α▓ªα▓░α│é α▓ªα│Çα▓░α│ìα▓ÿα▓╛α▓»α│ü' : 'α▓ñα▓╛α▓»α▓┐ α▓ñα│ìα▓»α▓£α▓┐α▓╕α│üα▓ñα│ìα▓ñα▓╛α▓│α│å',
        rashi: lagRashi, planets: ['α▓░α▓╡α▓┐', 'α▓òα│üα▓£', 'α▓Üα▓éα▓ªα│ìα▓░'],
      ));
